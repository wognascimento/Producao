<UserControl x:Class="Producao.Views.Planilha.AreaTema"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:vewModel="clr-namespace:Producao"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <vewModel:ConverterBoolen x:Key="ConverterBoolen"/>
    </UserControl.Resources>

    <Grid>
        <telerik:RadGridView x:Name="gridAreaTema"
                             AutoGenerateColumns="False"
                             ShowGroupPanel="False"
                             ShowSearchPanel="False"
                             GroupRenderMode="Flat"
                             CanUserInsertRows="True"
                             NewRowPosition="Bottom"
                             ClipboardCopyMode="All"
                             ItemsSource="{Binding AreaTemas}"
                             SelectedItem="{Binding AreaTema, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             CellEditEnded="gridAreaTema_CellEditEnded"
                             RowEditEnded="OnRowEditEnded"
                             RowValidating="OnRowValidating">
            <telerik:RadGridView.Columns>
                <telerik:GridViewComboBoxColumn UniqueName="sigla"
                                                DataMemberBinding="{Binding sigla, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Header="sigla"
                                                ItemsSource="{Binding Siglas}"
                                                DisplayMemberPath="sigla_serv"
                                                SelectedValueMemberPath="sigla_serv"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding tema, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="tema"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding ano, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="ano"/>
                <telerik:GridViewComboBoxColumn DataMemberBinding="{Binding local, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Header="local"
                                                ItemsSource="{Binding Locais}"/>
                <telerik:GridViewDataColumn Header="trem" UniqueName="trem">
                    <telerik:GridViewDataColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsHitTestVisible="False"
                                      HorizontalAlignment="Center"
                                      IsChecked="{Binding trem, Converter={StaticResource ConverterBoolen}}"/>
                        </DataTemplate>
                    </telerik:GridViewDataColumn.CellTemplate>
                    <telerik:GridViewDataColumn.CellEditTemplate>
                        <DataTemplate>
                            <CheckBox HorizontalAlignment="Center"
                                      IsChecked="{Binding trem, Converter={StaticResource ConverterBoolen}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataTemplate>
                    </telerik:GridViewDataColumn.CellEditTemplate>
                </telerik:GridViewDataColumn>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding area_total_memorial, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}" Header="area_total_memorial"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding area_total_planta, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}" Header="area_total_planta"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding perimetro_planta, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}" Header="perimetro_planta"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding trilha_memorial, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}" Header="trilha_memorial"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding trilha_planta, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}" Header="trilha_planta"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding pa, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}" Header="pa"/>
                <telerik:GridViewDataColumn UniqueName="construcao_total" DataMemberBinding="{Binding construcao_total, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}" Header="construcao_total"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding cenografia_planta, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}" Header="cenografia_planta"/>
            </telerik:RadGridView.Columns>
        </telerik:RadGridView>
    </Grid>
</UserControl>
