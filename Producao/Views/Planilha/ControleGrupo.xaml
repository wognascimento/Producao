<UserControl x:Class="Producao.Views.Planilha.ControleGrupo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:vewModel="clr-namespace:Producao"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded">

    <UserControl.Resources>
        <vewModel:ConverterBoolen x:Key="ConverterBoolen"/>
    </UserControl.Resources>

    <Grid>
        <telerik:RadGridView x:Name="adicionais"
                             Grid.Row="1"
                             AutoGenerateColumns="False"
                             ShowGroupPanel="False"
                             ShowSearchPanel="False"
                             CanUserFreezeColumns="False"
                             CanUserInsertRows="False"
                             ClipboardCopyMode="All"
                             ItemsSource="{Binding ControlePlanilhaGrupos}"
                             SelectedItem="{Binding ControlePlanilhaGrupo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             RowEditEnded="OnRowEditEnded"
                             RowValidating="OnRowValidating"
                             CellEditEnded="OnCellEditEnded">
            <telerik:RadGridView.Columns>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding agrupamento}" Header="agrupamento"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding caminhao}" Header="caminhao"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding revisado}" Header="revisado"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding confirmado}" Header="confirmado"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding planilha}" Header="planilha"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding item}" Header="item"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding id}" Header="id"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding local_shoppings}" Header="local_shoppings"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding sigla}" Header="sigla"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding data_de_expedicao, StringFormat={}{0:dd/MM/yyyy}}" Header="data_de_expedicao" IsReadOnly="True"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding tema}" Header="tema"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding descricao_completa}" Header="descricao_completa"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding obs}" Header="observacao_producao"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding obs_planilheiro, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="obs_planilheiro"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding resp_prod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="resp_prod"/>
                <telerik:GridViewComboBoxColumn DataMemberBinding="{Binding status_producao, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Header="status_producao"
                                                ItemsSource="{Binding StatusProducao}"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding qtd_detalhe, StringFormat={}{0:N2}}" Header="qtd_detalhe" IsReadOnly="True"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding qtd_complemento, StringFormat={}{0:N2}}" Header="qtd_complemento" IsReadOnly="True"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding qtd_exp, StringFormat={}{0:N2}}" Header="qtd_exp" IsReadOnly="True"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding codcompl, StringFormat={}{0:N0}}" Header="codcompl" IsReadOnly="True"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding coddetalhescompl, StringFormat={}{0:N0}}" Header="coddetalhescompl" IsReadOnly="True"/>
                <telerik:GridViewDataColumn Header="os" UniqueName="os">
                    <telerik:GridViewDataColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsHitTestVisible="False"
                                      HorizontalAlignment="Center"
                                      IsChecked="{Binding os, Converter={StaticResource ConverterBoolen}}" Margin="0,0,2,2"/>
                        </DataTemplate>
                    </telerik:GridViewDataColumn.CellTemplate>
                    <telerik:GridViewDataColumn.CellEditTemplate>
                        <DataTemplate>
                            <CheckBox HorizontalAlignment="Center"
                                      IsChecked="{Binding os, Converter={StaticResource ConverterBoolen}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,2,2"/>
                        </DataTemplate>
                    </telerik:GridViewDataColumn.CellEditTemplate>
                </telerik:GridViewDataColumn>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding enviado_baia, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Header="enviado_baia"/>
            </telerik:RadGridView.Columns>
        </telerik:RadGridView>
    </Grid>
</UserControl>
