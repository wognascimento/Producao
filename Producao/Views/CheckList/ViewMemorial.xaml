<UserControl x:Class="Producao.Views.CheckList.ViewMemorial"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:app="clr-namespace:Producao"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <app:ConverterNumber x:Key="ConverterNumber"/>
        <app:ConverterBoolen x:Key="ConverterBoolen"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Height="39">
            <telerik:RadComboBox x:Name="cbSiglaShopping"
                                 Width="260"
                                 
                                 EmptyText="Shopping"
                                 IsEditable="True"
                                 IsFilteringEnabled="True"
                                 OpenDropDownOnFocus="True"
                                 ItemsSource="{Binding Siglas}"
                                 DisplayMemberPath="sigla"
                                 SelectedItem="{Binding Sigla, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 SelectionChanged="OnSiglaSelectionChanged"/>

            <TextBlock VerticalAlignment="Center">
                <Hyperlink NavigateUri="{Binding Link.links}"
                           RequestNavigate="Hyperlink_RequestNavigate">
                    <Run Text="{Binding Link.links}"/>
                </Hyperlink>
            </TextBlock>

            <telerik:RadWatermarkTextBox Width="200"
                                         
                                         WatermarkContent="Responsável Tema"
                                         Text="{Binding Tema.resp_tema, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="False"/>

            <telerik:RadWatermarkTextBox Width="200"
                                         WatermarkContent="Resp cliente"
                                         Text="{Binding Sigla.diretorcliente, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="False"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Height="39">
            <telerik:RadComboBox x:Name="txtTema"
                                 Width="710"
                                 
                                 EmptyText="Tema"
                                 IsEditable="True"
                                 IsFilteringEnabled="True"
                                 OpenDropDownOnFocus="True"
                                 ItemsSource="{Binding Temas}"
                                 DisplayMemberPath="tema"
                                 SelectedItem="{Binding Tema, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 SelectionChanged="OnTemaSelectionChanged"/>

            <telerik:RadButton Click="OnPrintMemorial"
                               ToolTip="Imprimir"
                               Padding="8,4">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/icones/icons8-impressão-40.png"
                           Width="20"
                           Height="20"
                           />
                    <TextBlock Text="IMPRIMIR" VerticalAlignment="Center"/>
                </StackPanel>
            </telerik:RadButton>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <telerik:RadWatermarkTextBox Width="710"
                                         WatermarkContent="Texto do tema"
                                         Text="{Binding Sigla.tema}"
                                         TextWrapping="Wrap"/>
        </StackPanel>

        <telerik:RadGridView Grid.Row="3"
                             AutoGenerateColumns="False"
                             CanUserResizeColumns="True"
                             CanUserReorderColumns="True"
                             ShowGroupPanel="False"
                             IsFilteringAllowed="True"
                             RowIndicatorVisibility="Visible"
                             ItemsSource="{Binding Itens}"
                             SelectionUnit="FullRow"
                             SelectionMode="Extended"
                             ClipboardCopyMode="Cells,Header"
                             CellEditEnded="Itens_CellEditEnded">
            <telerik:RadGridView.Columns>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding sigla_serv}"
                                            Header="sigla_serv"
                                            IsReadOnly="True"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding item}"
                                            Header="item"
                                            IsReadOnly="True"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding bloco_revisao, Converter={StaticResource ConverterNumber}}"
                                            Header="bloco_revisao"
                                            IsReadOnly="True"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding localitem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Header="localitem"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding descricao}"
                                            Header="descricao"
                                            IsReadOnly="True"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding dimensao}"
                                            Header="dimensao"
                                            IsReadOnly="True"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding qtd, Converter={StaticResource ConverterNumber}}"
                                            Header="qtd"
                                            IsReadOnly="True"/>
                <telerik:GridViewDataColumn UniqueName="baia_caminhao"
                                            DataMemberBinding="{Binding baia_caminhao, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Header="baia_caminhao"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding obs}"
                                            Header="obs"
                                            IsReadOnly="True"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding obs_interna}"
                                            Header="obs_interna"
                                            IsReadOnly="True"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding obs_memorial}"
                                            Header="obs_memorial"
                                            IsReadOnly="True"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding obs_alteracao}"
                                            Header="obs_alteracao"
                                            IsReadOnly="True"/>
            </telerik:RadGridView.Columns>
        </telerik:RadGridView>
    </Grid>
</UserControl>
