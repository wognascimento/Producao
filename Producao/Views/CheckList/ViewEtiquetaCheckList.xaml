<UserControl x:Class="Producao.Views.CheckList.ViewEtiquetaCheckList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:vewModel="clr-namespace:Producao"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded">

    <UserControl.Resources>
        <vewModel:ConverterNumber x:Key="ConverterNumber"/>
        <vewModel:ConverterBoolen x:Key="ConverterBoolen"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <telerik:RadGridView x:Name="dgCheckList"
                             Grid.Row="0"
                             AutoGenerateColumns="False"
                             CanUserResizeColumns="True"
                             CanUserReorderColumns="True"
                             ShowGroupPanel="False"
                             IsFilteringAllowed="True"
                             IsReadOnly="true"
                             ItemsSource="{Binding Dados}"
                             SelectedItem="{Binding Dado, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             MouseDoubleClick="OnMouseDoubleClick">
            <telerik:RadGridView.Columns>
                <telerik:GridViewDataColumn Header="SIGLA" DataMemberBinding="{Binding sigla}"/>
                <telerik:GridViewDataColumn Header="ITEM" DataMemberBinding="{Binding item_memorial}"/>
                <telerik:GridViewDataColumn Header="LOCAL DO SHOPPING" DataMemberBinding="{Binding local_shoppings}"/>
                <telerik:GridViewDataColumn Header="PLANILHA" DataMemberBinding="{Binding planilha}"/>
                <telerik:GridViewDataColumn Header="DESCRIÇÃO COMPLETA" DataMemberBinding="{Binding descricao_completa}"/>
                <telerik:GridViewDataColumn Header="CODDETALHESCOMPL" DataMemberBinding="{Binding coddetalhescompl, Converter={StaticResource ConverterNumber}}"/>
                <telerik:GridViewDataColumn Header="QTD NÃO EXPEDIDA" DataMemberBinding="{Binding qtd_nao_expedida, Converter={StaticResource ConverterNumber}}"/>
                <telerik:GridViewCheckBoxColumn Header="EMITIDA" DataMemberBinding="{Binding etiqueta_emitida, Converter={StaticResource ConverterBoolen}}"/>
                <telerik:GridViewDataColumn Header="IMPRIMIR" IsReadOnly="True">
                    <telerik:GridViewDataColumn.CellTemplate>
                        <DataTemplate>
                            <telerik:RadButton Content="IMPRIMIR"
                                               Click="OnImprimirEtiquetaCheckListClick" Margin="0,0,2,2"/>
                        </DataTemplate>
                    </telerik:GridViewDataColumn.CellTemplate>
                </telerik:GridViewDataColumn>
            </telerik:RadGridView.Columns>
        </telerik:RadGridView>

        <telerik:RadGridView x:Name="dgEtiqueta"
                             Grid.Row="1"
                             NewRowPosition="Top"
                             CanUserInsertRows="True"
                             CanUserDeleteRows="True"
                             AutoGenerateColumns="False"
                             ShowGroupPanel="False"
                             ItemsSource="{Binding Etiquetas}"
                             SelectedItem="{Binding Etiqueta, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AddingNewDataItem="dgEtiqueta_AddingNewDataItem"
                             RowValidating="dgEtiqueta_RowValidating"
                             RowValidated="dgEtiqueta_RowValidated"
                             Deleting="dgEtiqueta_Deleting">
            <telerik:RadGridView.Columns>
                <telerik:GridViewDataColumn Header="VOLUME" DataMemberBinding="{Binding volumes, Mode=TwoWay, Converter={StaticResource ConverterNumber}}"/>
                <telerik:GridViewDataColumn Header="TOTAL VOLUMES" DataMemberBinding="{Binding volumes_total, Mode=TwoWay, Converter={StaticResource ConverterNumber}}"/>
                <telerik:GridViewDataColumn Header="QTD" DataMemberBinding="{Binding qtd, Mode=TwoWay, Converter={StaticResource ConverterNumber}}"/>
                <telerik:GridViewDataColumn Header="LARGURA" DataMemberBinding="{Binding largura, Mode=TwoWay, Converter={StaticResource ConverterNumber}}"/>
                <telerik:GridViewDataColumn Header="ALTURA" DataMemberBinding="{Binding altura, Mode=TwoWay, Converter={StaticResource ConverterNumber}}"/>
                <telerik:GridViewDataColumn Header="PROFUNDIDADE" DataMemberBinding="{Binding profundidade, Mode=TwoWay, Converter={StaticResource ConverterNumber}}"/>
                <telerik:GridViewDataColumn Header="P.BRUTO" DataMemberBinding="{Binding peso_bruto, Mode=TwoWay, Converter={StaticResource ConverterNumber}}"/>
                <telerik:GridViewDataColumn Header="P.LIQUIDO" DataMemberBinding="{Binding peso_liquido, Mode=TwoWay, Converter={StaticResource ConverterNumber}}"/>
                <telerik:GridViewCheckBoxColumn Header="IMPRESSO" DataMemberBinding="{Binding impresso, Mode=TwoWay, Converter={StaticResource ConverterBoolen}}"/>
            </telerik:RadGridView.Columns>
        </telerik:RadGridView>
    </Grid>
</UserControl>
