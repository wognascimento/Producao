<UserControl x:Class="Producao.Views.CheckList.ViewEtiquetaCheckListEmitida"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:vewModel="clr-namespace:Producao"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded">

    <UserControl.Resources>
        <vewModel:ConverterNumber x:Key="ConverterNumber"/>
        <vewModel:ConverterBoolen x:Key="ConverterBoolen"/>
    </UserControl.Resources>

    <Grid>
        <telerik:RadGridView x:Name="dgEtiquetasEmitidas"
                             AutoGenerateColumns="False"
                             CanUserResizeColumns="True"
                             CanUserReorderColumns="True"
                             ShowGroupPanel="False"
                             IsFilteringAllowed="True"
                             IsReadOnly="true"
                             ItemsSource="{Binding Etiquetas}"
                             SelectedItem="{Binding Etiqueta, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
            <telerik:RadGridView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Imprimir" Click="OnImprimirClick"/>
                </ContextMenu>
            </telerik:RadGridView.ContextMenu>

            <telerik:RadGridView.Columns>
                <telerik:GridViewDataColumn Header="data_de_expedicao" DataMemberBinding="{Binding data_de_expedicao}" DataFormatString="{}{0:dd/MM/yyyy}"/>
                <telerik:GridViewDataColumn Header="sigla" DataMemberBinding="{Binding sigla}"/>
                <telerik:GridViewDataColumn Header="item_memorial" DataMemberBinding="{Binding item_memorial}"/>
                <telerik:GridViewDataColumn Header="local_shoppings" DataMemberBinding="{Binding local_shoppings}"/>
                <telerik:GridViewDataColumn Header="planilha" DataMemberBinding="{Binding planilha}"/>
                <telerik:GridViewDataColumn Header="descricao_completa" DataMemberBinding="{Binding descricao_completa}"/>
                <telerik:GridViewDataColumn Header="coddetalhescompl" DataMemberBinding="{Binding coddetalhescompl, Converter={StaticResource ConverterNumber}}"/>
                <telerik:GridViewDataColumn Header="codvol" DataMemberBinding="{Binding codvol, Converter={StaticResource ConverterNumber}}"/>
                <telerik:GridViewDataColumn Header="volumes" DataMemberBinding="{Binding volumes, Converter={StaticResource ConverterNumber}}"/>
                <telerik:GridViewDataColumn Header="volumes_total" DataMemberBinding="{Binding volumes_total, Converter={StaticResource ConverterNumber}}"/>
                <telerik:GridViewDataColumn Header="qtd" DataMemberBinding="{Binding qtd, Converter={StaticResource ConverterNumber}}"/>
                <telerik:GridViewDataColumn Header="criado_por" DataMemberBinding="{Binding criado_por}"/>
                <telerik:GridViewDataColumn Header="criado_em" DataMemberBinding="{Binding criado_em}" DataFormatString="{}{0:dd/MM/yyyy HH:mm}"/>
            </telerik:RadGridView.Columns>
        </telerik:RadGridView>
    </Grid>
</UserControl>
