<UserControl x:Class="Producao.Views.CheckList.ViewEmitirEtiquetaCheckList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:viewModel="clr-namespace:Producao"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <viewModel:ConverterNumber x:Key="ConverterNumber"/>
        <viewModel:ConverterBoolen x:Key="ConverterBoolen"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Vertical">
            <StackPanel Orientation="Horizontal">
                <telerik:RadComboBox x:Name="cbSiglaShopping"
                                     Width="260"
                                     Margin="5"
                                     EmptyText="Shopping"
                                     IsEditable="True"
                                     IsFilteringEnabled="True"
                                     OpenDropDownOnFocus="True"
                                     ItemsSource="{Binding Siglas}"
                                     SelectedItem="{Binding Sigla, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     SelectedValue="{Binding ComplementoCheckList.id_aprovado, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     DisplayMemberPath="sigla_serv"
                                     SelectedValuePath="id_aprovado"
                                     SelectionChanged="OnSiglaSelectionChanged"/>

                <telerik:RadWatermarkTextBox Width="450"
                                             Margin="5"
                                             WatermarkContent="Tema"
                                             IsEnabled="False"
                                             Text="{Binding Sigla.tema}"/>
            </StackPanel>
        </StackPanel>

        <telerik:RadGridView x:Name="dgCheckList"
                             Grid.Row="1"
                             AutoGenerateColumns="False"
                             CanUserResizeColumns="True"
                             ShowGroupPanel="False"
                             IsFilteringAllowed="True"
                             ItemsSource="{Binding Itens}"
                             MouseDoubleClick="OnMouseDoubleClick">
            <telerik:RadGridView.Columns>
                <telerik:GridViewDataColumn Header="SIGLA" DataMemberBinding="{Binding sigla}"/>
                <telerik:GridViewDataColumn Header="ITEM" DataMemberBinding="{Binding item_memorial}"/>
                <telerik:GridViewDataColumn Header="LOCAL DO SHOPPING" DataMemberBinding="{Binding local_shoppings}"/>
                <telerik:GridViewDataColumn Header="PLANILHA" DataMemberBinding="{Binding planilha}"/>
                <telerik:GridViewDataColumn Header="DESCRIÇÃO COMPLETA" DataMemberBinding="{Binding descricao_completa}"/>
                <telerik:GridViewDataColumn Header="CODDETALHESCOMPL"
                                            DataMemberBinding="{Binding coddetalhescompl, Converter={StaticResource ConverterNumber}}"/>
                <telerik:GridViewDataColumn Header="QTD NÃO EXPEDIDA"
                                            DataMemberBinding="{Binding qtd_nao_expedida, Converter={StaticResource ConverterNumber}}"/>
                <telerik:GridViewCheckBoxColumn Header="EMITIDA"
                                                DataMemberBinding="{Binding etiqueta_emitida}"/>
            </telerik:RadGridView.Columns>
        </telerik:RadGridView>
    </Grid>
</UserControl>
