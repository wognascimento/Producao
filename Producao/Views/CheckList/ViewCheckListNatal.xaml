<UserControl x:Name="chklist"
             x:Class="Producao.Views.CheckList.ViewCheckListNatal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:local="clr-namespace:Producao.Views.CheckList"
             xmlns:app="clr-namespace:Producao"
             xmlns:viewModel="clr-namespace:Producao"
             mc:Ignorable="d"
             d:DesignHeight="768"
             d:DesignWidth="1024"
             Loaded="OnLoaded"
             Unloaded="chklist_Unloaded">

    <UserControl.Resources>
        <viewModel:ConverterNumber x:Key="ConverterNumber"/>
        <viewModel:ConverterBoolen x:Key="ConverterBoolen"/>
        <local:NameButtonConverter x:Key="NameButtonConverter"/>
        <app:CheclistRevisaoColorConverter x:Key="converterCollor"/>

        <Style x:Key="PlanilhaCellStyle" TargetType="telerik:GridViewCell">
            <Setter Property="Background" Value="{Binding Converter={StaticResource converterCollor}}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Vertical">
            <StackPanel Orientation="Horizontal" >
                <telerik:RadComboBox x:Name="cbSiglaShopping"
                                     Width="260"
                                     Margin="0,0,2,2"
                                     EmptyText="Shopping"
                                     IsEditable="True"
                                     IsFilteringEnabled="True"
                                     OpenDropDownOnFocus="True"
                                     ItemsSource="{Binding Siglas}"
                                     SelectedItem="{Binding Sigla, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     
                                     DisplayMemberPath="sigla_serv"
                                     SelectedValuePath="id_aprovado"
                                     SelectionChanged="OnSiglaSelectionChanged" IsTextSearchEnabled="True" StaysOpenOnEdit="True" CanAutocompleteSelectItems="False" CanKeyboardNavigationSelectItems="False" UpdateSelectionOnLostFocus="False" UpdateTextOnLostFocus="False"/>

                <telerik:RadWatermarkTextBox Width="460"
                                             Margin="0,0,2,2"
                                             WatermarkContent="Tema"
                                             IsEnabled="False"
                                             Text="{Binding Sigla.tema}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <telerik:RadWatermarkTextBox x:Name="tbId"
                                             Width="150"
                                             Margin="0,0,2,2"
                                             WatermarkContent="ID"
                                             Text="{Binding ComplementoCheckList.ordem}"/>
                <telerik:RadWatermarkTextBox x:Name="tbItem"
                                             Width="100"
                                             Margin="0,0,2,2"
                                             WatermarkContent="ITEM"
                                             Text="{Binding ComplementoCheckList.item_memorial}"/>
                <telerik:RadWatermarkTextBox x:Name="tbLocalShopping"
                                             Width="470"
                                             Margin="0,0,2,2"
                                             WatermarkContent="LOCAL DO SHOPPING"
                                             Text="{Binding ComplementoCheckList.local_shoppings}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" >
                <telerik:RadComboBox x:Name="cbPlanilha"
                                     Width="260"
                                     Margin="0,0,2,2"
                                     EmptyText="PLANILHA"
                                     IsEditable="True"
                                     IsFilteringEnabled="True"
                                     OpenDropDownOnFocus="True"
                                     ItemsSource="{Binding Planilhas}"
                                     SelectedItem="{Binding Planilha, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     DisplayMemberPath="planilha"
                                     SelectedValuePath="planilha"
                                     SelectionChanged="OnPlanilhaSelectionChanged" IsTextSearchEnabled="True" StaysOpenOnEdit="True" CanAutocompleteSelectItems="False" CanKeyboardNavigationSelectItems="False" UpdateSelectionOnLostFocus="False" UpdateTextOnLostFocus="False"/>

                <telerik:RadComboBox x:Name="cbDescricao"
                                     Width="460"
                                     Margin="0,0,2,2"
                                     EmptyText="DESCRIÇÃO"
                                     IsEditable="True"
                                     IsFilteringEnabled="True"
                                     OpenDropDownOnFocus="True"
                                     ItemsSource="{Binding Produtos}"
                                     SelectedItem="{Binding Produto, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     SelectedValue="{Binding ComplementoCheckList.codproduto, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     DisplayMemberPath="descricao"
                                     SelectedValuePath="codigo"
                                     SelectionChanged="OnDescricaoSelectionChanged" IsTextSearchEnabled="True" StaysOpenOnEdit="True" CanAutocompleteSelectItems="False" CanKeyboardNavigationSelectItems="False" UpdateSelectionOnLostFocus="False" UpdateTextOnLostFocus="False"/>

                <telerik:RadWatermarkTextBox x:Name="txtCorPredomitante"
                                             Width="300"
                                             Margin="0,0,2,2"
                                             WatermarkContent="COR PREDOMINANTE"
                                             Text="{Binding Sigla.cor_predominante}"
                                             IsEnabled="False"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" >
                <telerik:RadComboBox x:Name="cbDescricaoAdicional"
                                     Width="610"
                                     Margin="0,0,2,2"
                                     EmptyText="DESCRIÇÃO ADICIONAL"
                                     IsEditable="True"
                                     IsFilteringEnabled="True"
                                     OpenDropDownOnFocus="True"
                                     ItemsSource="{Binding DescAdicionais}"
                                     SelectedItem="{Binding DescAdicional, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     SelectedValue="{Binding ComplementoCheckList.coduniadicional, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     DisplayMemberPath="descricao_adicional"
                                     SelectedValuePath="coduniadicional" IsTextSearchEnabled="True" StaysOpenOnEdit="True" CanAutocompleteSelectItems="False" CanKeyboardNavigationSelectItems="False" UpdateSelectionOnLostFocus="False" UpdateTextOnLostFocus="False"/>

                <telerik:RadNumericUpDown x:Name="tbQtde"
                                          Width="110"
                                          Margin="0,0,2,2"
                                          NullValue="{x:Null}"
                                          Value="{Binding ComplementoCheckList.qtd, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <telerik:RadWatermarkTextBox x:Name="txtPa"
                                             Width="300"
                                             Margin="0,0,2,2"
                                             WatermarkContent="P A"
                                             Text="{Binding Sigla.pa}"
                                             IsEnabled="False"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" >
                <telerik:RadWatermarkTextBox x:Name="tbOrientacaoProducao"
                                             Width="720"
                                             Margin="0,0,2,2"
                                             WatermarkContent="ORIENTAÇÃO DE PRODUÇÃO"
                                             Text="{Binding ComplementoCheckList.obs}"/>
                <telerik:RadWatermarkTextBox x:Name="txtLaco"
                                             Width="300"
                                             Margin="0,0,2,2"
                                             WatermarkContent="LAÇO"
                                             Text="{Binding Sigla.laco}"
                                             IsEnabled="False"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" >
                <telerik:RadWatermarkTextBox x:Name="tbOrientacaoMontagem"
                                             Width="720"
                                             Margin="0,0,2,2"
                                             WatermarkContent="ORIENTAÇÃO DE MONTAGEM"
                                             Text="{Binding ComplementoCheckList.orient_montagem}"/>
                <telerik:RadWatermarkTextBox x:Name="txtObsIluminacao"
                                             Width="300"
                                             Margin="0,0,2,2"
                                             WatermarkContent="OBS ILUMINAÇÃO"
                                             Text="{Binding Sigla.obs_iluminacao}"
                                             IsEnabled="False"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" >
                <telerik:RadWatermarkTextBox x:Name="tbOrientacaoDesmontagem"
                                             Width="720"
                                             Margin="0,0,2,2"
                                             WatermarkContent="ORIENTAÇÃO DE DESMONTAGEM"
                                             Text="{Binding ComplementoCheckList.orient_desmont}"/>
                <telerik:RadWatermarkTextBox x:Name="txtMlampLed"
                                             Width="300"
                                             Margin="0,0,2,2"
                                             WatermarkContent="MLAMP/LED"
                                             Text="{Binding Sigla.iluminacao}"
                                             IsEnabled="False"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <telerik:RadButton Click="OnLimparClick" Margin="0,0,2,2">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/icones/icons8-vassoura-40.png" Width="20" Height="20" Margin="0,0,5,0"/>
                        <TextBlock Text="LIMPAR" VerticalAlignment="Center" Margin="0,0,2,2"/>
                    </StackPanel>
                </telerik:RadButton>
                <telerik:RadButton Click="OnAdicionar_Click" Margin="0,0,2,2">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/icones/icons8-adicionar-propriedade-40.png" Width="20" Height="20" Margin="0,0,5,0"/>
                        <TextBlock Text="ADICIONAR" VerticalAlignment="Center" Margin="0,0,2,2"/>
                    </StackPanel>
                </telerik:RadButton>
                <telerik:RadButton Click="OnEditClick" Margin="0,0,2,2">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/icones/icons8-editar-propriedade-40.png" Width="20" Height="20" Margin="0,0,5,0"/>
                        <TextBlock Text="EDITAR" VerticalAlignment="Center" Margin="0,0,2,2"/>
                    </StackPanel>
                </telerik:RadButton>
                <telerik:RadButton Click="OnPrintClick" Margin="0,0,2,2">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/icones/icons8-impressão-40.png" Width="20" Height="20" Margin="0,0,5,0"/>
                        <TextBlock Text="IMPRIMIR" VerticalAlignment="Center" Margin="0,0,2,2"/>
                    </StackPanel>
                </telerik:RadButton>
                <telerik:RadButton Click="OnCopyClick" Margin="0,0,2,2">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/icones/icons8-auto-deskew-100.png" Width="20" Height="20" Margin="0,0,5,0"/>
                        <TextBlock Text="COPIAR" VerticalAlignment="Center" Margin="0,0,2,2"/>
                    </StackPanel>
                </telerik:RadButton>
            </StackPanel>
        </StackPanel>

        <telerik:RadGridView x:Name="dgCheckListGeral"
                             Grid.Row="1"
                             AutoGenerateColumns="False"
                             CanUserResizeColumns="True"
                             CanUserReorderColumns="True"
                             CanUserDeleteRows="True"
                             ShowGroupPanel="False"
                             IsFilteringAllowed="True"
                             
                             RowIndicatorVisibility="Visible"
                             SelectionMode="Single"
                             ItemsSource="{Binding CheckListGerais}"
                             SelectedItem="{Binding CheckListGeral, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             SelectionChanged="OnSelectionChanged"
                             RowValidating="dgCheckListGeral_RowValidating"
                             BeginningEdit="dgCheckListGeral_BeginningEdit"
                             PreviewKeyDown="dgCheckListGeral_PreviewKeyDown"
                             CellEditEnded="dgCheckListGeral_CellEditEnded"
                             Deleting="dgCheckListGeral_Deleting">
            <telerik:RadGridView.Columns>
                <telerik:GridViewDataColumn Header="bloco_revisao" IsReadOnly="True" DataMemberBinding="{Binding bloco_revisao, Converter={StaticResource ConverterNumber}}"/>
                <telerik:GridViewDataColumn Header="resp_revisao"  IsReadOnly="True" DataMemberBinding="{Binding resp_revisao}"/>
                <telerik:GridViewCheckBoxColumn Header="OK REV."  IsReadOnly="True" DataMemberBinding="{Binding ok_revisao_alterada, Converter={StaticResource ConverterBoolen}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <telerik:GridViewDataColumn UniqueName="id" Header="ID" IsReadOnly="False" DataMemberBinding="{Binding id, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <telerik:GridViewDataColumn UniqueName="item_memorial" Header="ITEM"  IsReadOnly="False" DataMemberBinding="{Binding item_memorial, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <telerik:GridViewDataColumn UniqueName="local_shoppings" Header="LOCAL DO SHOPPING" IsReadOnly="False" DataMemberBinding="{Binding local_shoppings, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <telerik:GridViewDataColumn Header="PLANILHA"  IsReadOnly="True" DataMemberBinding="{Binding planilha}" CellStyle="{StaticResource PlanilhaCellStyle}"/>
                <telerik:GridViewDataColumn Header="DESCRIÇÃO"  IsReadOnly="True" DataMemberBinding="{Binding descricao}"/>
                <telerik:GridViewDataColumn Header="DESCRIÇÃO ADICIONAL"  IsReadOnly="True" DataMemberBinding="{Binding descricao_adicional}"/>
                <telerik:GridViewDataColumn UniqueName="qtd" Header="QTDE" IsReadOnly="False" DataMemberBinding="{Binding qtd, Converter={StaticResource ConverterNumber}}"/>
                <telerik:GridViewDataColumn Header="CODCOMPL"  IsReadOnly="True" DataMemberBinding="{Binding codcompl, Converter={StaticResource ConverterNumber}}" DataFormatString="{}{0:F0}"/>
                <telerik:GridViewDataColumn UniqueName="obs" Header="ORIENTAÇÃO DE PRODUÇÃO" IsReadOnly="False" DataMemberBinding="{Binding obs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <telerik:GridViewDataColumn UniqueName="orient_montagem" Header="ORIENTAÇÃO DE MONTAGEM" IsReadOnly="False" DataMemberBinding="{Binding orient_montagem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <telerik:GridViewDataColumn UniqueName="orient_desmont" Header="ORIENTAÇÃO DE DESMONTAGEM" IsReadOnly="False" DataMemberBinding="{Binding orient_desmont, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <telerik:GridViewDataColumn UniqueName="carga" Header="CAMINÃO" IsReadOnly="False" DataMemberBinding="{Binding carga, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <telerik:GridViewDataColumn Header="alteradopordescadic"  IsReadOnly="True" DataMemberBinding="{Binding alteradopordescadic}"/>
                <telerik:GridViewDataColumn Header="dataalteradescadic"  IsReadOnly="True" DataMemberBinding="{Binding dataalteradescadic}" DataFormatString="{}{0:dd/MM/yyyy HH:mm}"/>
                <telerik:GridViewDataColumn Header="inserido_por"  IsReadOnly="True" DataMemberBinding="{Binding inserido_por}"/>
                <telerik:GridViewDataColumn Header="inserido_em"  IsReadOnly="True" DataMemberBinding="{Binding inserido_em}" DataFormatString="{}{0:dd/MM/yyyy HH:mm}"/>
                <telerik:GridViewDataColumn Header="alterado_por"  IsReadOnly="True" DataMemberBinding="{Binding alterado_por}"/>
                <telerik:GridViewDataColumn Header="alterado_em"  IsReadOnly="True" DataMemberBinding="{Binding alterado_em}" DataFormatString="{}{0:dd/MM/yyyy HH:mm}"/>
            </telerik:RadGridView.Columns>
        </telerik:RadGridView>

        <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch"/>

        <telerik:RadGridView x:Name="dgComplemento"
                             Grid.Row="3"
                             CanUserInsertRows="True"
                             GroupRenderMode="Flat"
                             NewRowPosition="Bottom"
                             RowIndicatorVisibility="Visible"
                             AutoGenerateColumns="False"
                             ShowGroupPanel="False"
                             SelectionMode="Extended"
                             ClipboardCopyMode="Cells,Header"
                             ItemsSource="{Binding CheckListGeralComplementos}"
                             SelectedItem="{Binding CheckListGeralComplemento, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             CellEditEnded="dgComplemento_CellEditEnded"
                             FontSize="10"
                             RowValidated="dgComplemento_RowValidated"
                             RowValidating="dgComplemento_RowValidating"
                             AddingNewDataItem="dgComplemento_AddingNewDataItem"
                             CanUserResizeColumns="True">
            <telerik:RadGridView.Columns>
                <telerik:GridViewComboBoxColumn UniqueName="codcompladicional"
                                                Header="COMPLEMENTO ADICIONAL"
                                                DataMemberBinding="{Binding codcompladicional, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                ItemsSource="{Binding DataContext.CompleAdicionais, RelativeSource={RelativeSource AncestorType=telerik:RadGridView}}"
                                                DisplayMemberPath="complementoadicional"
                                                SelectedValueMemberPath="codcompladicional"/>
                <telerik:GridViewDataColumn Header="UNID" DataMemberBinding="{Binding unidade}" TextAlignment="Center"/>
                <telerik:GridViewDataColumn Header="ESTOQUE" DataMemberBinding="{Binding saldoestoque, Converter={StaticResource ConverterNumber}}" TextAlignment="Center"/>
                <telerik:GridViewDataColumn Header="QTDE" DataMemberBinding="{Binding qtd, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ConverterNumber}}"/>
                <telerik:GridViewCheckBoxColumn UniqueName="confirmado" Header="CONFIRMADO" DataMemberBinding="{Binding confirmado, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ConverterBoolen}}"/>
                <telerik:GridViewDataColumn Header="CODDETALHESCOMPL" DataMemberBinding="{Binding coddetalhescompl, Converter={StaticResource ConverterNumber}}" DataFormatString="{}{0:F0}"/>
                <telerik:GridViewDataColumn Header="QTD EXPEDIDA" DataMemberBinding="{Binding qtd_expedida, Converter={StaticResource ConverterNumber}}" TextAlignment="Center"/>
                <telerik:GridViewDataColumn Header="REQUISIÇÃO"
                                            DataMemberBinding="{Binding num_os_produto}"
                                            IsReadOnly="True">
                    <telerik:GridViewDataColumn.CellTemplate>
                        <DataTemplate>
                            <telerik:RadButton Content="{Binding num_os_produto, Converter={StaticResource NameButtonConverter}}"
                                               Click="OnRequisicaoComplementoClick"
                                               Margin="0,0,2,2"/>
                        </DataTemplate>
                    </telerik:GridViewDataColumn.CellTemplate>
                </telerik:GridViewDataColumn>
                <telerik:GridViewDataColumn Header="alterado_por" DataMemberBinding="{Binding alterado_por}"/>
                <telerik:GridViewDataColumn Header="data_alteracao" DataMemberBinding="{Binding data_alteracao}" DataFormatString="{}{0:dd/MM/yyyy HH:mm}"/>
            </telerik:RadGridView.Columns>
        </telerik:RadGridView>
    </Grid>
</UserControl>
