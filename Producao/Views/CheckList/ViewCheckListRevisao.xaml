<UserControl x:Class="Producao.Views.ViewCheckListRevisao"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:local="clr-namespace:Producao.Views"
             xmlns:vewModel="clr-namespace:Producao"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded">

    <UserControl.Resources>
        <vewModel:ConverterNumber x:Key="ConverterNumber"/>
        <vewModel:ConverterBoolen x:Key="ConverterBoolen"/>
        <local:PrazoColorConverter x:Key="prazoCollor"/>
        <local:SiglaColorConverter x:Key="siglaCollor"/>

        <Style x:Key="SiglaCellStyle" TargetType="telerik:GridViewCell">
            <Setter Property="Background" Value="{Binding Converter={StaticResource siglaCollor}}"/>
        </Style>

        <Style x:Key="PrazoCellStyle" TargetType="telerik:GridViewCell">
            <Setter Property="Background" Value="{Binding Converter={StaticResource prazoCollor}}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <telerik:RadGridView x:Name="itens"
                             ItemsSource="{Binding Dados}"
                             AutoGenerateColumns="False"
                             ShowGroupPanel="False"
                             IsFilteringAllowed="True"
                             FrozenColumnCount="9"
                             CanUserResizeColumns="True"
                             SelectionUnit="Mixed"
                             SelectionMode="Extended"
                             ClipboardCopyMode="All"
                             CellEditEnded="itens_CellEditEnded"
                             RowValidated="itens_RowValidated">
            <telerik:RadGridView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Exportar Excel" Click="OnExportarExcelClick"/>
                </ContextMenu>
            </telerik:RadGridView.ContextMenu>

            <telerik:RadGridView.Columns>
                <telerik:GridViewDataColumn Header="Data Expedição" UniqueName="data_de_expedicao" DataMemberBinding="{Binding data_de_expedicao}" DataFormatString="{}{0:dd/MM/yyyy}" IsReadOnly="True"/>
                <telerik:GridViewDataColumn Header="Sigla" UniqueName="sigla_serv" DataMemberBinding="{Binding sigla_serv}" CellStyle="{StaticResource SiglaCellStyle}" IsReadOnly="True"/>
                <telerik:GridViewDataColumn Header="Tema" UniqueName="tema" DataMemberBinding="{Binding tema}" IsReadOnly="True"/>
                <telerik:GridViewDataColumn Header="Item" UniqueName="item" DataMemberBinding="{Binding item}" IsReadOnly="True"/>
                <telerik:GridViewDataColumn Header="Local" UniqueName="local" DataMemberBinding="{Binding local}" IsReadOnly="True"/>
                <telerik:GridViewDataColumn Header="Detalhe Local" UniqueName="detalhe_local" DataMemberBinding="{Binding detalhe_local}" IsReadOnly="True"/>
                <telerik:GridViewDataColumn Header="Quantidade" UniqueName="qtd" DataMemberBinding="{Binding qtd, Converter={StaticResource ConverterNumber}}" IsReadOnly="True"/>
                <telerik:GridViewDataColumn Header="Descrição Comercial" UniqueName="descricaocomercial" DataMemberBinding="{Binding descricaocomercial}" IsReadOnly="True"/>
                <telerik:GridViewDataColumn Header="Dimensão" UniqueName="dimensao" DataMemberBinding="{Binding dimensao}" IsReadOnly="True"/>
                <telerik:GridViewDataColumn Header="Bloco" UniqueName="bloco" DataMemberBinding="{Binding bloco}" IsReadOnly="True"/>

                <telerik:GridViewComboBoxColumn Header="Resp Revisão"
                                                UniqueName="resp_revisao"
                                                DataMemberBinding="{Binding resp_revisao, Mode=TwoWay}"
                                                ItemsSource="{Binding DataContext.Revisores, RelativeSource={RelativeSource AncestorType=telerik:RadGridView}}"
                                                DisplayMemberPath="revisores"
                                                SelectedValueMemberPath="revisores"/>
                <telerik:GridViewDataColumn Header="Prazo Revisão" UniqueName="prazo_revisao" DataMemberBinding="{Binding prazo_revisao, Mode=TwoWay}" DataFormatString="{}{0:dd/MM/yyyy}" CellStyle="{StaticResource PrazoCellStyle}"/>
                <telerik:GridViewCheckBoxColumn Header="OK" UniqueName="ok" DataMemberBinding="{Binding ok, Mode=TwoWay, Converter={StaticResource ConverterBoolen}}"/>
                <telerik:GridViewDataColumn Header="Revisado Por" UniqueName="revisado_por" DataMemberBinding="{Binding revisado_por, Mode=TwoWay}"/>
                <telerik:GridViewDataColumn Header="Pendência" UniqueName="pendencia" DataMemberBinding="{Binding pendencia, Mode=TwoWay}"/>
                <telerik:GridViewDataColumn Header="Data Revisado Por" UniqueName="data_revisado_por" DataMemberBinding="{Binding data_revisado_por, Mode=TwoWay}" DataFormatString="{}{0:dd/MM/yyyy}"/>
                <telerik:GridViewDataColumn Header="motivo alteração após revisão" UniqueName="motivo_alt_pos_revisao" DataMemberBinding="{Binding motivo_alt_pos_revisao, Mode=TwoWay}"/>
                <telerik:GridViewCheckBoxColumn Header="Ok Revisão Alterada" UniqueName="ok_revisao_alterada" DataMemberBinding="{Binding ok_revisao_alterada, Mode=TwoWay, Converter={StaticResource ConverterBoolen}}"/>
                <telerik:GridViewDataColumn Header="revisão Alterada Por" UniqueName="revisao_alt_por" DataMemberBinding="{Binding revisao_alt_por, Mode=TwoWay}"/>
                <telerik:GridViewDataColumn Header="Data Alterada Revisão" UniqueName="data_alt_revisao" DataMemberBinding="{Binding data_alt_revisao, Mode=TwoWay}" DataFormatString="{}{0:dd/MM/yyyy}"/>
                <telerik:GridViewDataColumn Header="Obs Revisão" UniqueName="obs_revisao" DataMemberBinding="{Binding obs_revisao, Mode=TwoWay}"/>
                <telerik:GridViewDataColumn Header="Memorial Alterado Por" UniqueName="memorial_alterado_por" DataMemberBinding="{Binding memorial_alterado_por, Mode=TwoWay}"/>
                <telerik:GridViewDataColumn Header="Memorial Data Alterado" UniqueName="memorial_data_alterado" DataMemberBinding="{Binding memorial_data_alterado, Mode=TwoWay}" DataFormatString="{}{0:dd/MM/yyyy}"/>
                <telerik:GridViewCheckBoxColumn Header="Altera Ok" UniqueName="altera_ok" DataMemberBinding="{Binding altera_ok, Mode=TwoWay, Converter={StaticResource ConverterBoolen}}"/>
                <telerik:GridViewDataColumn Header="Confirma Alteração Por" UniqueName="confirma_alteracao_por" DataMemberBinding="{Binding confirma_alteracao_por, Mode=TwoWay}"/>
                <telerik:GridViewDataColumn Header="Confirma Alteração Data" UniqueName="confirma_alteracao_data" DataMemberBinding="{Binding confirma_alteracao_data, Mode=TwoWay}" DataFormatString="{}{0:dd/MM/yyyy}"/>
            </telerik:RadGridView.Columns>
        </telerik:RadGridView>
    </Grid>
</UserControl>
