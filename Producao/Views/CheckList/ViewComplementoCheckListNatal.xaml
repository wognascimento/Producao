<UserControl x:Class="Producao.Views.CheckList.ViewComplementoCheckListNatal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:local="clr-namespace:Producao.Views.CheckList"
             xmlns:app="clr-namespace:Producao"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded">

    <UserControl.Resources>
        <app:ConverterNumber x:Key="ConverterNumber"/>
        <app:ConverterBoolen x:Key="ConverterBoolen"/>
        <local:NameButtonConverter x:Key="NameButtonConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <telerik:RadComboBox x:Name="cbSigla"
                                 Margin="0,0,2,2"
                                 EmptyText="SIGLA"
                                 IsEditable="True"
                                 IsFilteringEnabled="True"
                                 OpenDropDownOnFocus="True"
                                 ItemsSource="{Binding Siglas}"
                                 DisplayMemberPath="sigla_serv"
                                 SelectedValuePath="id_aprovado"
                                 SelectedItem="{Binding Sigla, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 SelectionChanged="OnSiglaSelectionChanged" IsTextSearchEnabled="True" StaysOpenOnEdit="True" CanAutocompleteSelectItems="False" CanKeyboardNavigationSelectItems="False" UpdateSelectionOnLostFocus="False" UpdateTextOnLostFocus="False"/>

            <telerik:RadComboBox x:Name="cbPlanilha"
                                 Grid.Column="1"
                                 Margin="0,0,2,2"
                                 EmptyText="PLANILHA"
                                 IsEditable="True"
                                 IsFilteringEnabled="True"
                                 OpenDropDownOnFocus="True"
                                 ItemsSource="{Binding Planilhas}"
                                 DisplayMemberPath="planilha"
                                 SelectedValuePath="planilha"
                                 SelectedItem="{Binding Planilha, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 SelectionChanged="OnPlanilhaSelectionChanged" IsTextSearchEnabled="True" StaysOpenOnEdit="True" CanAutocompleteSelectItems="False" CanKeyboardNavigationSelectItems="False" UpdateSelectionOnLostFocus="False" UpdateTextOnLostFocus="False"/>

            <telerik:RadComboBox x:Name="cbGrupo"
                                 Grid.Column="2"
                                 EmptyText="GRUPO"
                                 IsEditable="True"
                                 IsFilteringEnabled="True"
                                 OpenDropDownOnFocus="True"
                                 ItemsSource="{Binding Grupos}"
                                 SelectionChanged="OnGrupoSelectionChanged" Margin="0,0,2,2" IsTextSearchEnabled="True" StaysOpenOnEdit="True" CanAutocompleteSelectItems="False" CanKeyboardNavigationSelectItems="False" UpdateSelectionOnLostFocus="False" UpdateTextOnLostFocus="False"/>
        </Grid>

        <telerik:RadGridView x:Name="dgCheckListGeral"
                             Grid.Row="1"
                             AutoGenerateColumns="False"
                             CanUserResizeColumns="True"
                             CanUserReorderColumns="True"
                             ShowGroupPanel="False"
                             IsFilteringAllowed="True"
                             RowIndicatorVisibility="Visible"
                             ItemsSource="{Binding Itens}"
                             SelectedItem="{Binding Chklist, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             SelectionChanged="OnSelectionChanged"
                             FontSize="10"
                             MouseDoubleClick="dgCheckListGeral_MouseDoubleClick">
            <telerik:RadGridView.Columns>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding sigla}" Header="sigla" IsReadOnly="True"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding local_shoppings}" Header="local_shoppings" IsReadOnly="True"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding planilha}" Header="planilha" IsReadOnly="True"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding qtd, Converter={StaticResource ConverterNumber}}" Header="qtd" IsReadOnly="True"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding descricao}" Header="descricao" IsReadOnly="True"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding obs}" Header="obs" IsReadOnly="True"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding orient_montagem}" Header="orient_montagem" IsReadOnly="True"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding ordem}" Header="ID" IsReadOnly="True"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding item_memorial}" Header="item_memorial" IsReadOnly="True"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding codcompl, Converter={StaticResource ConverterNumber}}" Header="codcompl" IsReadOnly="True" DataFormatString="{}{0:F0}"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding descricao_adicional}" Header="descricao_adicional" IsReadOnly="True"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding coduniadicional, Converter={StaticResource ConverterNumber}}" Header="coduniadicional" IsReadOnly="True"/>
                <telerik:GridViewCheckBoxColumn DataMemberBinding="{Binding ok_revisao_alterada, Converter={StaticResource ConverterBoolen}}" Header="ok_revisao_alterada" IsReadOnly="True"/>
                <telerik:GridViewCheckBoxColumn DataMemberBinding="{Binding ok, Converter={StaticResource ConverterBoolen}}" Header="confirmado" IsReadOnly="True"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding data_de_expedicao, StringFormat=d}" Header="data_de_expedicao" IsReadOnly="True"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding baia_local}" Header="baia_local" IsReadOnly="True"/>
            </telerik:RadGridView.Columns>
        </telerik:RadGridView>

        <GridSplitter Grid.Row="2"
                      Height="5"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"/>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <telerik:RadGridView Grid.Row="1"
                                 x:Name="dgComplemento"
                                 CanUserInsertRows="True"
                                 GroupRenderMode="Flat"
                                 NewRowPosition="Bottom"
                                 RowIndicatorVisibility="Visible"
                                 AutoGenerateColumns="False"
                                 ShowGroupPanel="False"
                                 ItemsSource="{Binding CheckListGeralComplementos}"
                                 SelectedItem="{Binding CheckListGeralComplemento, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 CellEditEnded="dgComplemento_CellEditEnded"
                                 FontSize="10"
                                 RowValidated="dgComplemento_RowValidated"
                                 RowValidating="dgComplemento_RowValidating"
                                 AddingNewDataItem="dgComplemento_AddingNewDataItem"
                                 CanUserResizeColumns="True">
                <telerik:RadGridView.Columns>
                    <telerik:GridViewComboBoxColumn UniqueName="codcompladicional"
                                                    Header="COMPLEMENTO ADICIONAL"
                                                    DataMemberBinding="{Binding codcompladicional, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    ItemsSource="{Binding DataContext.CompleAdicionais, RelativeSource={RelativeSource AncestorType=telerik:RadGridView}}"
                                                    DisplayMemberPath="complementoadicional"
                                                    SelectedValueMemberPath="codcompladicional"/>
                    <telerik:GridViewDataColumn Header="UNID"
                                                DataMemberBinding="{Binding unidade}"
                                                TextAlignment="Center"
                                                IsReadOnly="True"/>
                    <telerik:GridViewDataColumn Header="ESTOQUE"
                                                DataMemberBinding="{Binding saldoestoque, Converter={StaticResource ConverterNumber}}"
                                                TextAlignment="Center"
                                                IsReadOnly="True"/>
                    <telerik:GridViewDataColumn Header="QTDE"
                                                DataMemberBinding="{Binding qtd, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ConverterNumber}}"/>
                    <telerik:GridViewCheckBoxColumn Header="CONFIRMADO"
                                                    DataMemberBinding="{Binding confirmado, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ConverterBoolen}}"/>
                    <telerik:GridViewDataColumn Header="CODDETALHESCOMPL"
                                                DataMemberBinding="{Binding coddetalhescompl, Converter={StaticResource ConverterNumber}}"
                                                IsReadOnly="True"
                                                DataFormatString="{}{0:F0}"/>
                    <telerik:GridViewDataColumn Header="QTD EXPEDIDA"
                                                DataMemberBinding="{Binding qtd_expedida, Converter={StaticResource ConverterNumber}}"
                                                TextAlignment="Center"
                                                IsReadOnly="True"/>
                    <telerik:GridViewDataColumn Header="REQUISIÇÃO"
                                                DataMemberBinding="{Binding num_os_produto}"
                                                IsReadOnly="True">
                        <telerik:GridViewDataColumn.CellTemplate>
                            <DataTemplate>
                                <telerik:RadButton Content="{Binding num_os_produto, Converter={StaticResource NameButtonConverter}}"
                                                   Click="OnRequisicaoClick" Margin="0,0,2,2"/>
                            </DataTemplate>
                        </telerik:GridViewDataColumn.CellTemplate>
                    </telerik:GridViewDataColumn>
                </telerik:RadGridView.Columns>
            </telerik:RadGridView>
        </Grid>
    </Grid>
</UserControl>
