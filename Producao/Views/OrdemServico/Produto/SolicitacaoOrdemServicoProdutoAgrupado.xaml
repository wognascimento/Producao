<UserControl x:Class="Producao.Views.OrdemServico.Produto.SolicitacaoOrdemServicoProdutoAgrupado"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vewModel="clr-namespace:Producao"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <vewModel:ConverterNumber x:Key="ConverterNumber"/>
        <vewModel:ConverterBoolen x:Key="ConverterBoolen"/>
    </UserControl.Resources>

    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="303"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="5"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="TIPO DA O.S." Margin="0,0,2,2"/>
            <telerik:RadComboBox x:Name="cmbTipoOs" ItemsSource="{Binding TpoOS}" Margin="0,0,2,2"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="0">
            <TextBlock Text="BUSCAR PRODUTO POR CÓDIGO" Margin="0,0,2,2"/>
            <telerik:RadWatermarkTextBox x:Name="tbCodproduto" PreviewKeyDown="OnBuscaProduto" Margin="0,0,2,2"/>
        </StackPanel>

        <telerik:RadButton x:Name="btnBuscar"
                           Grid.Row="1"
                           Grid.Column="2"
                           Width="50"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Bottom"
                           Content="..."
                           Click="OnOpenDescricoes" Margin="0,0,2,2"/>

        <StackPanel Grid.Row="2" Grid.Column="0">
            <TextBlock Text="PLANILHA" Margin="0,0,2,2"/>
            <telerik:RadComboBox x:Name="txtPlanilha"
                      IsEditable="True"
                      IsTextSearchEnabled="True"
                      ItemsSource="{Binding Planilhas}"
                      DisplayMemberPath="planilha"
                      SelectedItem="{Binding Planilha, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      SelectionChanged="OnSelectedPlanilha" Margin="0,0,2,2" IsFilteringEnabled="True" OpenDropDownOnFocus="True" StaysOpenOnEdit="True" CanAutocompleteSelectItems="False" CanKeyboardNavigationSelectItems="False" UpdateSelectionOnLostFocus="False" UpdateTextOnLostFocus="False"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.Column="2">
            <TextBlock Text="DESCRIÇÃO" Margin="0,0,2,2"/>
            <telerik:RadComboBox x:Name="txtDescricao"
                      IsEditable="True"
                      IsTextSearchEnabled="True"
                      ItemsSource="{Binding Produtos}"
                      DisplayMemberPath="descricao"
                      SelectedItem="{Binding Produto, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      SelectionChanged="OnSelectedDescricao" Margin="0,0,2,2" IsFilteringEnabled="True" OpenDropDownOnFocus="True" StaysOpenOnEdit="True" CanAutocompleteSelectItems="False" CanKeyboardNavigationSelectItems="False" UpdateSelectionOnLostFocus="False" UpdateTextOnLostFocus="False"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3">
            <TextBlock Text="DESCRIÇÃO ADICIONAL" Margin="0,0,2,2"/>
            <telerik:RadComboBox x:Name="txtDescricaoAdicional"
                      IsEditable="True"
                      IsTextSearchEnabled="True"
                      ItemsSource="{Binding DescAdicionais}"
                      DisplayMemberPath="descricao_adicional"
                      SelectedItem="{Binding DescAdicional, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      SelectionChanged="OnSelectedDescricaoAdicional" Margin="0,0,2,2" IsFilteringEnabled="True" OpenDropDownOnFocus="True" StaysOpenOnEdit="True" CanAutocompleteSelectItems="False" CanKeyboardNavigationSelectItems="False" UpdateSelectionOnLostFocus="False" UpdateTextOnLostFocus="False"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3">
            <TextBlock Text="COMPLEMENTO ADICIONAL" Margin="0,0,2,2"/>
            <telerik:RadComboBox x:Name="txtComplementoAdicional"
                      IsEditable="True"
                      IsTextSearchEnabled="True"
                      ItemsSource="{Binding CompleAdicionais}"
                      DisplayMemberPath="complementoadicional"
                      SelectedItem="{Binding Compledicional, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      SelectionChanged="OnSelectedComplementoAdicional" Margin="0,0,2,2" IsFilteringEnabled="True" OpenDropDownOnFocus="True" StaysOpenOnEdit="True" CanAutocompleteSelectItems="False" CanKeyboardNavigationSelectItems="False" UpdateSelectionOnLostFocus="False" UpdateTextOnLostFocus="False"/>
        </StackPanel>

        <telerik:RadGridView x:Name="dgClientes"
                             Grid.Row="10"
                             Grid.ColumnSpan="3"
                             AutoGenerateColumns="False"
                             CanUserInsertRows="True"
                             CanUserResizeColumns="True"
                             GroupRenderMode="Flat"
                             NewRowPosition="Bottom"
                             ShowGroupPanel="False"
                             RowDetailsVisibilityMode="VisibleWhenSelected"
                             ItemsSource="{Binding ProdutoOSs}"
                             SelectedItem="{Binding ProdutoOs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AddingNewDataItem="dgClientes_AddNewDataItem"
                             RowValidated="dgClientes_RowValidated"
                             RowValidating="dgClientes_RowValidating">
            <telerik:RadGridView.Columns>
                <telerik:GridViewComboBoxColumn Header="SHOPP"
                                                DataMemberBinding="{Binding cliente}"
                                                ItemsSource="{Binding DataContext.Siglas, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                DisplayMemberPath="sigla_serv"
                                                SelectedValueMemberPath="sigla_serv"
                                                Width="350"/>
                <telerik:GridViewDataColumn Header="QUANTIDADE" DataMemberBinding="{Binding quantidade}"/>
            </telerik:RadGridView.Columns>

            <telerik:RadGridView.RowDetailsTemplate>
                <DataTemplate>
                    <telerik:RadGridView x:Name="FirstLevelNestedGrid"
                                         AutoGenerateColumns="False"
                                         CanUserInsertRows="True"
                                         CanUserResizeColumns="True"
                                         GroupRenderMode="Flat"
                                         NewRowPosition="Bottom"
                                         ShowGroupPanel="False"
                                         ItemsSource="{Binding Observacoes}"
                                         AddingNewDataItem="FirstLevelNestedGrid_AddNewDataItem"
                                         RowValidated="FirstLevelNestedGrid_RowValidated"
                                         RowValidating="FirstLevelNestedGrid_RowValidating">
                        <telerik:RadGridView.Columns>
                            <telerik:GridViewDataColumn Header="ORDEM CAMINHO"
                                                        DataMemberBinding="{Binding num_caminho, Converter={StaticResource ConverterNumber}}"/>
                            <telerik:GridViewComboBoxColumn Header="CAMINHO - SETOR"
                                                            DataMemberBinding="{Binding codigo_setor}"
                                                            ItemsSource="{Binding DataContext.Setores, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            DisplayMemberPath="setor"
                                                            SelectedValueMemberPath="codigo_setor"
                                                            Width="236"/>
                            <telerik:GridViewDataColumn Header="ORIENTAÇÃO"
                                                        DataMemberBinding="{Binding orientacao_caminho}"
                                                        TextWrapping="Wrap"/>
                            <telerik:GridViewCheckBoxColumn Header="PERMISSÃO DE TRABALHO"
                                                            DataMemberBinding="{Binding pt}"/>
                        </telerik:RadGridView.Columns>
                    </telerik:RadGridView>
                </DataTemplate>
            </telerik:RadGridView.RowDetailsTemplate>
        </telerik:RadGridView>
    </Grid>
</UserControl>
