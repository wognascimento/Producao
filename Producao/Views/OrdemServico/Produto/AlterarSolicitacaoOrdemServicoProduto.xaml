<UserControl x:Class="Producao.Views.OrdemServico.Produto.AlterarSolicitacaoOrdemServicoProduto"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:local="clr-namespace:Producao.Views.OrdemServico.Produto"
             mc:Ignorable="d"
             d:DesignHeight="620"
             d:DesignWidth="1100"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Nº O.S" Margin="0,0,2,2"/>
            <telerik:RadWatermarkTextBox Grid.Row="1" Grid.Column="0" x:Name="tbBuscaProduto" KeyDown="OnBuscaProduto" Margin="0,0,2,2"/>

            <TextBlock Grid.Row="0" Grid.Column="1" Text="Tipo" Margin="0,0,2,2"/>
            <telerik:RadComboBox Grid.Row="1" Grid.Column="1" x:Name="cmbTipoOs" IsEditable="True" Margin="0,0,2,2" IsTextSearchEnabled="True" IsFilteringEnabled="True" OpenDropDownOnFocus="True" StaysOpenOnEdit="True" CanAutocompleteSelectItems="False" CanKeyboardNavigationSelectItems="False" UpdateSelectionOnLostFocus="False" UpdateTextOnLostFocus="False"/>

            <TextBlock Grid.Row="0" Grid.Column="2" Text="Planilha" Margin="0,0,2,2"/>
            <telerik:RadWatermarkTextBox Grid.Row="1" Grid.Column="2" x:Name="txtPlanilha" IsReadOnly="True" Margin="0,0,2,2"/>

            <TextBlock Grid.Row="0" Grid.Column="3" Text="Descrição" Margin="0,0,2,2"/>
            <telerik:RadWatermarkTextBox Grid.Row="1" Grid.Column="3" x:Name="txtDescricao" IsReadOnly="True" Margin="0,0,2,2"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Qtde" Margin="0,0,2,2"/>
            <telerik:RadWatermarkTextBox Grid.Row="3" Grid.Column="0" x:Name="txtQuantidade" IsReadOnly="True" Margin="0,0,2,2"/>

            <TextBlock Grid.Row="2" Grid.Column="1" Text="Descrição adicional" Margin="0,0,2,2"/>
            <telerik:RadWatermarkTextBox Grid.Row="3" Grid.Column="1" x:Name="txtDescricaoAdicional" IsReadOnly="True" Margin="0,0,2,2"/>

            <TextBlock Grid.Row="2" Grid.Column="2" Text="Complemento" Margin="0,0,2,2"/>
            <telerik:RadWatermarkTextBox Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" x:Name="txtComplementoAdicional" IsReadOnly="True" Margin="0,0,2,2"/>
        </Grid>

        <telerik:RadGridView
            x:Name="caminhos"
            Grid.Row="1"
            AutoGenerateColumns="False"
            CanUserInsertRows="True"
            CanUserDeleteRows="False"
            CanUserResizeColumns="True"
            GroupRenderMode="Flat"
            NewRowPosition="Top"
            ShowGroupPanel="False"
            IsFilteringAllowed="True"
            ItemsSource="{Binding ObsOSs}"
            AddingNewDataItem="caminhos_AddingNewDataItem"
            RowEditEnded="caminhos_RowEditEnded" SelectionMode="Multiple">

            <telerik:RadGridView.Columns>
                <telerik:GridViewDataColumn Header="CAMINHO" DataMemberBinding="{Binding num_caminho}" Width="90"/>
                <telerik:GridViewComboBoxColumn
                    Header="SETOR"
                    DataMemberBinding="{Binding codigo_setor}"
                    ItemsSource="{Binding DataContext.Setores, RelativeSource={RelativeSource AncestorType=telerik:RadGridView}}"
                    DisplayMemberPath="setor"
                    SelectedValueMemberPath="codigo_setor"
                    Width="240"/>
                <telerik:GridViewDataColumn Header="ORIENTAÇÃO" DataMemberBinding="{Binding orientacao_caminho}" Width="*"/>
                <telerik:GridViewCheckBoxColumn Header="CANCELAR" DataMemberBinding="{Binding cancelar}" Width="90"/>
                <telerik:GridViewComboBoxColumn Header="DISTRIBUIR"
                                                DataMemberBinding="{Binding distribuir_os}"
                                                ItemsSource="{Binding DataContext.DistribuirOS, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Width="140"/>
                <telerik:GridViewComboBoxColumn Header="CLIENTE"
                                                DataMemberBinding="{Binding cliente}"
                                                ItemsSource="{Binding DataContext.Siglas, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                DisplayMemberPath="sigla_serv"
                                                SelectedValueMemberPath="sigla_serv"
                                                Width="160"/>
            </telerik:RadGridView.Columns>
        </telerik:RadGridView>

        <telerik:RadButton
            Grid.Row="2"
            Content="IMPRIMIR"
            HorizontalAlignment="Right"
            Width="110"
            Margin="0,0,2,2"
            Click="OnPrintClick"/>
    </Grid>
</UserControl>
