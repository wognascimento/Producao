<UserControl x:Class="Producao.Views.OrdemServico.Produto.ProgramacaoProducao"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:local="clr-namespace:Producao.Views.OrdemServico.Produto"
             xmlns:app="clr-namespace:Producao"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <app:ConverterNumber x:Key="ConverterNumber"/>
        <app:ConverterBoolen x:Key="ConverterBoolen"/>
        <local:ProgramacaoProducaoColorConverter x:Key="converterCollor"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="230"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0">
                <TextBlock Text="LOCAL"/>
                <telerik:RadComboBox ItemsSource="{Binding Locais}"
                          DisplayMemberPath="localizacao"
                          SelectedValuePath="localizacao"
                          SelectionChanged="LocaisSelectionChanged"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="0">
                <TextBlock Text="SETORES"/>
                <telerik:RadComboBox ItemsSource="{Binding Setores}"
                          DisplayMemberPath="setor"
                          SelectedValuePath="setor"
                          IsTextSearchEnabled="True"
                          SelectionChanged="SetoresSelectionChanged"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="0">
                <TextBlock Text="ENCARREGADO"/>
                <telerik:RadWatermarkTextBox/>
            </StackPanel>

            <StackPanel Grid.Row="3" Grid.Column="0">
                <TextBlock Text="RESPONSÁVEL"/>
                <telerik:RadWatermarkTextBox/>
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="1" Margin="5,0,0,0">
                <TextBlock Text="FILA/M.O"/>
                <telerik:RadWatermarkTextBox x:Name="txtFila" IsEnabled="False" TextAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="1" Margin="5,0,0,0">
                <TextBlock Text="EM ANDAMENTO"/>
                <telerik:RadWatermarkTextBox x:Name="txtAndamento" IsEnabled="False" TextAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="1" Margin="5,0,0,0">
                <TextBlock Text="EMBALAGEM/EXPEDIÇÃO"/>
                <telerik:RadWatermarkTextBox x:Name="txtProjeto" IsEnabled="False" TextAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Grid.Column="1" Margin="5,0,0,0">
                <TextBlock Text="ESPAÇO FÍSICO"/>
                <telerik:RadWatermarkTextBox x:Name="txtDiretoria" IsEnabled="False" TextAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="2" Margin="5,0,0,0">
                <TextBlock Text="INDEFINIDO"/>
                <telerik:RadWatermarkTextBox x:Name="txtIndefinido" IsEnabled="False" TextAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="2" Margin="5,0,0,0">
                <TextBlock Text="PROJETOS"/>
                <telerik:RadWatermarkTextBox x:Name="txtProjetos" IsEnabled="False" TextAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="2" Margin="5,0,0,0">
                <TextBlock Text="FALTA MATERIAL INTERNO / TRANSF"/>
                <telerik:RadWatermarkTextBox x:Name="txtFaltaMaterialTranf" IsEnabled="False" TextAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Grid.Column="2" Margin="5,0,0,0">
                <TextBlock Text="FALTA MATERIAL EXTERNO / COMPRAS"/>
                <telerik:RadWatermarkTextBox x:Name="txtFaltaMaterialCompras" IsEnabled="False" TextAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="3" Margin="5,0,0,0">
                <TextBlock Text="PLANILHAS"/>
                <telerik:RadComboBox ItemsSource="{Binding Aprovados}"
                          DisplayMemberPath="SiglaServ"
                          SelectedValuePath="SiglaServ"
                          IsTextSearchEnabled="True"/>
            </StackPanel>

            <telerik:RadButton Grid.Row="3"
                               Grid.Column="3"
                               HorizontalAlignment="Right"
                               Padding="10,6"
                               Content="IMPRIMIR"
                               Click="OnPrintClick"/>
        </Grid>

        <telerik:RadGridView x:Name="programacao"
                             Grid.Row="1"
                             AutoGenerateColumns="False"
                             CanUserResizeColumns="True"
                             CanUserReorderColumns="True"
                             IsFilteringAllowed="True"
                             ShowGroupPanel="False"
                             ItemsSource="{Binding Programacoes}"
                             SelectedItem="{Binding Programacao, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AddingNewDataItem="OnAddNewDataItem"
                             RowValidated="OnRowValidated"
                             RowValidating="OnRowValidating">
            <telerik:RadGridView.Columns>
                <telerik:GridViewDataColumn Header="ORD." DataMemberBinding="{Binding programacao_ordem, Converter={StaticResource ConverterNumber}}"/>
                <telerik:GridViewDataColumn Header="CLIENTE" DataMemberBinding="{Binding cliente_os}" IsReadOnly="True"/>
                <telerik:GridViewDataColumn Header="DATA DE EXPEDIÇÃO" DataMemberBinding="{Binding data_de_expedicao, StringFormat={}{0:dd/MM/yyyy}}" IsReadOnly="True"/>
                <telerik:GridViewDataColumn Header="PLANILHA" DataMemberBinding="{Binding planilha}" IsReadOnly="True"/>
                <telerik:GridViewDataColumn Header="descricao_completa" DataMemberBinding="{Binding descricao_completa}" IsReadOnly="True"/>
                <telerik:GridViewDataColumn Header="QTD" DataMemberBinding="{Binding quantidade_os, Converter={StaticResource ConverterNumber}}" IsReadOnly="True"/>
                <telerik:GridViewDataColumn Header="Nº OS" DataMemberBinding="{Binding num_os}" IsReadOnly="True"/>
                <telerik:GridViewDataColumn Header="TIPO" DataMemberBinding="{Binding tipo_os}" IsReadOnly="True"/>
                <telerik:GridViewComboBoxColumn Header="STATUS"
                                                DataMemberBinding="{Binding programacao_status}"
                                                ItemsSource="{Binding DataContext.DistribuirOS, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                <telerik:GridViewDataColumn Header="setor_caminho" DataMemberBinding="{Binding setor_caminho}" IsReadOnly="True"/>
                <telerik:GridViewDataColumn Header="orientacao_caminho" DataMemberBinding="{Binding orientacao_caminho}" IsReadOnly="True"/>
                <telerik:GridViewDataColumn Header="setor_caminho_proximo" DataMemberBinding="{Binding setor_caminho_proximo}" IsReadOnly="True"/>
                <telerik:GridViewDataColumn Header="PENDENCIA E/OU OBSERVAÇÃO" DataMemberBinding="{Binding programacao_observacao}"/>
                <telerik:GridViewDataColumn Header="ht" DataMemberBinding="{Binding ht, Converter={StaticResource ConverterNumber}}" IsReadOnly="True"/>
                <telerik:GridViewDataColumn Header="ATUALIZADO POR" DataMemberBinding="{Binding programacao_inserido_por}" IsReadOnly="True"/>
                <telerik:GridViewDataColumn Header="ATUALIZADO EM" DataMemberBinding="{Binding programacao_inserido_data}" IsReadOnly="True"/>
                <telerik:GridViewDataColumn Header="custo_mao_obra" DataMemberBinding="{Binding custo_mao_obra}" IsReadOnly="True"/>
            </telerik:RadGridView.Columns>
        </telerik:RadGridView>
    </Grid>
</UserControl>
