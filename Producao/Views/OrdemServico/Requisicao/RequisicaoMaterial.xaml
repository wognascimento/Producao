<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vewModel="clr-namespace:Producao"
    xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
    x:Class="Producao.Views.OrdemServico.Requisicao.RequisicaoMaterial"
    mc:Ignorable="d"
    Title="Requisição de Material"
    Height="auto"
    Width="auto"
    WindowStartupLocation="CenterScreen"
    WindowStyle="ToolWindow"
    ResizeMode="NoResize"
    Loaded="Window_Loaded"
    Unloaded="Window_Unloaded">

    <Window.Resources>
        <vewModel:ConverterNumber x:Key="ConverterNumber"/>
        <vewModel:ConverterBoolen x:Key="ConverterBoolen"/>
    </Window.Resources>

    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="303"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="5"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="REQUISIÇÃO NÚMERO" Margin="0,0,2,2"/>
            <telerik:RadWatermarkTextBox x:Name="tbNumRequisicao"
                     Text="{Binding Requisicao.num_requisicao}"
                     IsEnabled="False"
                     TextAlignment="Center" Margin="0,0,2,2"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="0">
            <TextBlock Text="BUSCAR PRODUTO POR CÓDIGO" Margin="0,0,2,2"/>
            <telerik:RadWatermarkTextBox x:Name="tbCodproduto" PreviewKeyDown="OnBuscaProduto" Margin="0,0,2,2"/>
        </StackPanel>

        <telerik:RadButton x:Name="btnBuscar"
                           Grid.Row="1"
                           Grid.Column="2"
                           Width="50"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Bottom"
                           Content="..."
                           Click="OnOpenDescricoes" Margin="0,0,2,2"/>

        <StackPanel Grid.Row="2" Grid.Column="0">
            <TextBlock Text="PLANILHA" Margin="0,0,2,2"/>
            <telerik:RadComboBox x:Name="txtPlanilha"
                      IsEditable="True"
                      IsTextSearchEnabled="True"
                      ItemsSource="{Binding Planilhas}"
                      DisplayMemberPath="planilha"
                      SelectionChanged="OnSelectedPlanilha" Margin="0,0,2,2" IsFilteringEnabled="True" OpenDropDownOnFocus="True" StaysOpenOnEdit="True" CanAutocompleteSelectItems="False" CanKeyboardNavigationSelectItems="False" UpdateSelectionOnLostFocus="False" UpdateTextOnLostFocus="False"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.Column="2">
            <TextBlock Text="DESCRIÇÃO" Margin="0,0,2,2"/>
            <telerik:RadComboBox x:Name="txtDescricao"
                      IsEditable="True"
                      IsTextSearchEnabled="True"
                      ItemsSource="{Binding Produtos}"
                      DisplayMemberPath="descricao"
                      SelectionChanged="OnSelectedDescricao" Margin="0,0,2,2" IsFilteringEnabled="True" OpenDropDownOnFocus="True" StaysOpenOnEdit="True" CanAutocompleteSelectItems="False" CanKeyboardNavigationSelectItems="False" UpdateSelectionOnLostFocus="False" UpdateTextOnLostFocus="False"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3">
            <TextBlock Text="DESCRIÇÃO ADICIONAL" Margin="0,0,2,2"/>
            <telerik:RadComboBox x:Name="txtDescricaoAdicional"
                      IsEditable="True"
                      IsTextSearchEnabled="True"
                      ItemsSource="{Binding DescAdicionais}"
                      DisplayMemberPath="descricao_adicional"
                      SelectionChanged="OnSelectedDescricaoAdicional" Margin="0,0,2,2" IsFilteringEnabled="True" OpenDropDownOnFocus="True" StaysOpenOnEdit="True" CanAutocompleteSelectItems="False" CanKeyboardNavigationSelectItems="False" UpdateSelectionOnLostFocus="False" UpdateTextOnLostFocus="False"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3">
            <TextBlock Text="COMPLEMENTO ADICIONAL" Margin="0,0,2,2"/>
            <telerik:RadComboBox x:Name="txtComplementoAdicional"
                      IsEditable="True"
                      IsTextSearchEnabled="True"
                      ItemsSource="{Binding CompleAdicionais}"
                      DisplayMemberPath="complementoadicional"
                      SelectionChanged="OnSelectedComplementoAdicional" Margin="0,0,2,2" IsFilteringEnabled="True" OpenDropDownOnFocus="True" StaysOpenOnEdit="True" CanAutocompleteSelectItems="False" CanKeyboardNavigationSelectItems="False" UpdateSelectionOnLostFocus="False" UpdateTextOnLostFocus="False"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Grid.Column="0">
            <TextBlock Text="QUANTIDADE" Margin="0,0,2,2"/>
            <telerik:RadWatermarkTextBox x:Name="txtQuantidade" Margin="0,0,2,2"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Grid.Column="2" Width="100" HorizontalAlignment="Left">
            <TextBlock Text="UNIDADE" Margin="0,0,2,2"/>
            <telerik:RadWatermarkTextBox x:Name="txtUnidade" IsEnabled="False" Margin="0,0,2,2"/>
        </StackPanel>

        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3">
            <TextBlock Text="OBSERVAÇÃO" Margin="0,0,2,2"/>
            <telerik:RadWatermarkTextBox x:Name="txtObservacao" Margin="0,0,2,2"/>
        </StackPanel>

        <Grid Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="75"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="75"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="75"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="75"/>
            </Grid.ColumnDefinitions>

            <telerik:RadButton Grid.Column="0" Content="LIMPAR" Click="OnLimparClick" Margin="0,0,2,2"/>
            <telerik:RadButton Grid.Column="2" Content="ADICIONAR" Click="OnAdicionarClick" Margin="0,0,2,2"/>
            <telerik:RadButton Grid.Column="4" Content="EDITAR" Click="OnEditClick" Margin="0,0,2,2"/>
            <telerik:RadButton Grid.Column="6" Content="BUSCAR RECEITA" Click="OnReceitaClick" Margin="0,0,2,2"/>
            <telerik:RadButton Grid.Column="8" Content="IMPRIMIR" Click="OnPrintClick" Margin="0,0,2,2"/>
        </Grid>

        <telerik:RadGridView x:Name="itens"
                             Grid.Row="10"
                             Grid.Column="0"
                             Grid.ColumnSpan="3"
                             AutoGenerateColumns="False"
                             CanUserResizeColumns="True"
                             CanUserReorderColumns="True"
                             ShowGroupPanel="False"
                             ItemsSource="{Binding QryRequisicaoDetalhes}"
                             MouseDoubleClick="OnMouseDoubleClick">
            <telerik:RadGridView.Columns>
                <telerik:GridViewDataColumn Header="ID" DataMemberBinding="{Binding cod_det_req, Converter={StaticResource ConverterNumber}}"/>
                <telerik:GridViewDataColumn Header="COD." DataMemberBinding="{Binding codcompladicional, Converter={StaticResource ConverterNumber}}"/>
                <telerik:GridViewDataColumn Header="PLANILHA" DataMemberBinding="{Binding planilha}"/>
                <telerik:GridViewDataColumn Header="DESCRIÇÃO" DataMemberBinding="{Binding descricao_completa}"/>
                <telerik:GridViewDataColumn Header="UNID" DataMemberBinding="{Binding unidade}"/>
                <telerik:GridViewDataColumn Header="QTDE" DataMemberBinding="{Binding quantidade, Converter={StaticResource ConverterNumber}}"/>
                <telerik:GridViewDataColumn Header="VOLTAGEM" DataMemberBinding="{Binding voltagem}"/>
                <telerik:GridViewDataColumn Header="LOCAL SHOPPING" DataMemberBinding="{Binding local_shop}"/>
                <telerik:GridViewDataColumn Header="INSERIDO EM" DataMemberBinding="{Binding data, StringFormat={}{0:dd/MM/yyyy}}"/>
                <telerik:GridViewDataColumn Header="INSERIDO POR" DataMemberBinding="{Binding alterado_por}"/>
            </telerik:RadGridView.Columns>
        </telerik:RadGridView>
    </Grid>
</Window>
