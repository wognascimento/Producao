<UserControl x:Class="Producao.Views.OrdemServico.Requisicao.RequisicaoMaterialEmitidas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Producao.Views.OrdemServico.Requisicao" 
             xmlns:vewModel="clr-namespace:Producao"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Initialized="UserControl_Initialized">


    <UserControl.Resources>
        <vewModel:ConverterNumber x:Key="ConverterNumber"/>
        <vewModel:ConverterBoolen x:Key="ConverterBoolen"/>
    </UserControl.Resources>


    <Grid>

        <telerik:RadGridView
            x:Name="itens" 
            AutoGenerateColumns="False" 
            CanUserResizeColumns="True"
            CanUserReorderColumns="True"
            IsFilteringAllowed="True"
            ShowGroupPanel="False"
            ItemsSource="{Binding Itens}">
            <telerik:RadGridView.Columns>
                <telerik:GridViewDataColumn Header="num_os_servico" DataMemberBinding="{Binding num_os_servico, Converter={StaticResource ConverterNumber}}"/>
                <telerik:GridViewDataColumn Header="num_requisicao" DataMemberBinding="{Binding num_requisicao, Converter={StaticResource ConverterNumber}}"/>
                <telerik:GridViewDataColumn Header="id_modelo" DataMemberBinding="{Binding id_modelo, Converter={StaticResource ConverterNumber}}"/>
                <telerik:GridViewDataColumn Header="planilha" DataMemberBinding="{Binding planilha}"/>
                <telerik:GridViewDataColumn Header="descricao_completa" DataMemberBinding="{Binding descricao_completa}"/>
                <telerik:GridViewDataColumn Header="unidade" DataMemberBinding="{Binding unidade}"/>
                <telerik:GridViewDataColumn Header="quantidade" DataMemberBinding="{Binding quantidade, Converter={StaticResource ConverterNumber}}"/>
            </telerik:RadGridView.Columns>
        </telerik:RadGridView>

    </Grid>
    
</UserControl>
