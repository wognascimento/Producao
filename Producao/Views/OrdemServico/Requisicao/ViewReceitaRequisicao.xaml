<UserControl x:Class="Producao.Views.OrdemServico.Requisicao.ViewReceitaRequisicao"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vewModel="clr-namespace:Producao"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded">

    <UserControl.Resources>
        <vewModel:ConverterNumber x:Key="ConverterNumber"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="303"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Grid.ColumnSpan="3" Header="PRODUTO RECEITA">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="303"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="BUSCAR PRODUTO POR CÓDIGO"/>
                    <telerik:RadWatermarkTextBox x:Name="txtCodigoProduto" PreviewKeyDown="OnBuscaProdutoProduto"/>
                </StackPanel>

                <telerik:RadButton x:Name="btnBuscarProduto"
                                   Grid.Row="0"
                                   Grid.Column="2"
                                   Width="50"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Bottom"
                                   Content="..."
                                   Click="OnOpenDescricoesProduto"/>

                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" IsEnabled="False">
                    <TextBlock Text="PRODUTO"/>
                    <telerik:RadWatermarkTextBox x:Name="txtProdutoReceita"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="1" Grid.ColumnSpan="3" Header="RECEITA">
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="303"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="BUSCAR PRODUTO POR CÓDIGO"/>
                    <telerik:RadWatermarkTextBox x:Name="txtCodigoProdutoReceita" PreviewKeyDown="OnBuscaProduto"/>
                </StackPanel>

                <telerik:RadButton x:Name="btnBuscar"
                                   Grid.Row="0"
                                   Grid.Column="2"
                                   Width="50"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Bottom"
                                   Content="..."
                                   Click="OnOpenDescricoes"/>

                <StackPanel Grid.Row="1" Grid.Column="0">
                    <TextBlock Text="PLANILHA"/>
                    <telerik:RadComboBox x:Name="txtPlanilha"
                              IsEditable="True"
                              IsTextSearchEnabled="True"
                              ItemsSource="{Binding Planilhas}"
                              DisplayMemberPath="planilha"
                              SelectionChanged="OnSelectedPlanilha"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="2">
                    <TextBlock Text="DESCRIÇÃO"/>
                    <telerik:RadComboBox x:Name="txtDescricao"
                              IsEditable="True"
                              IsTextSearchEnabled="True"
                              ItemsSource="{Binding Produtos}"
                              DisplayMemberPath="descricao"
                              SelectionChanged="OnSelectedDescricao"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                    <TextBlock Text="DESCRIÇÃO ADICIONAL"/>
                    <telerik:RadComboBox x:Name="txtDescricaoAdicional"
                              IsEditable="True"
                              IsTextSearchEnabled="True"
                              ItemsSource="{Binding DescAdicionais}"
                              DisplayMemberPath="descricao_adicional"
                              SelectionChanged="OnSelectedDescricaoAdicional"/>
                </StackPanel>

                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3">
                    <TextBlock Text="COMPLEMENTO ADICIONAL"/>
                    <telerik:RadComboBox x:Name="txtComplementoAdicional"
                              IsEditable="True"
                              IsTextSearchEnabled="True"
                              ItemsSource="{Binding CompleAdicionais}"
                              DisplayMemberPath="complementoadicional"
                              SelectionChanged="OnSelectedComplementoAdicional"/>
                </StackPanel>

                <StackPanel Grid.Row="4" Grid.Column="0">
                    <TextBlock Text="QUANTIDADE"/>
                    <telerik:RadWatermarkTextBox x:Name="txtQuantidade"/>
                </StackPanel>

                <StackPanel Grid.Row="7" Grid.Column="0" Orientation="Horizontal">
                    <telerik:RadButton Margin="2" Content="Limpar" Click="OnLimparClick"/>
                    <telerik:RadButton Margin="2" Content="Gravar" Click="OnAdicionar_Click"/>
                </StackPanel>

                <telerik:RadGridView x:Name="dgModelos"
                                     Grid.Row="9"
                                     Grid.Column="0"
                                     Grid.ColumnSpan="3"
                                     AutoGenerateColumns="False"
                                     IsFilteringAllowed="True"
                                     CanUserResizeColumns="True"
                                     ShowGroupPanel="False"
                                     ItemsSource="{Binding Path=Itens}"
                                     MouseDoubleClick="dgModelos_MouseDoubleClick">
                    <telerik:RadGridView.Columns>
                        <telerik:GridViewDataColumn Header="id" DataMemberBinding="{Binding id}"/>
                        <telerik:GridViewDataColumn Header="planilha" DataMemberBinding="{Binding planilha}"/>
                        <telerik:GridViewDataColumn Header="descricao_completa" DataMemberBinding="{Binding descricao_completa}"/>
                        <telerik:GridViewDataColumn Header="unidade" DataMemberBinding="{Binding unidade}"/>
                        <telerik:GridViewDataColumn Header="quantidade" DataMemberBinding="{Binding quantidade, Converter={StaticResource ConverterNumber}}"/>
                        <telerik:GridViewDataColumn Header="inserido_por" DataMemberBinding="{Binding inserido_por}"/>
                        <telerik:GridViewDataColumn Header="inserido_em" DataMemberBinding="{Binding inserido_em, StringFormat={}{0:dd/MM/yyyy}}"/>
                        <telerik:GridViewDataColumn Header="codcompladicional_receita" DataMemberBinding="{Binding codcompladicional_receita}" IsVisible="False"/>
                    </telerik:RadGridView.Columns>
                </telerik:RadGridView>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
