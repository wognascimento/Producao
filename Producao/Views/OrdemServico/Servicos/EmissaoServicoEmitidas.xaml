<UserControl x:Class="Producao.Views.OrdemServico.Servicos.EmissaoServicoEmitidas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Producao.Views.OrdemServico.Servicos" 
             xmlns:vewModel="clr-namespace:Producao"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Initialized="UserControl_Initialized" Unloaded="UserControl_Unloaded">

    <UserControl.Resources>
        <vewModel:ConverterNumber x:Key="ConverterNumber"/>
        <vewModel:ConverterBoolen x:Key="ConverterBoolen"/>
    </UserControl.Resources>

    <Grid>

        <telerik:RadGridView
            x:Name="itens" 
            Grid.Row="10"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            AutoGenerateColumns="False" 
            CanUserResizeColumns="True"
            CanUserReorderColumns="True"
            IsFilteringAllowed="True"
            ShowGroupPanel="False"
            GroupRenderMode="Flat"
            SelectionMode="Extended"
            ItemsSource="{Binding OrdemServicos}"
            SelectedItem="{Binding OrdemServico, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
            RowEditEnded="itens_RowEditEnded">


            <telerik:RadGridView.ContextMenu>
                <ContextMenu Style="{x:Null}">

                    <MenuItem Command="{Binding Source={x:Static Member=local:ContextMenuCommandsEmissaoServicoEmitidas.CancelarOS}}"
                          CommandParameter="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          Header="Imprimir"/>

                </ContextMenu>
            </telerik:RadGridView.ContextMenu>

            <telerik:RadGridView.Columns>
                <telerik:GridViewDataColumn Header="num_os" DataMemberBinding="{Binding num_os, Converter={StaticResource ConverterNumber}}" IsReadOnly="True"/>
                <telerik:GridViewDataColumn Header="tipo" DataMemberBinding="{Binding tipo}" IsReadOnly="True"/>
                <telerik:GridViewDataColumn Header="descricao_setor" DataMemberBinding="{Binding descricao_setor}" IsReadOnly="True"/>
                <telerik:GridViewDataColumn Header="descricao_servico" DataMemberBinding="{Binding descricao_servico}" IsReadOnly="True"/>
                <telerik:GridViewDataColumn Header="planilha" DataMemberBinding="{Binding planilha}" IsReadOnly="True"/>
                <telerik:GridViewDataColumn Header="orientacao" DataMemberBinding="{Binding orientacao}" IsReadOnly="True"/>
                <telerik:GridViewDataColumn Header="quantidade" DataMemberBinding="{Binding quantidade, Converter={StaticResource ConverterNumber}}" IsReadOnly="True"/>
                <telerik:GridViewDataColumn Header="data_emissao" DataMemberBinding="{Binding data_emissao, StringFormat={}{0:dd/MM/yyyy}}" IsReadOnly="True"/>
                <telerik:GridViewDataColumn Header="data_conclusao" DataMemberBinding="{Binding data_conclusao, StringFormat={}{0:dd/MM/yyyy}}" IsReadOnly="True"/>
                <telerik:GridViewDataColumn Header="cliente" DataMemberBinding="{Binding cliente}" IsReadOnly="True"/>
                <telerik:GridViewCheckBoxColumn Header="cancelar" DataMemberBinding="{Binding cancelar, Converter={StaticResource ConverterBoolen}}"/>
                <telerik:GridViewDataColumn Header="emitido_por" DataMemberBinding="{Binding emitido_por}" IsReadOnly="True"/>
                <telerik:GridViewDataColumn Header="emitido_por_data" DataMemberBinding="{Binding emitido_por_data, StringFormat={}{0:dd/MM/yyyy}}" IsReadOnly="True"/>
            </telerik:RadGridView.Columns>
        </telerik:RadGridView>

    </Grid>
    
</UserControl>
