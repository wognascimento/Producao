<UserControl x:Class="Producao.Views.OrdemServico.Servicos.BaixaOrdemServico"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Producao.Views.OrdemServico.Servicos"
             xmlns:app="clr-namespace:Producao"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Loaded="UserControl_Loaded" 
             Unloaded="UserControl_Unloaded">


    <UserControl.Resources>
        <app:ConverterNumber x:Key="ConverterNumber"/>
        <app:ConverterBoolen x:Key="ConverterBoolen"/>
    </UserControl.Resources>


    <Grid>

        <telerik:RadGridView
            AutoGenerateColumns="False"
            IsFilteringAllowed="True"
            ShowGroupPanel="False"
            GroupRenderMode="Flat"
            ItemsSource="{Binding Itens}"
            CanUserResizeColumns="True"
            RowEditEnded="RadGridView_RowEditEnded" >

            <telerik:RadGridView.ContextMenu>
                <ContextMenu Style="{x:Null}">

                    <MenuItem Command="{Binding Source={x:Static Member=local:ContextMenuCommandsBaixaOrdemServico.CancelarOS}}"
                          CommandParameter="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          Header="Cancelar"/>

                </ContextMenu>
            </telerik:RadGridView.ContextMenu>

            <telerik:RadGridView.Columns>
                <telerik:GridViewDataColumn Header="num_os" DataMemberBinding="{Binding num_os, Converter={StaticResource ConverterNumber}}" IsReadOnly="True"/>
                <telerik:GridViewDataColumn Header="data_conclusao" DataMemberBinding="{Binding data_conclusao, StringFormat={}{0:dd/MM/yyyy}}"/>
                <telerik:GridViewDataColumn Header="data_conclusao_efetiva" DataMemberBinding="{Binding data_conclusao_efetiva, StringFormat={}{0:dd/MM/yyyy}}"/>
                <telerik:GridViewDataColumn Header="situacao" DataMemberBinding="{Binding situacao}" IsReadOnly="True"/>
            </telerik:RadGridView.Columns>
        </telerik:RadGridView>

    </Grid>

</UserControl>
