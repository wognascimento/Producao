<UserControl x:Class="Producao.Views.OrdemServico.Servicos.EmissaoServico"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             mc:Ignorable="d"
             d:DesignHeight="400"
             d:DesignWidth="800"
             Loaded="OnLoaded"
             Unloaded="UserControl_Unloaded">

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,6">
            <TextBlock Text="TIPO DA O.S." Margin="0,0,2,2"/>
            <telerik:RadComboBox x:Name="txtTipo"
                      IsEditable="True"
                      IsTextSearchEnabled="True"
                      ItemsSource="{Binding Tipos}"
                      SelectedItem="{Binding Tipo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      Text="{Binding OrdemServico.tipo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,2,2" IsFilteringEnabled="True" OpenDropDownOnFocus="True" StaysOpenOnEdit="True" CanAutocompleteSelectItems="False" CanKeyboardNavigationSelectItems="False" UpdateSelectionOnLostFocus="False" UpdateTextOnLostFocus="False"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,6">
            <TextBlock Text="SERVIÇO" Margin="0,0,2,2"/>
            <telerik:RadWatermarkTextBox x:Name="txtServico"
                     Text="{Binding OrdemServico.descricao_servico, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,2,2"/>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="SETOR" Margin="0,0,2,2"/>
                <telerik:RadComboBox x:Name="txtSetor"
                          IsEditable="True"
                          IsTextSearchEnabled="True"
                          ItemsSource="{Binding Setores}"
                          DisplayMemberPath="setor"
                          SelectedItem="{Binding Setor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Text="{Binding OrdemServico.descricao_setor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,2,2" IsFilteringEnabled="True" OpenDropDownOnFocus="True" StaysOpenOnEdit="True" CanAutocompleteSelectItems="False" CanKeyboardNavigationSelectItems="False" UpdateSelectionOnLostFocus="False" UpdateTextOnLostFocus="False"/>
            </StackPanel>

            <CheckBox Grid.Column="1"
                      Margin="0,0,2,2"
                      VerticalAlignment="Top"
                      Content="PERMISSÃO DE TRABALHO"
                      IsChecked="{Binding Path=OrdemServico.pt, Mode=TwoWay}"/>
        </Grid>

        <StackPanel Grid.Row="3" Margin="0,0,0,6">
            <TextBlock Text="PLANILHA" Margin="0,0,2,2"/>
            <telerik:RadComboBox x:Name="txtPlanilha"
                      IsEditable="True"
                      IsTextSearchEnabled="True"
                      ItemsSource="{Binding Planilhas}"
                      DisplayMemberPath="planilha"
                      SelectedItem="{Binding Planilha, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      Text="{Binding OrdemServico.planilha, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,2,2" IsFilteringEnabled="True" OpenDropDownOnFocus="True" StaysOpenOnEdit="True" CanAutocompleteSelectItems="False" CanKeyboardNavigationSelectItems="False" UpdateSelectionOnLostFocus="False" UpdateTextOnLostFocus="False"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,0,0,6">
            <TextBlock Text="ORIENTAÇÃO" Margin="0,0,2,2"/>
            <telerik:RadWatermarkTextBox x:Name="txtOrientacao"
                     Text="{Binding OrdemServico.orientacao, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     VerticalScrollBarVisibility="Visible"
                     MaxLength="250"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     MinHeight="70" Margin="0,0,2,2"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Margin="0,0,0,6">
            <TextBlock Text="QUANTIDADE" Margin="0,0,2,2"/>
            <telerik:RadWatermarkTextBox x:Name="txtQuantidade"
                     Text="{Binding OrdemServico.quantidade, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,2,2"/>
        </StackPanel>

        <Grid Grid.Row="6" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                <TextBlock Text="DATA EMISSÃO" Margin="0,0,2,2"/>
                <telerik:RadDatePicker SelectedDate="{Binding OrdemServico.data_emissao, Mode=TwoWay}" Margin="0,0,2,2"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="0,0,5,0">
                <TextBlock Text="DATA CONCLUSÃO" Margin="0,0,2,2"/>
                <telerik:RadDatePicker SelectedDate="{Binding OrdemServico.data_conclusao, Mode=TwoWay}" Margin="0,0,2,2"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="7" Margin="0,0,0,6">
            <TextBlock Text="CLIENTE" Margin="0,0,2,2"/>
            <telerik:RadComboBox x:Name="txtcliente"
                      IsEditable="True"
                      IsTextSearchEnabled="True"
                      ItemsSource="{Binding Siglas}"
                      DisplayMemberPath="sigla_serv"
                      SelectedItem="{Binding Sigla, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      Text="{Binding OrdemServico.cliente, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,2,2" IsFilteringEnabled="True" OpenDropDownOnFocus="True" StaysOpenOnEdit="True" CanAutocompleteSelectItems="False" CanKeyboardNavigationSelectItems="False" UpdateSelectionOnLostFocus="False" UpdateTextOnLostFocus="False"/>
        </StackPanel>

        <StackPanel Grid.Row="8" Orientation="Horizontal">
            <telerik:RadButton Margin="0,0,2,2"
                               Padding="10,6"
                               Content="ADICIONAR"
                               Click="OnAdicionarClick"/>
            <telerik:RadButton Margin="0,0,2,2"
                               Padding="10,6"
                               Content="IMPRIMIR"
                               Click="OnPrintClick"/>
        </StackPanel>
    </Grid>
</UserControl>
