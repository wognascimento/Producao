<UserControl x:Class="Producao.Views.CadastroProduto.ViewProdutoShopping"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:local="clr-namespace:Producao.Views.CadastroProduto"
             xmlns:vewModel="clr-namespace:Producao"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800"
             Loaded="UserControl_Loaded"
             Language="pt-BR">

    <UserControl.Resources>
        <vewModel:ConverterNumber x:Key="ConverterNumber"/>
        <vewModel:ConverterBoolen x:Key="ConverterBoolen"/>
    </UserControl.Resources>

    <Grid>
        <telerik:RadGridView
            AutoGenerateColumns="False"
            IsFilteringAllowed="True"
            ShowGroupPanel="False"
            GroupRenderMode="Flat"
            ItemsSource="{Binding Produtos}"
            SelectedItem="{Binding Produto, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            FontSize="10"
            RowValidated="OnRowValidated"
            SelectionUnit="FullRow"
            SelectionMode="Extended">
            <telerik:RadGridView.Columns>
                <telerik:GridViewDataColumn Header="data_de_expedicao" UniqueName="primeirodedata_de_expedicao" DataMemberBinding="{Binding primeirodedata_de_expedicao, StringFormat={}{0:dd/MM/yyyy}}"/>
                <telerik:GridViewDataColumn Header="codcompladicional" UniqueName="codcompladicional" DataMemberBinding="{Binding codcompladicional, Converter={StaticResource ConverterNumber}}"/>
                <telerik:GridViewDataColumn Header="planilha" UniqueName="planilha" DataMemberBinding="{Binding planilha}" IsReadOnly="True"/>
                <telerik:GridViewDataColumn Header="descricao_completa" UniqueName="descricao_completa" DataMemberBinding="{Binding descricao_completa}" IsReadOnly="True"/>
                <telerik:GridViewDataColumn Header="unidade" UniqueName="unidade" DataMemberBinding="{Binding unidade}" IsReadOnly="True"/>
                <telerik:GridViewDataColumn Header="ncm" UniqueName="ncm" DataMemberBinding="{Binding ncm}"/>
                <telerik:GridViewDataColumn Header="peso" UniqueName="peso" DataMemberBinding="{Binding peso, Converter={StaticResource ConverterNumber}}"/>
                <telerik:GridViewDataColumn Header="custo" UniqueName="custo" DataMemberBinding="{Binding custo, Converter={StaticResource ConverterNumber}}"/>
            </telerik:RadGridView.Columns>
        </telerik:RadGridView>
    </Grid>
</UserControl>
