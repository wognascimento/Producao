<UserControl x:Class="Producao.Views.CadastroProduto.CustoProduto"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:local="clr-namespace:Producao.Views.CadastroProduto"
             xmlns:app="clr-namespace:Producao"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800"
             Loaded="UserControl_Loaded"
             Language="pt-BR">

    <UserControl.Resources>
        <app:ConverterNumber x:Key="ConverterNumber"/>
        <app:ConverterBoolen x:Key="ConverterBoolen"/>
    </UserControl.Resources>

    <Grid>
        <telerik:RadGridView
            Name="itens"
            ItemsSource="{Binding Produtos}"
            IsFilteringAllowed="True"
            AutoGenerateColumns="False"
            ShowGroupPanel="False"
            GroupRenderMode="Flat"
            SelectionUnit="FullRow"
            SelectionMode="Extended"
            RowValidated="itens_RowValidated">
            <telerik:RadGridView.Columns>
                <telerik:GridViewDataColumn Header="codcompladicional" UniqueName="codcompladicional" DataMemberBinding="{Binding codcompladicional}" IsReadOnly="True"/>
                <telerik:GridViewDataColumn Header="planilha" UniqueName="planilha" DataMemberBinding="{Binding planilha}" IsReadOnly="True"/>
                <telerik:GridViewDataColumn Header="descricao" UniqueName="descricao" DataMemberBinding="{Binding descricao}" IsReadOnly="True"/>
                <telerik:GridViewDataColumn Header="descricao_adicional" UniqueName="descricao_adicional" DataMemberBinding="{Binding descricao_adicional}" IsReadOnly="True"/>
                <telerik:GridViewDataColumn Header="complementoadicional" UniqueName="complementoadicional" DataMemberBinding="{Binding complementoadicional}" IsReadOnly="True"/>
                <telerik:GridViewDataColumn Header="unidade" UniqueName="unidade" DataMemberBinding="{Binding unidade}" IsReadOnly="True"/>
                <telerik:GridViewDataColumn Header="vida_util" UniqueName="vida_util" DataMemberBinding="{Binding vida_util}" IsReadOnly="True"/>
                <telerik:GridViewCheckBoxColumn Header="prodcontrolado" UniqueName="prodcontrolado" DataMemberBinding="{Binding prodcontrolado, Converter={StaticResource ConverterBoolen}}" IsReadOnly="True"/>
                <telerik:GridViewCheckBoxColumn Header="inativo" UniqueName="inativo" DataMemberBinding="{Binding inativo, Converter={StaticResource ConverterBoolen}}" IsReadOnly="True"/>
                <telerik:GridViewDataColumn Header="tipocusto" UniqueName="tipocusto" DataMemberBinding="{Binding tipocusto}"/>
                <telerik:GridViewDataColumn Header="custo_retrasado" UniqueName="custo_retrasado" DataMemberBinding="{Binding custo_retrasado}" IsReadOnly="True" DataFormatString="{}{0:N2}"/>
                <telerik:GridViewDataColumn Header="custo_anterior" UniqueName="custo_anterior" DataMemberBinding="{Binding custo_anterior}" IsReadOnly="True" DataFormatString="{}{0:N2}"/>
                <telerik:GridViewDataColumn Header="custo_atual" UniqueName="custo_atual" DataMemberBinding="{Binding custo_atual}" DataFormatString="{}{0:N2}"/>
                <telerik:GridViewDataColumn Header="process_retrasado" UniqueName="process_retrasado" DataMemberBinding="{Binding process_retrasado}" IsReadOnly="True" DataFormatString="{}{0:N2}"/>
                <telerik:GridViewDataColumn Header="process_anterior" UniqueName="process_anterior" DataMemberBinding="{Binding process_anterior}" IsReadOnly="True" DataFormatString="{}{0:N2}"/>
                <telerik:GridViewDataColumn Header="process_atual" UniqueName="process_atual" DataMemberBinding="{Binding process_atual}" DataFormatString="{}{0:N2}"/>
                <telerik:GridViewDataColumn Header="custo_rec_retrasado" UniqueName="custo_rec_retrasado" DataMemberBinding="{Binding custo_rec_retrasado}" IsReadOnly="True" DataFormatString="{}{0:N2}"/>
                <telerik:GridViewDataColumn Header="custo_rec_anterior" UniqueName="custo_rec_anterior" DataMemberBinding="{Binding custo_rec_anterior}" IsReadOnly="True" DataFormatString="{}{0:N2}"/>
                <telerik:GridViewDataColumn Header="custo_rec_atual" UniqueName="custo_rec_atual" DataMemberBinding="{Binding custo_rec_atual}" DataFormatString="{}{0:N2}"/>
                <telerik:GridViewDataColumn Header="media_pn_pro1_v" UniqueName="media_pn_pro1_v" DataMemberBinding="{Binding media_pn_pro1_v}" IsReadOnly="True"/>
                <telerik:GridViewDataColumn Header="media_pn_pro2_v" UniqueName="media_pn_pro2_v" DataMemberBinding="{Binding media_pn_pro2_v}" IsReadOnly="True"/>
                <telerik:GridViewDataColumn Header="media_rc_pro2_v" UniqueName="media_rc_pro2_v" DataMemberBinding="{Binding media_rc_pro2_v}" IsReadOnly="True"/>
                <telerik:GridViewDataColumn Header="media_pro3_v" UniqueName="media_pro3_v" DataMemberBinding="{Binding media_pro3_v}" IsReadOnly="True"/>
                <telerik:GridViewDataColumn Header="media_total_process" UniqueName="media_total_process" DataMemberBinding="{Binding media_total_process}" IsReadOnly="True"/>
            </telerik:RadGridView.Columns>
        </telerik:RadGridView>
    </Grid>
</UserControl>
