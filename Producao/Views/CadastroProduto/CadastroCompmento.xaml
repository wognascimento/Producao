<Window x:Class="Producao.Views.CadastroProduto.CadastroCompmento"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vewModel="clr-namespace:Producao"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        mc:Ignorable="d"
        d:DesignHeight="450"
        d:DesignWidth="600"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        Loaded="OnLoaded"
        Title="Complemento Adicional">

    <Window.Resources>
        <vewModel:ConverterBoolen x:Key="ConverterBoolen"/>
    </Window.Resources>

    <Grid>
        <telerik:RadGridView
            x:Name="adicionais"
            AutoGenerateColumns="False"
            CanUserInsertRows="True"
            NewRowPosition="Bottom"
            GroupRenderMode="Flat"
            ShowGroupPanel="False"
            IsFilteringAllowed="True"
            ItemsSource="{Binding ComplementoAdicionais}"
            SelectedItem="{Binding ComplementoAdicional, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            FontSize="10"
            RowValidated="OnRowValidated"
            RowValidating="OnRowValidating"
            AddingNewDataItem="OnAddingNewDataItem">
            <telerik:RadGridView.Columns>
                <telerik:GridViewDataColumn
                    Header="CÓDIGO"
                    DataMemberBinding="{Binding codcompladicional}"
                    IsReadOnly="True" />
                <telerik:GridViewDataColumn
                    Header="COMPLEMENTO ADICIONAL"
                    DataMemberBinding="{Binding complementoadicional}" />
                <telerik:GridViewDataColumn
                    Header="DESCRIÇÃO FISCAL"
                    DataMemberBinding="{Binding descricaofiscal}" />
                <telerik:GridViewComboBoxColumn
                    Header="UNIDADE"
                    DataMemberBinding="{Binding unidade}"
                    ItemsSource="{Binding DataContext.Unidades, RelativeSource={RelativeSource AncestorType=telerik:RadGridView}}"
                    DisplayMemberPath="unidade"
                    SelectedValueMemberPath="unidade" />
                <telerik:GridViewDataColumn
                    Header="PREÇO"
                    DataMemberBinding="{Binding precolocacao, StringFormat=N2}" />
                <telerik:GridViewDataColumn
                    Header="VIDA ÚTIL"
                    DataMemberBinding="{Binding vida_util}" />
                <telerik:GridViewDataColumn
                    Header="INATIVO"
                    UniqueName="inativo">
                    <telerik:GridViewDataColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox
                                HorizontalAlignment="Center"
                                IsChecked="{Binding inativo, Converter={StaticResource ConverterBoolen}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Checked="OnInativoClick"
                                Unchecked="OnInativoClick"/>
                        </DataTemplate>
                    </telerik:GridViewDataColumn.CellTemplate>
                </telerik:GridViewDataColumn>
                <telerik:GridViewCheckBoxColumn
                    Header="CONTROLADO"
                    DataMemberBinding="{Binding prodcontrolado, Converter={StaticResource ConverterBoolen}, Mode=TwoWay}" />
            </telerik:RadGridView.Columns>
        </telerik:RadGridView>
    </Grid>
</Window>
