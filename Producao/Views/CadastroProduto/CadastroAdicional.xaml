<Window x:Class="Producao.Views.CadastroProduto.CadastroAdicional"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        mc:Ignorable="d"
        d:DesignHeight="450"
        d:DesignWidth="600"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        Loaded="OnLoaded"
        Title="Descrição Adicional">

    <Grid>
        <telerik:RadGridView
            x:Name="adicionais"
            AutoGenerateColumns="False"
            CanUserInsertRows="True"
            NewRowPosition="Bottom"
            GroupRenderMode="Flat"
            ShowGroupPanel="False"
            IsFilteringAllowed="True"
            ItemsSource="{Binding ProdutosAdicionais}"
            SelectedItem="{Binding ProdutoAdicional, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            FontSize="10"
            RowValidated="OnRowValidated"
            RowValidating="OnRowValidating"
            AddingNewDataItem="OnAddingNewDataItem">
            <telerik:RadGridView.Columns>
                <telerik:GridViewDataColumn
                    Header="CÓDIGO"
                    DataMemberBinding="{Binding coduniadicional}"
                    IsReadOnly="True" />
                <telerik:GridViewDataColumn
                    Header="DESCRIÇÃO ADICIONAL"
                    DataMemberBinding="{Binding descricao_adicional}" />
                <telerik:GridViewDataColumn
                    Header="REVISÃO"
                    DataMemberBinding="{Binding revisao}" />
                <telerik:GridViewCheckBoxColumn
                    Header="INATIVO"
                    DataMemberBinding="{Binding inativo}" />
                <telerik:GridViewColumn Header="">
                    <telerik:GridViewColumn.CellTemplate>
                        <DataTemplate>
                            <telerik:RadButton
                                Content="Complemento"
                                Click="OnComplementoClick"
                                Margin="0,0,2,2"/>
                        </DataTemplate>
                    </telerik:GridViewColumn.CellTemplate>
                </telerik:GridViewColumn>
            </telerik:RadGridView.Columns>
        </telerik:RadGridView>
    </Grid>
</Window>
