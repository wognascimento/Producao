<UserControl x:Class="Producao.Views.CadastroProduto.ViewCadastroProduto"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:local="clr-namespace:Producao.Views.CadastroProduto"
             mc:Ignorable="d" 
             xmlns:vewModel="clr-namespace:Producao"
             d:DesignHeight="450" d:DesignWidth="800" Loaded="OnLoaded" Unloaded="UserControl_Unloaded"
             Language="pt-BR">

    <UserControl.Resources>
        <vewModel:ConverterNumber x:Key="ConverterNumber"/>
        <vewModel:ConverterBoolen x:Key="ConverterBoolen"/>
        <!--<local:NameButtonConverter x:Key="NameButtonConverter" />-->
    </UserControl.Resources>
    
    <Grid>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <StackPanel Margin="5">
            <TextBlock Margin="0,0,2,2" Text="PLANILHA"/>
            <telerik:RadComboBox
                x:Name="cbPlanilha"
                IsEditable="True"
                IsFilteringEnabled="True"
                OpenDropDownOnFocus="True"
                StaysOpenOnEdit="True"
                ItemsSource="{Binding Planilhas}"
                DisplayMemberPath="planilha"
                SelectedValuePath="planilha"
                SelectedItem="{Binding Planilha, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                SelectionChanged="OnPlanilhaSelectionChanged" Margin="0,0,2,2" IsTextSearchEnabled="True" CanAutocompleteSelectItems="False" CanKeyboardNavigationSelectItems="False" UpdateSelectionOnLostFocus="False" UpdateTextOnLostFocus="False"/>
        </StackPanel>


        <telerik:RadGridView
            x:Name="produtos"
            Grid.Row="1"
            NewRowPosition="Bottom"
            CanUserInsertRows="True"
            AutoGenerateColumns="False"
            ShowGroupPanel="False"
            GroupRenderMode="Flat"
            ItemsSource="{Binding Produtos}"
            SelectedItem="{Binding Produto, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            FontSize="10" 
            RowValidated="OnRowValidated" 
            RowValidating="OnRowValidating" 
            AddingNewDataItem="OnAddingNewDataItem"
            IsFilteringAllowed="True">
            <telerik:RadGridView.Columns>
                <telerik:GridViewDataColumn
                        Header="CÓDIGO"
                        UniqueName="codigo"
                        IsReadOnly="True"
                        DataMemberBinding="{Binding codigo, Converter={StaticResource ConverterNumber}}"/>
                <telerik:GridViewComboBoxColumn
                        Header="CLASSE COMPRA"
                        UniqueName="classe_solict_compra"
                        DataMemberBinding="{Binding classe_solict_compra}"
                        ItemsSource="{Binding ClasseSolicitCompras}"
                        DisplayMemberPath="classe_solicit_compra"
                        SelectedValueMemberPath="classe_solicit_compra"/>

                <telerik:GridViewComboBoxColumn
                        Header="FAMILIA COMPRAS"
                        UniqueName="familia"
                        DataMemberBinding="{Binding familia}"
                        ItemsSource="{Binding FamiliaProds}"
                        DisplayMemberPath="nomefamilia"
                        SelectedValueMemberPath="nomefamilia"/>

                <telerik:GridViewDataColumn
                        Header="DESCRIÇÃO"
                        UniqueName="descricao"
                        DataMemberBinding="{Binding descricao}"/>
                <telerik:GridViewCheckBoxColumn
                        Header="INATIVO"
                        UniqueName="inativo"
                        DataMemberBinding="{Binding inativo, Converter={StaticResource ConverterBoolen}}"/>
                <telerik:GridViewDataColumn
                        Header=""
                        UniqueName="adicional">
                    <telerik:GridViewDataColumn.CellTemplate>
                        <DataTemplate>
                            <telerik:RadButton 
                                    Content="Adicional" 
                                    Command="{Binding DataContext.RowDataCommand, RelativeSource={RelativeSource AncestorType={x:Type telerik:RadGridView}}}" 
                                    CommandParameter="{Binding}" Margin="0,0,2,2"/>
                        </DataTemplate>
                    </telerik:GridViewDataColumn.CellTemplate>
                </telerik:GridViewDataColumn>
            </telerik:RadGridView.Columns>
        </telerik:RadGridView>

    </Grid>
    
</UserControl>
