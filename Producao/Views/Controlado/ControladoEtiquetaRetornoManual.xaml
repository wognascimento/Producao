<UserControl x:Class="Producao.Views.Controlado.ControladoEtiquetaRetornoManual"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Producao.Views.Controlado" 
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:app="clr-namespace:Producao"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <app:ConverterNumber x:Key="ConverterNumber"/>
        <app:ConverterBoolen x:Key="ConverterBoolen"/>
    </UserControl.Resources>

    <Grid>


        <telerik:RadGridView 
            x:Name="retornos"
            Grid.Row="1"
            AutoGenerateColumns="False" 
            CanUserResizeColumns="True"
            ShowGroupPanel="False"
            ItemsSource="{Binding Retornos}" 
            SelectedItem="{Binding Retorno, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            RowValidated="OnRowValidated" 
            RowValidating="OnRowValidating" 
            IsFilteringAllowed="True" 
            CanUserInsertRows="True"
            GroupRenderMode="Flat"
            NewRowPosition="Bottom">
            <telerik:RadGridView.Columns>

                <telerik:GridViewDataColumn Header="codigo" DataMemberBinding="{Binding codigo, Converter={StaticResource ConverterNumber}}"/>

                <telerik:GridViewDataColumn Header="planilha" DataMemberBinding="{Binding planilha}" IsReadOnly="True"/>

                <telerik:GridViewDataColumn Header="descricao_completa" DataMemberBinding="{Binding descricao_completa}" IsReadOnly="True"/>

            </telerik:RadGridView.Columns>
        </telerik:RadGridView>


    </Grid>
    
</UserControl>
