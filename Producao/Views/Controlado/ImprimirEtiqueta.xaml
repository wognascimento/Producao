<UserControl
             x:Class="Producao.Views.Controlado.ImprimirEtiqueta"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Producao.Views.Controlado"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation" 
             mc:Ignorable="d" 
             xmlns:app="clr-namespace:Producao"
             d:DesignHeight="450" d:DesignWidth="800" Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <app:ConverterNumber x:Key="ConverterNumber"/>
        <app:ConverterBoolen x:Key="ConverterBoolen"/>
    </UserControl.Resources>

    
    <Grid>

        <telerik:RadGridView 
            x:Name="ProdutosGrid"
            AutoGenerateColumns="False" 
            CanUserResizeColumns="True"
            CanUserReorderColumns="True"
            IsFilteringAllowed="True"
            ShowGroupPanel="False"
            ItemsSource="{Binding Produtos}"
            SelectedItem="{Binding Produto, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">

            <telerik:RadGridView.ContextMenu>
                <ContextMenu Style="{x:Null}">

                    <MenuItem Click="OnImprimirEtiquetaClick"
                              Header="Imprimir"/>

                    <MenuItem Click="OnAdicionarEtiquetaClick"
                              Header="Adicionar" />

                    <MenuItem Click="OnRemoverEtiquetaClick"
                              Header="Remover Não Impressa" />

                    <MenuItem Click="OnImpressasEtiquetaClick"
                              Header="Impressas" />
                </ContextMenu>
            </telerik:RadGridView.ContextMenu>
            
            <telerik:RadGridView.Columns>
                <telerik:GridViewDataColumn Header="codcompladicional" DataMemberBinding="{Binding codcompladicional, Converter={StaticResource ConverterNumber}}"/>
                <telerik:GridViewDataColumn Header="planilha" DataMemberBinding="{Binding planilha}"/>
                <telerik:GridViewDataColumn Header="desc_completa" DataMemberBinding="{Binding desc_completa}"/>
                <telerik:GridViewDataColumn Header="unidade" DataMemberBinding="{Binding unidade}"/>
                <telerik:GridViewDataColumn Header="saldo_estoque" DataMemberBinding="{Binding saldo_estoque, Converter={StaticResource ConverterNumber}}"/>
                <telerik:GridViewDataColumn Header="etiquetas" DataMemberBinding="{Binding etiquetas, Converter={StaticResource ConverterNumber}}"/>
                <telerik:GridViewDataColumn Header="impressas" DataMemberBinding="{Binding impressas, Converter={StaticResource ConverterNumber}}"/>
            </telerik:RadGridView.Columns>
        </telerik:RadGridView>

    </Grid>
</UserControl>
