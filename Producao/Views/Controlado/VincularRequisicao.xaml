<UserControl
             x:Class="Producao.Views.Controlado.VincularRequisicao"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:app="clr-namespace:Producao"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <app:ConverterNumber x:Key="ConverterNumber"/>
        <app:ConverterBoolen x:Key="ConverterBoolen"/>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Margin="10,0,10,0" Text="Número Requisição"/>
        <telerik:RadWatermarkTextBox
            x:Name="txtRequisicao"
            WatermarkContent="Número Requisição"
            PreviewKeyDown="OnBuscaProdutos"
            Margin="10,0,10,8"
            Width="150"
            HorizontalAlignment="Left"/>

        <TextBlock Margin="10,0,10,0" Text="Código da etiqueta"/>
        <telerik:RadWatermarkTextBox
            x:Name="codigoProduto"
            WatermarkContent="Código da etiqueta"
            PreviewKeyDown="OnAdicionarProduto"
            Margin="10,0,10,8"
            Width="150"
            HorizontalAlignment="Left"/>

        <telerik:RadGridView
            x:Name="ProdutosGrid"
            Height="300"
            Margin="10"
            AutoGenerateColumns="False"
            CanUserResizeColumns="True"
            CanUserReorderColumns="True"
            ShowGroupPanel="False"
            IsFilteringAllowed="True"
            ItemsSource="{Binding Produtos}"
            SelectedItem="{Binding Produto, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">

            <telerik:RadGridView.ContextMenu>
                <ContextMenu Style="{x:Null}">
                    <MenuItem Header="Remover" Click="OnRemoverProdutoClick"/>
                </ContextMenu>
            </telerik:RadGridView.ContextMenu>

            <telerik:RadGridView.Columns>
                <telerik:GridViewDataColumn Header="codcompladicional" DataMemberBinding="{Binding codcompladicional, Converter={StaticResource ConverterNumber}}"/>
                <telerik:GridViewDataColumn Header="quantidade" DataMemberBinding="{Binding quantidade, Converter={StaticResource ConverterNumber}}"/>
                <telerik:GridViewDataColumn Header="planilha" DataMemberBinding="{Binding planilha}"/>
                <telerik:GridViewDataColumn Header="descricao_completa" DataMemberBinding="{Binding descricao_completa}"/>
            </telerik:RadGridView.Columns>
        </telerik:RadGridView>

        <telerik:RadButton
            Content="Baixar Requisição"
            Width="180"
            Height="30"
            Margin="10,0,0,0"
            HorizontalAlignment="Left"
            Click="OnBaixaRequisicaoClick"/>
    </StackPanel>
</UserControl>
