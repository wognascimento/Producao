<UserControl x:Class="Producao.Views.Controlado.ControladoRecebimento"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Producao.Views.Controlado" 
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             mc:Ignorable="d" 
             xmlns:app="clr-namespace:Producao"
             d:DesignHeight="450" d:DesignWidth="800" Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <app:ConverterNumber x:Key="ConverterNumber"/>
        <app:ConverterBoolen x:Key="ConverterBoolen"/>
    </UserControl.Resources>
    
    
    <Grid>

        <telerik:RadGridView 
            AutoGenerateColumns="False" 
            CanUserResizeColumns="True"
            CanUserReorderColumns="True"
            ShowGroupPanel="False"
            ItemsSource="{Binding Produtos}"
            SelectedItem="{Binding Produto, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
            IsFilteringAllowed="True" 
            RowValidated="RadGridView_RowValidated"
            SelectionMode="Extended"
            ClipboardCopyMode="Cells,Header"> 

            <telerik:RadGridView.Columns>

                <telerik:GridViewDataColumn IsReadOnly="True" Header="sigla" DataMemberBinding="{Binding sigla}"/>

                <telerik:GridViewDataColumn IsReadOnly="True" Header="codcompladicional" DataMemberBinding="{Binding codcompladicional, Converter={StaticResource ConverterNumber}}"/>

                <telerik:GridViewDataColumn IsReadOnly="True" Header="planilha" DataMemberBinding="{Binding planilha}"/>
                <telerik:GridViewDataColumn IsReadOnly="True" Header="descricao" DataMemberBinding="{Binding descricao}"/>
                <telerik:GridViewDataColumn IsReadOnly="True" Header="unidade" DataMemberBinding="{Binding unidade}"/>
                <telerik:GridViewDataColumn IsReadOnly="True" Header="expedido" DataMemberBinding="{Binding expedido, Converter={StaticResource ConverterNumber}}"/>
                <telerik:GridViewDataColumn IsReadOnly="True" Header="solucao_manutencao" DataMemberBinding="{Binding solucao_manutencao, Converter={StaticResource ConverterNumber}}"/>
                <telerik:GridViewDataColumn IsReadOnly="True" Header="qrcode" DataMemberBinding="{Binding qrcode, Converter={StaticResource ConverterNumber}}"/>
                <telerik:GridViewDataColumn IsReadOnly="True" Header="recebida" DataMemberBinding="{Binding recebida, Converter={StaticResource ConverterNumber}}"/>
                <telerik:GridViewDataColumn IsReadOnly="True" Header="devolvida" DataMemberBinding="{Binding devolvida, Converter={StaticResource ConverterNumber}}"/>
                <telerik:GridViewDataColumn Header="retorno" DataMemberBinding="{Binding retorno, Converter={StaticResource ConverterNumber}}"/>
                <telerik:GridViewDataColumn IsReadOnly="True" Header="cobranca" DataMemberBinding="{Binding cobranca, Converter={StaticResource ConverterNumber}}"/>
                <telerik:GridViewDataColumn IsReadOnly="True" Header="custo" DataMemberBinding="{Binding custo, StringFormat={}{0:C2}}"/>
                <telerik:GridViewDataColumn IsReadOnly="True" Header="custo_total" DataMemberBinding="{Binding custo_total, StringFormat={}{0:C2}}"/>
                <telerik:GridViewDataColumn Header="justificativa" DataMemberBinding="{Binding justificativa}"/>

            </telerik:RadGridView.Columns>

        </telerik:RadGridView>

    </Grid>
    
    
</UserControl>
