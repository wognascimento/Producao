<UserControl x:Class="Producao.Views.Construcao.EtiquetaConstrucao"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:local="clr-namespace:Producao.Views.Construcao"
             xmlns:app="clr-namespace:Producao"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800"
             Loaded="UserControl_Loaded"
             Language="pt-BR">

    <UserControl.Resources>
        <app:ConverterNumber x:Key="ConverterNumber"/>
        <app:ConverterBoolen x:Key="ConverterBoolen"/>
    </UserControl.Resources>

    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="303"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="165"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="5"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0">
            <TextBlock Text="PLANILHA" Margin="0,0,2,2"/>
            <telerik:RadComboBox x:Name="txtPlanilha"
                                 
                                 IsEditable="True"
                                 IsFilteringEnabled="True"
                                 OpenDropDownOnFocus="True"
                                 StaysOpenOnEdit="True"
                                 ItemsSource="{Binding Planilhas}"
                                 DisplayMemberPath="planilha"
                                 SelectedValuePath="planilha"
                                 SelectionChanged="OnSelectedPlanilha" Margin="0,0,2,2" IsTextSearchEnabled="True" CanAutocompleteSelectItems="False" CanKeyboardNavigationSelectItems="False" UpdateSelectionOnLostFocus="False" UpdateTextOnLostFocus="False"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="0">
            <TextBlock Text="DESCRIÇÃO" Margin="0,0,2,2"/>
            <telerik:RadComboBox x:Name="txtDescricao"
                                 
                                 IsEditable="True"
                                 IsFilteringEnabled="True"
                                 OpenDropDownOnFocus="True"
                                 StaysOpenOnEdit="True"
                                 ItemsSource="{Binding Produtos}"
                                 DisplayMemberPath="descricao"
                                 SelectedValuePath="codigo"
                                 SelectionChanged="OnSelectedDescricao" Margin="0,0,2,2" IsTextSearchEnabled="True" CanAutocompleteSelectItems="False" CanKeyboardNavigationSelectItems="False" UpdateSelectionOnLostFocus="False" UpdateTextOnLostFocus="False"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.Column="0">
            <TextBlock Text="DESCRIÇÃO ADICIONAL" Margin="0,0,2,2"/>
            <telerik:RadComboBox x:Name="txtDescricaoAdicional"
                                 
                                 IsEditable="True"
                                 IsFilteringEnabled="True"
                                 OpenDropDownOnFocus="True"
                                 StaysOpenOnEdit="True"
                                 ItemsSource="{Binding DescAdicionais}"
                                 DisplayMemberPath="descricao_adicional"
                                 SelectedValuePath="coduniadicional"
                                 SelectionChanged="OnSelectedDescricaoAdicional" Margin="0,0,2,2" IsTextSearchEnabled="True" CanAutocompleteSelectItems="False" CanKeyboardNavigationSelectItems="False" UpdateSelectionOnLostFocus="False" UpdateTextOnLostFocus="False"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Grid.Column="0">
            <TextBlock Text="COMPLEMENTO ADICIONAL" Margin="0,0,2,2"/>
            <telerik:RadComboBox x:Name="txtComplementoAdicional"
                                 
                                 IsEditable="True"
                                 IsFilteringEnabled="True"
                                 OpenDropDownOnFocus="True"
                                 StaysOpenOnEdit="True"
                                 ItemsSource="{Binding CompleAdicionais}"
                                 DisplayMemberPath="complementoadicional"
                                 SelectedValuePath="codcompladicional"
                                 SelectionChanged="OnSelectedComplementoAdicional" Margin="0,0,2,2" IsTextSearchEnabled="True" CanAutocompleteSelectItems="False" CanKeyboardNavigationSelectItems="False" UpdateSelectionOnLostFocus="False" UpdateTextOnLostFocus="False"/>
        </StackPanel>

        <Grid Grid.Row="0" Grid.RowSpan="4" Grid.Column="2" Width="160" HorizontalAlignment="Left">
            <GroupBox Header="Medidas">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="Largura (m)" Margin="0,0,2,2"/>
                        <telerik:RadWatermarkTextBox x:Name="txt_largura"  Margin="0,0,2,2"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock Text="Área (m²)" Margin="0,0,2,2"/>
                        <telerik:RadWatermarkTextBox x:Name="txt_area"  Margin="0,0,2,2"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0">
                        <TextBlock Text="Profundidade (m)" Margin="0,0,2,2"/>
                        <telerik:RadWatermarkTextBox x:Name="txt_profundidade"  Margin="0,0,2,2"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="2">
                        <TextBlock Text="Volume (m³)" Margin="0,0,2,2"/>
                        <telerik:RadWatermarkTextBox x:Name="txt_volume"  Margin="0,0,2,2"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0">
                        <TextBlock Text="Altura (m)" Margin="0,0,2,2"/>
                        <telerik:RadWatermarkTextBox x:Name="txt_altura"  Margin="0,0,2,2"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="2">
                        <TextBlock Text="Peso (kg)" Margin="0,0,2,2"/>
                        <telerik:RadWatermarkTextBox x:Name="txt_peso"  Margin="0,0,2,2"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3">
                        <TextBlock Text="Tamanho" Margin="0,0,2,2"/>
                        <telerik:RadComboBox x:Name="txt_tamanho"
                                             
                                             ItemsSource="{Binding Tamanhos}" Margin="0,0,2,2"/>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3">
                        <TextBlock Text="Dificuldade" Margin="0,0,2,2"/>
                        <telerik:RadComboBox x:Name="txt_dificuldade"
                                             
                                             ItemsSource="{Binding Dificuldades}" Margin="0,0,2,2"/>
                    </StackPanel>
                </Grid>
            </GroupBox>
        </Grid>

        <telerik:RadGridView x:Name="historicos"
                             Grid.Row="0"
                             Grid.Column="3"
                             Grid.RowSpan="4"
                             AutoGenerateColumns="False"
                             ShowGroupPanel="False"
                             GroupRenderMode="Flat"
                             ItemsSource="{Binding Historicos}"
                             IsReadOnly="True"
                             IsFilteringAllowed="True">
            <telerik:RadGridView.Columns>
                <telerik:GridViewDataColumn Header="Sigla" DataMemberBinding="{Binding sigla}" UniqueName="sigla"/>
                <telerik:GridViewDataColumn Header="Tema" DataMemberBinding="{Binding tema}" UniqueName="tema"/>
                <telerik:GridViewDataColumn Header="Ano" DataMemberBinding="{Binding ano, Converter={StaticResource ConverterNumber}}" UniqueName="ano"/>
            </telerik:RadGridView.Columns>
        </telerik:RadGridView>

        <Grid Grid.Row="5" Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>

            <telerik:RadButton Grid.Column="0" Content="ETIQUETA" Click="OnEtiquetaClick" Margin="0,0,2,2"/>
            <telerik:RadButton Grid.Column="2" Content="DESCRIÇÃO" Click="OnDescricaoClick" Margin="0,0,2,2"/>
            <telerik:RadButton Grid.Column="4" Content="TÉRMICA" Click="OnEtiquetaTermicaClick" Margin="0,0,2,2"/>
        </Grid>

        <telerik:RadGridView x:Name="itens"
                             Grid.Row="7"
                             Grid.Column="0"
                             Grid.ColumnSpan="4"
                             AutoGenerateColumns="False"
                             ItemsSource="{Binding Pecas}"
                             SelectionUnit="FullRow"
                             SelectionMode="Extended"
                             ShowGroupPanel="False"
                             GroupRenderMode="Flat"
                             CanUserInsertRows="True"
                             NewRowPosition="Top"
                             CanUserDeleteRows="True"
                             IsFilteringAllowed="True"
                             AddingNewDataItem="itens_AddingNewDataItem"
                             RowValidating="itens_RowValidating"
                             RowValidated="itens_RowValidated"
                             Deleting="itens_Deleting">
            <telerik:RadGridView.Columns>
                <telerik:GridViewDataColumn Header="Item"
                                            UniqueName="item"
                                            DataMemberBinding="{Binding item, Converter={StaticResource ConverterNumber}}"/>
                <telerik:GridViewDataColumn Header="Descrição Peça"
                                            UniqueName="descricao_peca"
                                            DataMemberBinding="{Binding descricao_peca}"/>
                <telerik:GridViewDataColumn Header="Volume Etiqueta"
                                            UniqueName="volume_etiqueta"
                                            DataMemberBinding="{Binding volume_etiqueta, Converter={StaticResource ConverterNumber}}"/>
                <telerik:GridViewDataColumn Header="Volume Expedição"
                                            UniqueName="volume_expedicao"
                                            DataMemberBinding="{Binding volume_expedicao, Converter={StaticResource ConverterNumber}}"/>
            </telerik:RadGridView.Columns>
        </telerik:RadGridView>
    </Grid>

</UserControl>
