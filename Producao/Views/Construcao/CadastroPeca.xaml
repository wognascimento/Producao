<UserControl x:Class="Producao.Views.Construcao.CadastroPeca"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:local="clr-namespace:Producao.Views.Construcao" 
             xmlns:app="clr-namespace:Producao"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Loaded="UserControl_Loaded"
             Language="pt-BR">

    <UserControl.Resources>
        <app:ConverterNumber x:Key="ConverterNumber"/>
        <app:ConverterBoolen x:Key="ConverterBoolen"/>
    </UserControl.Resources>


    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="303"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="5" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="5" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="2" Grid.Column="0">
            <TextBlock Margin="0,0,2,2" Text="PLANILHA"/>
            <telerik:RadComboBox
                x:Name="txtPlanilha"
                Margin="0,0,2,2"
                IsEditable="True"
                IsFilteringEnabled="True"
                OpenDropDownOnFocus="True"
                StaysOpenOnEdit="True"
                ItemsSource="{Binding Planilhas}"
                DisplayMemberPath="planilha"
                SelectedValuePath="planilha"
                SelectionChanged="OnSelectedPlanilha" IsTextSearchEnabled="True" CanAutocompleteSelectItems="False" CanKeyboardNavigationSelectItems="False" UpdateSelectionOnLostFocus="False" UpdateTextOnLostFocus="False"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.Column="2">
            <TextBlock Margin="0,0,2,2" Text="DESCRIÇÃO"/>
            <telerik:RadComboBox
                x:Name="txtDescricao"
                Margin="0,0,2,2"
                IsEditable="True"
                IsFilteringEnabled="True"
                OpenDropDownOnFocus="True"
                StaysOpenOnEdit="True"
                ItemsSource="{Binding Produtos}"
                DisplayMemberPath="descricao"
                SelectedValuePath="codigo"
                SelectionChanged="OnSelectedDescricao" IsTextSearchEnabled="True" CanAutocompleteSelectItems="False" CanKeyboardNavigationSelectItems="False" UpdateSelectionOnLostFocus="False" UpdateTextOnLostFocus="False"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3">
            <TextBlock Margin="0,0,2,2" Text="DESCRIÇÃO ADICIONAL"/>
            <telerik:RadComboBox
                x:Name="txtDescricaoAdicional"
                Margin="0,0,2,2"
                IsEditable="True"
                IsFilteringEnabled="True"
                OpenDropDownOnFocus="True"
                StaysOpenOnEdit="True"
                ItemsSource="{Binding DescAdicionais}"
                DisplayMemberPath="descricao_adicional"
                SelectedValuePath="coduniadicional"
                SelectionChanged="OnSelectedDescricaoAdicional" IsTextSearchEnabled="True" CanAutocompleteSelectItems="False" CanKeyboardNavigationSelectItems="False" UpdateSelectionOnLostFocus="False" UpdateTextOnLostFocus="False"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3">
            <TextBlock Margin="0,0,2,2" Text="COMPLEMENTO ADICIONAL"/>
            <telerik:RadComboBox
                x:Name="txtComplementoAdicional"
                Margin="0,0,2,2"
                IsEditable="True"
                IsFilteringEnabled="True"
                OpenDropDownOnFocus="True"
                StaysOpenOnEdit="True"
                ItemsSource="{Binding CompleAdicionais}"
                DisplayMemberPath="complementoadicional"
                SelectedValuePath="codcompladicional"
                SelectionChanged="OnSelectedComplementoAdicional" IsTextSearchEnabled="True" CanAutocompleteSelectItems="False" CanKeyboardNavigationSelectItems="False" UpdateSelectionOnLostFocus="False" UpdateTextOnLostFocus="False"/>
        </StackPanel>


        <telerik:RadGridView
            x:Name="itens" 
            Grid.Row="10"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            AutoGenerateColumns="False" 
            ItemsSource="{Binding Detalhes}" 
            ShowGroupPanel="False"
            GroupRenderMode="Flat"
            CanUserInsertRows="True"
            NewRowPosition="Top"
            CanUserDeleteRows="True"
            IsFilteringAllowed="True"
            AddingNewDataItem="itens_AddingNewDataItem"
            RowValidating="itens_RowValidating"
            RowValidated="itens_RowValidated"
            Deleting="itens_Deleting">
            <telerik:RadGridView.Columns>
                <telerik:GridViewDataColumn
                    UniqueName="item"
                    Header="Item"
                    DataMemberBinding="{Binding item, Converter={StaticResource ConverterNumber}}"/>
                <telerik:GridViewDataColumn
                    UniqueName="descricao_peca"
                    Header="Descrição Peça"
                    DataMemberBinding="{Binding descricao_peca}"/>
                <telerik:GridViewDataColumn
                    UniqueName="volume"
                    Header="Volume"
                    DataMemberBinding="{Binding volume, Converter={StaticResource ConverterNumber}}"/>
            </telerik:RadGridView.Columns>
        </telerik:RadGridView>

    </Grid>

</UserControl>
