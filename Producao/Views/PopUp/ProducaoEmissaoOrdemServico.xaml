<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Producao.Views.PopUp"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        x:Class="Producao.Views.PopUp.ProducaoEmissaoOrdemServico"
        mc:Ignorable="d"
        Title="EMISSÃO ORDEM DE SERVIÇO" Height="450" Width="664" ResizeMode="NoResize" WindowStyle="ToolWindow" WindowStartupLocation="CenterOwner">

    <Grid>
        <GroupBox HorizontalAlignment="Center" Height="127" Margin="0,10,0,0" VerticalAlignment="Top" Width="644"/>

        <TextBlock Text="Tipo da O.S." Margin="0,0,2,2" VerticalAlignment="Top"/>
        <telerik:RadWatermarkTextBox Margin="0,0,2,2" Width="207" HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <TextBlock Text="Núm. O.S." Margin="0,0,2,2" VerticalAlignment="Top"/>
        <telerik:RadWatermarkTextBox Margin="0,0,2,2" Width="207" HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <TextBlock Text="Planilha" Margin="0,0,2,2" VerticalAlignment="Top"/>
        <telerik:RadWatermarkTextBox Margin="0,0,2,2" Width="277" HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <TextBlock Text="Produto" Margin="0,0,2,2" VerticalAlignment="Top"/>
        <telerik:RadWatermarkTextBox Margin="0,0,2,2" Width="503" HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <TextBlock Text="Quantidade" Margin="0,0,2,2" VerticalAlignment="Top"/>
        <telerik:RadWatermarkTextBox Margin="0,0,2,2" Width="104" HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <TextBlock Text="Setor" Margin="0,0,2,2" VerticalAlignment="Top"/>
        <telerik:RadWatermarkTextBox Margin="0,0,2,2" Width="509" HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <TextBlock Text="Data Inicial" Margin="0,0,2,2" VerticalAlignment="Top"/>
        <telerik:RadWatermarkTextBox Margin="0,0,2,2" Width="104" HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <TextBlock Text="Data Final" Margin="0,0,2,2" VerticalAlignment="Top"/>
        <telerik:RadWatermarkTextBox Margin="0,0,2,2" Width="104" HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <TextBlock Text="Shopping" Margin="0,0,2,2" VerticalAlignment="Top"/>
        <telerik:RadWatermarkTextBox Margin="0,0,2,2" Width="104" HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <TextBlock Text="Tema" Margin="0,0,2,2" VerticalAlignment="Top"/>
        <telerik:RadWatermarkTextBox Margin="0,0,2,2" Width="509" HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <TextBlock Text="Orientação" Margin="0,0,2,2" VerticalAlignment="Top"/>
        <TextBox Margin="0,0,2,2" Width="618" Height="58" HorizontalAlignment="Left" VerticalAlignment="Top" TextWrapping="Wrap" VerticalScrollBarVisibility="Visible" AcceptsReturn="True"/>

        <TextBlock Text="Próximo Setor" Margin="0,0,2,2" VerticalAlignment="Top"/>
        <telerik:RadWatermarkTextBox Margin="0,0,2,2" Width="509" HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <TextBlock Text="Num. Serviço" Margin="0,0,2,2" VerticalAlignment="Top"/>
        <telerik:RadWatermarkTextBox Margin="0,0,2,2" Width="104" HorizontalAlignment="Left" VerticalAlignment="Top"/>
    </Grid>
</Window>
