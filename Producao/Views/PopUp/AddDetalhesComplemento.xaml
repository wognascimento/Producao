<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:Producao.Views.popup"
    xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
    x:Class="Producao.Views.popup.AddDetalhesComplemento"
    xmlns:vewModel="clr-namespace:Producao"
    mc:Ignorable="d"
    Title="Adicionar Detalhes Complemento"
    Height="200" Width="300"
    WindowStartupLocation="CenterScreen"
    WindowStyle="ToolWindow"
    ResizeMode="NoResize">

    <Window.Resources>
        <vewModel:ConverterNumber x:Key="ConverterNumber"/>
        <vewModel:ConverterBoolen x:Key="ConverterBoolen"/>
    </Window.Resources>

    <Grid Margin="10" UseLayoutRounding="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="COMPLEMENTO " VerticalAlignment="Center"  Margin="0,0,2,2"/>
        <TextBlock Grid.Row="1" Text="UNIDADE " VerticalAlignment="Center" Margin="0,0,2,2"/>
        <TextBlock Grid.Row="2" Text="ESTOQUE " VerticalAlignment="Center" Margin="0,0,2,2"/>
        <TextBlock Grid.Row="3" Text="QUANTIDADE " VerticalAlignment="Center" Margin="0,0,2,2"/>
        <TextBlock Grid.Row="4" Text="CONFIRMADO " VerticalAlignment="Center" Margin="0,0,2,2"/>

        <telerik:RadComboBox
            x:Name="compelemntos"
            EmptyText="Seleciona o Complemento"
            Grid.Row="0" Grid.Column="1"
            IsEditable="True"
            IsFilteringEnabled="True"
            OpenDropDownOnFocus="True"
            DisplayMemberPath="complementoadicional"
            ItemsSource="{Binding CompleAdicionais}"
            SelectedItem="{Binding Compledicional}"
            SelectedValue="{Binding DetCompl.codcompladicional, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            SelectedValuePath="codcompladicional" Margin="0,0,2,2" IsTextSearchEnabled="True" StaysOpenOnEdit="True" CanAutocompleteSelectItems="False" CanKeyboardNavigationSelectItems="False" UpdateSelectionOnLostFocus="False" UpdateTextOnLostFocus="False"/>

        <telerik:RadWatermarkTextBox
            Grid.Row="1"
            Grid.Column="1"
            Text="{Binding Compledicional.unidade}"
            IsEnabled="False" Margin="0,0,2,2"/>

        <telerik:RadWatermarkTextBox
            Grid.Row="2"
            Grid.Column="1"
            Text="{Binding Compledicional.saldo_estoque}"
            IsEnabled="False" Margin="0,0,2,2"/>

        <telerik:RadNumericUpDown
            x:Name="quantidade"
            Grid.Row="3"
            Grid.Column="1"
            Minimum="0"
            NumberDecimalDigits="0"
            Value="{Binding DetCompl.qtd, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,2,2"/>

        <CheckBox
            x:Name="confirmado"
            Grid.Row="4"
            Grid.Column="1"
            IsChecked="{Binding Path=DetCompl.confirmado, Converter={StaticResource ConverterBoolen}}" Margin="0,0,2,2"/>

        <telerik:RadButton
            Grid.Row="5"
            Grid.ColumnSpan="2"
            Content="GRAVAR"
            Padding="12,6"
            HorizontalAlignment="Right"
            Click="OnGravarDetalhesComplemento"  Margin="0,0,2,2"/>
    </Grid>
</Window>
