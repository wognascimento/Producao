<UserControl x:Class="Producao.Views.Estoque.RelatorioCCE"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Producao.Views.Estoque"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             mc:Ignorable="d" 
             d:DesignHeight="40" d:DesignWidth="500" Loaded="UserControl_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" Unloaded="RowDefinition_Unloaded"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="auto" />
        </Grid.ColumnDefinitions>

        <telerik:RadComboBox
            x:Name="txtPlanilha"
            Grid.Column="0"
            Margin="5"
            EmptyText="SELECIONE A PLANILHA"
            DisplayMemberPath="planilha"
            IsEditable="True"
            IsTextSearchEnabled="True"
            ItemsSource="{Binding Planilhas}"
            SelectedItem="{Binding Planilha, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <telerik:RadButton
            Grid.Column="1"
            Margin="5" 
            Content="EXPORTAR EXCEL"
            Click="OnExportarExcel" />

    </Grid>

</UserControl>
