<UserControl x:Class="Producao.Views.Estoque.MovimentacaoEntrada"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
    xmlns:app="clr-namespace:Producao"
    mc:Ignorable="d"
    d:DesignHeight="600"
    d:DesignWidth="1000"
    Loaded="UserControl_Loaded"
    Unloaded="UserControl_Unloaded">

    <UserControl.Resources>
        <app:ConverterBoolen x:Key="ConverterBoolen" />
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <telerik:RadWatermarkTextBox x:Name="tbCodproduto" Grid.Row="0" Grid.Column="0"
            WatermarkContent="BUSCAR PRODUTO POR CODIGO"
            PreviewKeyDown="OnBuscaProduto"  Margin="0,0,2,2"/>
        <telerik:RadButton x:Name="btnBuscar" Grid.Row="0" Grid.Column="2"
            Width="90" HorizontalAlignment="Left" Content="BUSCAR" Click="OnOpenDescricoes"  Margin="0,0,2,2"/>

        <telerik:RadComboBox x:Name="txtPlanilha" Grid.Row="1" Grid.Column="0"
            EmptyText="PLANILHA" DisplayMemberPath="planilha"
            IsEditable="True" IsTextSearchEnabled="True" ItemsSource="{Binding Planilhas}"
            SelectionChanged="OnSelectedPlanilha"  Margin="0,0,2,2" IsFilteringEnabled="True" OpenDropDownOnFocus="True" StaysOpenOnEdit="True" CanAutocompleteSelectItems="False" CanKeyboardNavigationSelectItems="False" UpdateSelectionOnLostFocus="False" UpdateTextOnLostFocus="False"/>
        <telerik:RadComboBox x:Name="txtDescricao" Grid.Row="1" Grid.Column="2"
            EmptyText="DESCRICAO" DisplayMemberPath="descricao"
            IsEditable="True" IsTextSearchEnabled="True" ItemsSource="{Binding Produtos}"
            SelectionChanged="OnSelectedDescricao"  Margin="0,0,2,2" IsFilteringEnabled="True" OpenDropDownOnFocus="True" StaysOpenOnEdit="True" CanAutocompleteSelectItems="False" CanKeyboardNavigationSelectItems="False" UpdateSelectionOnLostFocus="False" UpdateTextOnLostFocus="False"/>

        <telerik:RadComboBox x:Name="txtDescricaoAdicional" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
            EmptyText="DESCRICAO ADICIONAL" DisplayMemberPath="descricao_adicional"
            IsEditable="True" IsTextSearchEnabled="True" ItemsSource="{Binding DescAdicionais}"
            SelectionChanged="OnSelectedDescricaoAdicional"  Margin="0,0,2,2" IsFilteringEnabled="True" OpenDropDownOnFocus="True" StaysOpenOnEdit="True" CanAutocompleteSelectItems="False" CanKeyboardNavigationSelectItems="False" UpdateSelectionOnLostFocus="False" UpdateTextOnLostFocus="False"/>

        <telerik:RadComboBox x:Name="txtComplementoAdicional" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
            EmptyText="COMPLEMENTO ADICIONAL" DisplayMemberPath="complementoadicional"
            IsEditable="True" IsTextSearchEnabled="True" ItemsSource="{Binding CompleAdicionais}"
            SelectionChanged="OnSelectedComplementoAdicional"  Margin="0,0,2,2" IsFilteringEnabled="True" OpenDropDownOnFocus="True" StaysOpenOnEdit="True" CanAutocompleteSelectItems="False" CanKeyboardNavigationSelectItems="False" UpdateSelectionOnLostFocus="False" UpdateTextOnLostFocus="False"/>

        <telerik:RadWatermarkTextBox x:Name="txtQuantidade" Grid.Row="4" Grid.Column="0"
            WatermarkContent="QUANTIDADE"  Margin="0,0,2,2"/>

        <Grid Grid.Row="4" Grid.Column="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <telerik:RadComboBox x:Name="procedencias" Grid.Column="0"
                EmptyText="PROCEDENCIA" ItemsSource="{Binding Procedencias}"  Margin="0,0,2,2"/>
            <CheckBox x:Name="processamento" Grid.Column="1" Margin="0,0,2,2"
                VerticalAlignment="Center" Content="PROCESSADO" />
        </Grid>

        <telerik:RadButton Grid.Row="5" Grid.Column="0" Width="110"
            HorizontalAlignment="Left" Content="GRAVAR" Click="OnAdicionarClick"  Margin="0,0,2,2"/>

        <telerik:RadGridView x:Name="itens" Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3"
            AutoGenerateColumns="False" CanUserInsertRows="False" ShowGroupPanel="False"
            IsFilteringAllowed="True" ItemsSource="{Binding Itens}"
            RowValidating="itens_RowValidating" RowEditEnded="itens_RowEditEnded">
            <telerik:RadGridView.Columns>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding descricao_completa}" Header="DESCRICAO" IsReadOnly="True" Width="*" />
                <telerik:GridViewDataColumn DataMemberBinding="{Binding unidade}" Header="UNID." IsReadOnly="True" Width="70" />
                <telerik:GridViewDataColumn DataMemberBinding="{Binding quantidade}" Header="QUANTIDADE" DataFormatString="{}{0:N2}" Width="110" />
                <telerik:GridViewDataColumn DataMemberBinding="{Binding procedencia}" Header="PROCEDENCIA" IsReadOnly="True" Width="150" />
                <telerik:GridViewCheckBoxColumn DataMemberBinding="{Binding processado, Converter={StaticResource ConverterBoolen}}" Header="PROCESSADO" IsReadOnly="True" Width="90" />
                <telerik:GridViewDataColumn DataMemberBinding="{Binding entrada_data}" Header="ENTRADA EM" DataFormatString="{}{0:dd/MM/yyyy HH:mm}" IsReadOnly="True" Width="145" />
                <telerik:GridViewDataColumn DataMemberBinding="{Binding entrada_por}" Header="ENTRADA POR" IsReadOnly="True" Width="130" />
            </telerik:RadGridView.Columns>
        </telerik:RadGridView>
    </Grid>
</UserControl>
