<UserControl x:Class="Producao.Views.Estoque.DigitacaoCCE"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:local="clr-namespace:Producao.Views.Estoque"
             xmlns:app="clr-namespace:Producao" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Unloaded="UserControl_Unloaded">


    <UserControl.Resources>
        <app:ConverterNumber x:Key="ConverterNumber"/>
        <app:ConverterBoolen x:Key="ConverterBoolen"/>
    </UserControl.Resources>



    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.4*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <telerik:RadWatermarkTextBox
            x:Name="tbCodproduto"
            Grid.Row="0"
            Grid.Column="0"
            WatermarkContent="INFORME A SEMANA"
            PreviewKeyDown="OnBuscarLancamentoSemana"
            Margin="0,0,2,2" />

        <telerik:RadGridView
            x:Name="itens" 
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            AutoGenerateColumns="False" 
            CanUserInsertRows="True"
            GroupRenderMode="Flat"
            NewRowPosition="Top"
            ShowGroupPanel="False"
            IsFilteringAllowed="True"
            ItemsSource="{Binding Itens}"
            RowEditEnded="itens_RowEditEnded"
            AddingNewDataItem="itens_AddingNewDataItem">
            <telerik:RadGridView.Columns>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding cod_compladicional}" Header="COD" Width="110" />
                <telerik:GridViewDataColumn DataMemberBinding="{Binding quantidade}" Header="QUANTIDADE" DataFormatString="{}{0:N2}" Width="120" />
                <telerik:GridViewDataColumn DataMemberBinding="{Binding digitado_data}" Header="DIGITADO EM" DataFormatString="{}{0:dd/MM/yyyy HH:mm}" IsReadOnly="True" Width="150" />
                <telerik:GridViewDataColumn DataMemberBinding="{Binding digitado_por}" Header="DIGITADO POR" IsReadOnly="True" Width="140" />
            </telerik:RadGridView.Columns>
        </telerik:RadGridView>


    </Grid>



</UserControl>
