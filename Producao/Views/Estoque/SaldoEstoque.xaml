<UserControl x:Class="Producao.Views.Estoque.SaldoEstoque"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Producao.Views.Estoque"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             mc:Ignorable="d" 
             d:DesignHeight="250" d:DesignWidth="600" Loaded="UserControl_Loaded" Unloaded="UserControl_Unloaded">


    <Grid >
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <telerik:RadComboBox
            x:Name="txtPlanilha"
            Grid.Row="0"
            Grid.Column="2"
            Grid.ColumnSpan="3"
            Margin="0,4"
            EmptyText="SELECIONE A PLANILHA"
            DisplayMemberPath="planilha"
            IsEditable="True"
            IsTextSearchEnabled="True"
            ItemsSource="{Binding Planilhas}"
            SelectedItem="{Binding Planilha, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <telerik:RadButton
            Grid.Column="2" 
            Grid.ColumnSpan="2"
            Grid.Row="2"
            Content="SALDO ESTOQUE DETALHADO" Click="OnSaldoDetalhado" />

        <telerik:RadButton
            Grid.Column="2" 
            Grid.ColumnSpan="2"
            Grid.Row="3"
            Content="SALDO PRODUZIDO > PATRIMONIAL" Visibility="Collapsed" />

        <telerik:RadButton
            Grid.Column="2" 
            Grid.ColumnSpan="2"
            Grid.Row="4"
            Content="SALDO ESTOQUE RESUMIDO" Visibility="Collapsed"/>

        <telerik:RadButton
            Grid.Column="2" 
            Grid.ColumnSpan="2"
            Grid.Row="5"
            Content="PLANEJAMENTO ESTOQUE" Visibility="Collapsed"/>

    </Grid>


</UserControl>
