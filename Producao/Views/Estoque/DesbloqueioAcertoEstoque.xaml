<UserControl x:Class="Producao.Views.Estoque.DesbloqueioAcertoEstoque"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:app="clr-namespace:Producao" 
             xmlns:local="clr-namespace:Producao.Views.Estoque" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Loaded="UserControl_Loaded">


    <UserControl.Resources>
        <app:ConverterNumber x:Key="ConverterNumber"/>
        <app:ConverterBoolen x:Key="ConverterBoolen"/>
    </UserControl.Resources>


    <Grid>

        <telerik:RadGridView
           x:Name="itens" 
           Grid.Row="1"
           Grid.Column="0"
           Grid.ColumnSpan="3"
           AutoGenerateColumns="False" 
           CanUserInsertRows="False"
           ShowGroupPanel="False"
           IsFilteringAllowed="True"
           ItemsSource="{Binding Itens}"
           RowEditEnded="itens_RowEditEnded">
            <telerik:RadGridView.Columns>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding codigo}" Header="CÓDIGO" IsReadOnly="True" Width="90" />
                <telerik:GridViewDataColumn DataMemberBinding="{Binding cod_movimentacao}" Header="MOVIMENTO" IsReadOnly="True" Width="100" />
                <telerik:GridViewDataColumn DataMemberBinding="{Binding processo}" Header="PROCESSO" IsReadOnly="True" Width="100" />
                <telerik:GridViewDataColumn DataMemberBinding="{Binding codcompladicional}" Header="PRODUTO" IsReadOnly="True" Width="95" />
                <telerik:GridViewDataColumn DataMemberBinding="{Binding planilha}" Header="PLANILHA" IsReadOnly="True" Width="100" />
                <telerik:GridViewDataColumn DataMemberBinding="{Binding descricao_completa}" Header="DESCRIÇÃO" IsReadOnly="True" Width="*" />
                <telerik:GridViewDataColumn DataMemberBinding="{Binding unidade}" Header="UNID." IsReadOnly="True" Width="70" />
                <telerik:GridViewDataColumn DataMemberBinding="{Binding quantidade}" Header="QUANTIDADE" DataFormatString="{}{0:N2}" IsReadOnly="True" Width="100" />
                <telerik:GridViewCheckBoxColumn DataMemberBinding="{Binding desbloqueado, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" EditTriggers="CellClick" Header="LIBERAR" Width="80" />
            </telerik:RadGridView.Columns>
        </telerik:RadGridView>

    </Grid>
    
</UserControl>
