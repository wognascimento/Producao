<UserControl x:Class="Producao.Views.Estoque.BaixaRequisicao"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:local="clr-namespace:Producao.Views.Estoque" 
             xmlns:app="clr-namespace:Producao" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Unloaded="UserControl_Unloaded">

    <UserControl.Resources>
        <app:ConverterNumber x:Key="ConverterNumber"/>
        <app:ConverterBoolen x:Key="ConverterBoolen"/>
    </UserControl.Resources>



    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.4*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <telerik:RadWatermarkTextBox
            x:Name="tbCodproduto"
            Grid.Row="0"
            Grid.Column="0"
            WatermarkContent="NÚMERO DA REQUISIÇÃO"
            PreviewKeyDown="OnBuscaRequisicao"
            Margin="0,0,2,2" />

        <telerik:RadGridView
            x:Name="itens" 
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            AutoGenerateColumns="False" 
            CanUserInsertRows="False"
            ShowGroupPanel="False"
            IsFilteringAllowed="True"
            ItemsSource="{Binding Itens}"
            RowEditEnded="itens_RowEditEnded">
            <telerik:RadGridView.Columns>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding codcompladicional}" Header="CÓDIGO" IsReadOnly="True" Width="95" />
                <telerik:GridViewDataColumn DataMemberBinding="{Binding planilha}" Header="PLANILHA" IsReadOnly="True" Width="110" />
                <telerik:GridViewDataColumn DataMemberBinding="{Binding descricao_completa}" Header="DESCRIÇÃO" IsReadOnly="True" Width="*" />
                <telerik:GridViewDataColumn DataMemberBinding="{Binding unidade}" Header="UNID." IsReadOnly="True" Width="70" />
                <telerik:GridViewDataColumn DataMemberBinding="{Binding qtd_req}" Header="QTDE. REQ." DataFormatString="{}{0:N2}" IsReadOnly="True" Width="100" />
                <telerik:GridViewDataColumn DataMemberBinding="{Binding qtd_baixa}" Header="QTDE. BAIXA" DataFormatString="{}{0:N2}" Width="110" />
                <telerik:GridViewDataColumn DataMemberBinding="{Binding saida_data}" Header="SAÍDA EM" DataFormatString="{}{0:dd/MM/yyyy HH:mm}" IsReadOnly="True" Width="145" />
                <telerik:GridViewDataColumn DataMemberBinding="{Binding saida_por}" Header="SAÍDA POR" IsReadOnly="True" Width="130" />
            </telerik:RadGridView.Columns>
        </telerik:RadGridView>


    </Grid>
    
    
</UserControl>
