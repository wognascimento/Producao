<UserControl x:Class="Producao.Views.kit.ViewControleGeralSolicitacao"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:vewModel="clr-namespace:Producao"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <vewModel:ConverterNumber x:Key="ConverterNumber"/>
        <vewModel:ConverterBoolen x:Key="ConverterBoolen"/>
    </UserControl.Resources>

    <Grid>
        <telerik:RadGridView
            x:Name="adicionais"
            AutoGenerateColumns="False"
            ShowGroupPanel="False"
            IsFilteringAllowed="True"
            ItemsSource="{Binding Controles}"
            SelectedItem="{Binding Controle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
            RowValidated="OnRowValidated" 
            RowValidating="OnRowValidating" 
            SelectionUnit="FullRow"
            SelectionMode="Extended">
            <telerik:RadGridView.Columns>
                <telerik:GridViewDataColumn Header="shopping" DataMemberBinding="{Binding shopping}"/>
                <telerik:GridViewDataColumn Header="planilha" DataMemberBinding="{Binding planilha}"/>
                <telerik:GridViewDataColumn Header="descricao_completa" DataMemberBinding="{Binding descricao_completa}"/>
                <telerik:GridViewDataColumn Header="unidade" DataMemberBinding="{Binding unidade}"/>
                <telerik:GridViewDataColumn Header="qtd" DataMemberBinding="{Binding qtd, Converter={StaticResource ConverterNumber}}"/>
                <telerik:GridViewDataColumn Header="obs" DataMemberBinding="{Binding obs}"/>
                <telerik:GridViewDataColumn Header="controle" DataMemberBinding="{Binding kp, Converter={StaticResource ConverterNumber}}"/>
                <telerik:GridViewDataColumn Header="data_solicitacao" DataMemberBinding="{Binding data_solicitacao}" DataFormatString="{}{0:dd/MM/yyyy}"/>
                <telerik:GridViewDataColumn Header="data_envio" DataMemberBinding="{Binding data_envio}" DataFormatString="{}{0:dd/MM/yyyy}"/>
                <telerik:GridViewDataColumn Header="status" DataMemberBinding="{Binding status}"/>
                <telerik:GridViewDataColumn Header="noite_montagem" DataMemberBinding="{Binding noite_montagem}"/>
                <telerik:GridViewDataColumn Header="placa" DataMemberBinding="{Binding placa}"/>
                <telerik:GridViewDataColumn Header="motorista" DataMemberBinding="{Binding motorista}"/>
                <telerik:GridViewDataColumn Header="horario_saida" DataMemberBinding="{Binding horario_saida}" DataFormatString="{}{0:h\\:mm}"/>
                <telerik:GridViewDataColumn Header="motivos" DataMemberBinding="{Binding motivos}"/>
                <telerik:GridViewDataColumn Header="class_solucao" DataMemberBinding="{Binding class_solucao}"/>
            </telerik:RadGridView.Columns>
        </telerik:RadGridView>
    </Grid>
</UserControl>
