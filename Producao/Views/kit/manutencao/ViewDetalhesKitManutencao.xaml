<UserControl x:Class="Producao.Views.kit.solucao.ViewDetalhesKitManutencao"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vewModel="clr-namespace:Producao"
             xmlns:app="clr-namespace:Producao"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             mc:Ignorable="d"
             d:DesignHeight="768" d:DesignWidth="1024"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <vewModel:ConverterNumber x:Key="ConverterNumber"/>
        <vewModel:ConverterBoolen x:Key="ConverterBoolen"/>
        <app:CheclistRevisaoColorConverter x:Key="converterCollor"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Vertical" Margin="4">
            <StackPanel Orientation="Horizontal">
                <telerik:RadWatermarkTextBox x:Name="cbSiglaShopping" Width="260" IsEnabled="False" WatermarkContent="Shopping" Margin="0,0,2,2"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <telerik:RadWatermarkTextBox x:Name="tbId" Width="150" IsEnabled="False" WatermarkContent="ID" Margin="0,0,2,2"/>
                <telerik:RadWatermarkTextBox x:Name="tbItem" Width="100" IsEnabled="False" WatermarkContent="ITEM" Margin="0,0,2,2"/>
                <telerik:RadWatermarkTextBox x:Name="tbLocalShopping" Width="470" IsEnabled="False" WatermarkContent="LOCAL DO SHOPPING" Margin="0,0,2,2"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <telerik:RadComboBox x:Name="cbPlanilha"
                                     Width="270"
                                     IsEditable="True"
                                     IsFilteringEnabled="True"
                                     OpenDropDownOnFocus="True"
                                     EmptyText="PLANILHA"
                                     DisplayMemberPath="planilha"
                                     SelectedValuePath="planilha"
                                     ItemsSource="{Binding Planilhas}"
                                     SelectedItem="{Binding Planilha, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     SelectionChanged="OnPlanilhaSelectionChanged" Margin="0,0,2,2" IsTextSearchEnabled="True" StaysOpenOnEdit="True" CanAutocompleteSelectItems="False" CanKeyboardNavigationSelectItems="False" UpdateSelectionOnLostFocus="False" UpdateTextOnLostFocus="False"/>

                <telerik:RadComboBox x:Name="cbDescricao"
                                     Width="450"
                                     IsEditable="True"
                                     IsFilteringEnabled="True"
                                     OpenDropDownOnFocus="True"
                                     EmptyText="DESCRIÇÃO"
                                     DisplayMemberPath="descricao"
                                     SelectedValuePath="codigo"
                                     ItemsSource="{Binding Produtos}"
                                     SelectedItem="{Binding Produto, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     SelectedValue="{Binding ComplementoCheckList.codproduto, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     SelectionChanged="OnDescricaoSelectionChanged" Margin="0,0,2,2" IsTextSearchEnabled="True" StaysOpenOnEdit="True" CanAutocompleteSelectItems="False" CanKeyboardNavigationSelectItems="False" UpdateSelectionOnLostFocus="False" UpdateTextOnLostFocus="False"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <telerik:RadComboBox x:Name="cbDescricaoAdicional"
                                     Width="560"
                                     IsEditable="True"
                                     IsFilteringEnabled="True"
                                     OpenDropDownOnFocus="True"
                                     EmptyText="DESCRIÇÃO ADICIONAL"
                                     DisplayMemberPath="descricao_adicional"
                                     SelectedValuePath="coduniadicional"
                                     ItemsSource="{Binding DescAdicionais}"
                                     SelectedItem="{Binding DescAdicional, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     SelectedValue="{Binding ComplementoCheckList.coduniadicional, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,2,2" IsTextSearchEnabled="True" StaysOpenOnEdit="True" CanAutocompleteSelectItems="False" CanKeyboardNavigationSelectItems="False" UpdateSelectionOnLostFocus="False" UpdateTextOnLostFocus="False"/>

                <telerik:RadButton Content="..."  Width="50" Click="OnProdutos" Margin="0,0,2,2"/>

                <telerik:RadNumericUpDown x:Name="tbQtde"
                                          Width="110"
                                          NullValue="{x:Null}"
                                          Minimum="0"
                                          NumberDecimalDigits="2"
                                          Value="{Binding ComplementoCheckList.qtd, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,2,2"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <telerik:RadWatermarkTextBox x:Name="tbOrientacaoProducao"
                                             Width="720"
                                             WatermarkContent="ORIENTAÇÃO DE PRODUÇÃO"
                                             Text="{Binding ComplementoCheckList.obs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,2,2"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <telerik:RadWatermarkTextBox x:Name="tbOrientacaoMontagem"
                                             Width="720"
                                             WatermarkContent="ORIENTAÇÃO DE MONTAGEM"
                                             Text="{Binding ComplementoCheckList.orient_montagem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,2,2"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <telerik:RadWatermarkTextBox x:Name="tbOrientacaoDesmontagem"
                                             Width="720"
                                             WatermarkContent="ORIENTAÇÃO DE DESMONTAGEM"
                                             Text="{Binding ComplementoCheckList.orient_desmont, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,2,2"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Height="Auto">
                <telerik:RadComboBox x:Name="cmbClassificacoes"
                                     Width="260"
                                     EmptyText="CLASSIFICAÇÃO"
                                     ItemsSource="{Binding Classificacoes}"
                                     SelectionChanged="OnClassificacaoSelectionChanged" Margin="0,0,2,2"/>

                <telerik:RadComboBox x:Name="cmbMotivos"
                                     Width="260"
                                     EmptyText="MOTIVO"
                                     ItemsSource="{Binding Motivos}" Margin="0,0,2,2"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <telerik:RadButton Content="LIMPAR" Click="OnLimparClick" Margin="0,0,2,2"/>
                <telerik:RadButton Content="ADICIONAR" Click="OnAdicionar_Click" Margin="0,0,2,2"/>
                <telerik:RadButton Content="EDITAR" Click="OnEditClick" Margin="0,0,2,2"/>
                <telerik:RadButton Content="IMPRIMIR" Click="OnPrintClick" Margin="0,0,2,2"/>
            </StackPanel>
        </StackPanel>

        <telerik:RadGridView x:Name="dgCheckListGeral"
                             Grid.Row="1"
                             AutoGenerateColumns="False"
                             CanUserResizeColumns="True"
                             CanUserReorderColumns="True"
                             IsFilteringAllowed="True"
                             IsReadOnly="True"
                             ShowGroupPanel="False"
                             ItemsSource="{Binding CheckListGerais}"
                             SelectedItem="{Binding CheckListGeral, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             SelectionChanged="OnSelectionChanged"
                             FontSize="10">
            <telerik:RadGridView.Columns>
                <telerik:GridViewDataColumn Header="class_solucao" DataMemberBinding="{Binding class_solucao}"/>
                <telerik:GridViewDataColumn Header="motivos" DataMemberBinding="{Binding motivos}"/>
                <telerik:GridViewDataColumn Header="ID" DataMemberBinding="{Binding id}"/>
                <telerik:GridViewDataColumn Header="ITEM" DataMemberBinding="{Binding item_memorial}"/>
                <telerik:GridViewDataColumn Header="LOCAL DO SHOPPING" DataMemberBinding="{Binding local_shoppings}"/>
                <telerik:GridViewDataColumn Header="PLANILHA" DataMemberBinding="{Binding Path=planilha, Mode=OneWay}"/>
                <telerik:GridViewDataColumn Header="DESCRIÇÃO" DataMemberBinding="{Binding descricao}"/>
                <telerik:GridViewDataColumn Header="DESCRIÇÃO ADICIONAL" DataMemberBinding="{Binding descricao_adicional}"/>
                <telerik:GridViewDataColumn Header="QTDE" DataMemberBinding="{Binding qtd, Converter={StaticResource ConverterNumber}}"/>
                <telerik:GridViewDataColumn Header="CODCOMPL" DataMemberBinding="{Binding codcompl, Converter={StaticResource ConverterNumber}}"/>
                <telerik:GridViewDataColumn Header="ORIENTAÇÃO DE PRODUÇÃO" DataMemberBinding="{Binding obs}"/>
                <telerik:GridViewDataColumn Header="ORIENTAÇÃO DE MONTAGEM" DataMemberBinding="{Binding orient_montagem}"/>
                <telerik:GridViewDataColumn Header="ORIENTAÇÃO DE DESMONTAGEM" DataMemberBinding="{Binding orient_desmont}"/>
                <telerik:GridViewDataColumn Header="inserido_por" DataMemberBinding="{Binding inserido_por}"/>
                <telerik:GridViewDataColumn Header="inserido_em" DataMemberBinding="{Binding inserido_em}" DataFormatString="{}{0:dd/MM/yyyy HH:mm}"/>
                <telerik:GridViewDataColumn Header="alterado_por" DataMemberBinding="{Binding alterado_por}"/>
                <telerik:GridViewDataColumn Header="alterado_em" DataMemberBinding="{Binding alterado_em}" DataFormatString="{}{0:dd/MM/yyyy HH:mm}"/>
            </telerik:RadGridView.Columns>
        </telerik:RadGridView>

        <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch"/>

        <telerik:RadGridView x:Name="dgComplemento"
                             Grid.Row="3"
                             AutoGenerateColumns="False"
                             CanUserInsertRows="True"
                             GroupRenderMode="Flat"
                             NewRowPosition="Bottom"
                             ShowGroupPanel="False"
                             CanUserResizeColumns="True"
                             IsFilteringAllowed="True"
                             ItemsSource="{Binding CheckListGeralComplementos}"
                             SelectedItem="{Binding CheckListGeralComplemento, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AddingNewDataItem="dgComplemento_AddingNewDataItem"
                             CellEditEnded="dgComplemento_CellEditEnded"
                             RowValidated="dgComplemento_RowValidated"
                             RowValidating="dgComplemento_RowValidating"
                             FontSize="10">
            <telerik:RadGridView.Columns>
                <telerik:GridViewDataColumn Header="COMPLEMENTO ADICIONAL" DataMemberBinding="{Binding codcompladicional}">
                    <telerik:GridViewDataColumn.CellTemplate>
                        <DataTemplate>
                            <telerik:RadComboBox ItemsSource="{Binding DataContext.CompleAdicionais, RelativeSource={RelativeSource AncestorType=telerik:RadGridView}}"
                                                 DisplayMemberPath="complementoadicional"
                                                 SelectedValuePath="codcompladicional"
                                                 SelectedValue="{Binding codcompladicional, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEditable="True"
                                                 IsFilteringEnabled="True"
                                                 OpenDropDownOnFocus="True"
                                                 SelectionChanged="OnComplementoAdicionalSelectionChanged" Margin="0,0,2,2" IsTextSearchEnabled="True" StaysOpenOnEdit="True" CanAutocompleteSelectItems="False" CanKeyboardNavigationSelectItems="False" UpdateSelectionOnLostFocus="False" UpdateTextOnLostFocus="False"/>
                        </DataTemplate>
                    </telerik:GridViewDataColumn.CellTemplate>
                </telerik:GridViewDataColumn>
                <telerik:GridViewDataColumn Header="UNID" DataMemberBinding="{Binding unidade}" TextAlignment="Center"/>
                <telerik:GridViewDataColumn Header="ESTOQUE" DataMemberBinding="{Binding saldoestoque, Converter={StaticResource ConverterNumber}}" TextAlignment="Center"/>
                <telerik:GridViewDataColumn Header="QTDE" DataMemberBinding="{Binding qtd, Converter={StaticResource ConverterNumber}}"/>
                <telerik:GridViewDataColumn Header="CONFIRMADO">
                    <telerik:GridViewDataColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox HorizontalAlignment="Center"
                                      IsChecked="{Binding confirmado, Converter={StaticResource ConverterBoolen}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,2,2"/>
                        </DataTemplate>
                    </telerik:GridViewDataColumn.CellTemplate>
                </telerik:GridViewDataColumn>
                <telerik:GridViewDataColumn Header="CODDETALHESCOMPL" DataMemberBinding="{Binding coddetalhescompl, Converter={StaticResource ConverterNumber}}"/>
                <telerik:GridViewDataColumn Header="QTD EXPEDIDA" DataMemberBinding="{Binding qtd_expedida, Converter={StaticResource ConverterNumber}}" TextAlignment="Center"/>
                <telerik:GridViewDataColumn Header="alterado_por" DataMemberBinding="{Binding alterado_por}"/>
                <telerik:GridViewDataColumn Header="data_alteracao" DataMemberBinding="{Binding data_alteracao}" DataFormatString="{}{0:dd/MM/yyyy HH:mm}"/>
            </telerik:RadGridView.Columns>
        </telerik:RadGridView>
    </Grid>
</UserControl>

