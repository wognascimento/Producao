<UserControl x:Class="Producao.Views.RelatoriosTecnicos.Estabilidade"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Producao.Views.RelatoriosTecnicos" 
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             MinHeight="450"
             MinWidth="800"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Loaded="UserControl_Loaded">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition />
        </Grid.RowDefinitions>

        <telerik:RadComboBox
            Grid.Row="0"
            Width="260" 
            HorizontalAlignment="Left"
            EmptyText="Shopping"
            IsEditable="True"
            IsFilteringEnabled="True"
            OpenDropDownOnFocus="True"
            ItemsSource="{Binding Siglas}"
            SelectedItem="{Binding Sigla, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            SelectionChanged="OnSiglaSelectionChanged" Margin="0,0,2,2" IsTextSearchEnabled="True" StaysOpenOnEdit="True" CanAutocompleteSelectItems="False" CanKeyboardNavigationSelectItems="False" UpdateSelectionOnLostFocus="False" UpdateTextOnLostFocus="False"/>

        <telerik:RadButton Grid.Column="1" HorizontalAlignment="Left" Content="Imprimir" Click="OnPrintClick" Margin="0,0,2,2"/>



        <telerik:RadGridView
            Grid.Row="1"
            Grid.ColumnSpan="2"
            AutoGenerateColumns="False" 
            CanUserResizeColumns="True"
            CanUserReorderColumns="True"
            IsFilteringAllowed="True"
            ShowGroupPanel="False"
            RowHeight="150"
            ItemsSource="{Binding Detalhes}"
            CellEditEnded="DetalhesCellEditEnded"
            SelectionMode="Single">
            <telerik:RadGridView.Columns>

                <telerik:GridViewDataColumn 
                    DataMemberBinding="{Binding familia}"
                    Header="familia"
                    IsReadOnly="True"/>

                <telerik:GridViewDataColumn 
                    DataMemberBinding="{Binding descricaocomercial}"
                    Header="descricaocomercial"
                    IsReadOnly="True"/>

                <telerik:GridViewDataColumn 
                    DataMemberBinding="{Binding dimensao}"
                    Header="dimensao"
                    IsReadOnly="True"/>

                <telerik:GridViewDataColumn 
                    DataMemberBinding="{Binding relatorio_estabilidade, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Header="relatorio_estabilidade"
                    Width="*"/>

            </telerik:RadGridView.Columns>
        </telerik:RadGridView>


    </Grid>
    
</UserControl>
