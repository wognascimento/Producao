<UserControl x:Class="Producao.Views.RelatoriosTecnicos.Inflamabilidade"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Producao.Views.RelatoriosTecnicos" 
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             MinHeight="450"
             MinWidth="800"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Loaded="UserControl_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition />
        </Grid.RowDefinitions>

        <telerik:RadComboBox
            Grid.Row="0"
            Width="260"
            HorizontalAlignment="Left"
            EmptyText="Shopping"
            IsEditable="True"
            IsFilteringEnabled="True"
            OpenDropDownOnFocus="True"
            ItemsSource="{Binding Siglas}"
            SelectedItem="{Binding Sigla, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            SelectionChanged="OnSiglaSelectionChanged"/>

        <telerik:RadComboBox
            Grid.Row="1"
            Width="260"
            HorizontalAlignment="Left"
            EmptyText="Responsável"
            DisplayMemberPath="nome"
            IsEditable="True"
            IsFilteringEnabled="True"
            OpenDropDownOnFocus="True"
            ItemsSource="{Binding Responsaveis}"
            SelectedItem="{Binding Responsavel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            SelectionChanged="OnResponsavelSelectionChanged"/>

        <telerik:RadWatermarkTextBox
            Grid.Row="2"
            Width="260"
            HorizontalAlignment="Left"
            WatermarkContent="RG"
            Text="{Binding Responsavel.rg, Mode=OneWay}"
            IsReadOnly="True"/>

        <telerik:RadWatermarkTextBox
            Grid.Row="3"
            Width="260"
            HorizontalAlignment="Left"
            WatermarkContent="CAU/SP"
            Text="{Binding Responsavel.cau_sp, Mode=OneWay}"
            IsReadOnly="True"/>

        <telerik:RadWatermarkTextBox
            Grid.Row="4"
            Width="260"
            HorizontalAlignment="Left"
            WatermarkContent="RRT"
            Text="{Binding Inflamabilidade.rrt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            LostFocus="Rrt_LostFocus"/>

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>

            <telerik:RadWatermarkTextBox
                Grid.Column="0"
                WatermarkContent="Data Conclusão"
                Text="{Binding Inflamabilidade.data_conclusao, Mode=OneWay, StringFormat={}{0:dd/MM/yyyy}}"
                IsReadOnly="True"/>


            <telerik:RadWatermarkTextBox
                Grid.Column="1"
                WatermarkContent="Concluido Por"
                Text="{Binding Inflamabilidade.concluido_por, Mode=OneWay}"
                IsReadOnly="True"/>

            <telerik:RadButton Grid.Column="2" Content="Imprimir" Click="OnImprimirClick"/>
            <telerik:RadButton Grid.Column="3" Content="Concluir" Click="OnConcluirClick"/>


        </Grid>

        <telerik:RadGridView
            Grid.Row="6"
            AutoGenerateColumns="False" 
            CanUserResizeColumns="True"
            CanUserReorderColumns="True"
            IsFilteringAllowed="True"
            ShowGroupPanel="False"
            RowHeight="100"
            ItemsSource="{Binding Detalhes}"
            SelectedItem="{Binding Detalhe, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            CellEditEnded="DetalhesCellEditEnded"
            SelectionMode="Single">
            <telerik:RadGridView.Columns>

                <telerik:GridViewDataColumn 
                    DataMemberBinding="{Binding tipo}"
                    Header="tipo"
                    IsReadOnly="True"/>

                <telerik:GridViewDataColumn 
                    DataMemberBinding="{Binding descritivo}"
                    Header="descritivo"
                    IsReadOnly="True"/>

                <telerik:GridViewComboBoxColumn
                    Header="classificacao"
                    DataMemberBinding="{Binding classificacao, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    ItemsSource="{Binding DataContext.Classificacoes, RelativeSource={RelativeSource AncestorType=telerik:RadGridView}}"
                    DisplayMemberPath="classificacao"
                    SelectedValueMemberPath="id"/>

            </telerik:RadGridView.Columns>
        </telerik:RadGridView>

    </Grid>
</UserControl>
