<UserControl x:Class="Producao.Views.CentralModelos.ViewCentralCriarModelo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:app="clr-namespace:Producao.Views"
             xmlns:local="clr-namespace:Producao.Views.CentralModelos"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800"
             Language="pt-BR"
             Initialized="UserControl_Initialized"
             Unloaded="UserControl_Unloaded">

    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="303"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="5"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <telerik:RadWatermarkTextBox
            x:Name="txtCodigoProduto"
            Grid.Row="0"
            Grid.Column="0"
            WatermarkContent="BUSCAR PRODUTO POR CÓDIGO"
            PreviewKeyDown="OnBuscaProduto" Margin="0,0,2,1"/>

        <telerik:RadButton
            x:Name="btnBuscar"
            Grid.Row="0"
            Grid.Column="2"
            Width="50"
            HorizontalAlignment="Left"
            Content="..."
            Click="OnOpenDescricoes" Margin="0,0,2,1"/>

        <telerik:RadComboBox
            x:Name="txtPlanilha"
            Grid.Row="1"
            Grid.Column="0"
            IsEditable="True"
            IsFilteringEnabled="True"
            OpenDropDownOnFocus="True"
            EmptyText="PLANILHA"
            ItemsSource="{Binding Planilhas}"
            DisplayMemberPath="planilha"
            SelectionChanged="OnSelectedPlanilha" Margin="0,0,2,1" IsTextSearchEnabled="True" StaysOpenOnEdit="True" CanAutocompleteSelectItems="False" CanKeyboardNavigationSelectItems="False" UpdateSelectionOnLostFocus="False" UpdateTextOnLostFocus="False"/>

        <telerik:RadComboBox
            x:Name="txtDescricao"
            Grid.Row="1"
            Grid.Column="2"
            IsEditable="True"
            IsFilteringEnabled="True"
            OpenDropDownOnFocus="True"
            EmptyText="DESCRIÇÃO"
            ItemsSource="{Binding Produtos}"
            DisplayMemberPath="descricao"
            SelectionChanged="OnSelectedDescricao" Margin="0,0,2,1" IsTextSearchEnabled="True" StaysOpenOnEdit="True" CanAutocompleteSelectItems="False" CanKeyboardNavigationSelectItems="False" UpdateSelectionOnLostFocus="False" UpdateTextOnLostFocus="False"/>

        <telerik:RadComboBox
            x:Name="txtDescricaoAdicional"
            Grid.Row="2"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            IsEditable="True"
            IsFilteringEnabled="True"
            OpenDropDownOnFocus="True"
            EmptyText="DESCRIÇÃO ADICIONAL"
            ItemsSource="{Binding DescAdicionais}"
            DisplayMemberPath="descricao_adicional"
            SelectionChanged="OnSelectedDescricaoAdicional" Margin="0,0,2,1" IsTextSearchEnabled="True" StaysOpenOnEdit="True" CanAutocompleteSelectItems="False" CanKeyboardNavigationSelectItems="False" UpdateSelectionOnLostFocus="False" UpdateTextOnLostFocus="False"/>

        <telerik:RadComboBox
            x:Name="txtComplementoAdicional"
            Grid.Row="3"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            IsEditable="True"
            IsFilteringEnabled="True"
            OpenDropDownOnFocus="True"
            EmptyText="COMPLEMENTO ADICIONAL"
            ItemsSource="{Binding CompleAdicionais}"
            DisplayMemberPath="complementoadicional"
            SelectionChanged="OnSelectedComplementoAdicional" Margin="0,0,2,1" IsTextSearchEnabled="True" StaysOpenOnEdit="True" CanAutocompleteSelectItems="False" CanKeyboardNavigationSelectItems="False" UpdateSelectionOnLostFocus="False" UpdateTextOnLostFocus="False"/>

        <telerik:RadComboBox
            x:Name="txtTema"
            Grid.Row="4"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            IsEditable="True"
            IsFilteringEnabled="True"
            OpenDropDownOnFocus="True"
            EmptyText="TEMA"
            ItemsSource="{Binding Temas}"
            DisplayMemberPath="temas"
            SelectionChanged="OnSelectedTema" Margin="0,0,2,1" IsTextSearchEnabled="True" StaysOpenOnEdit="True" CanAutocompleteSelectItems="False" CanKeyboardNavigationSelectItems="False" UpdateSelectionOnLostFocus="False" UpdateTextOnLostFocus="False"/>

        <telerik:RadWatermarkTextBox
            x:Name="txtObservacao"
            Grid.Row="5"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            WatermarkContent="OBSERVAÇÃO"
            TextWrapping="Wrap"
            AcceptsReturn="True"
            VerticalScrollBarVisibility="Visible" Margin="0,0,2,1"/>

        <Grid Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>

            <telerik:RadButton Grid.Column="0" Content="LIMPAR" Click="OnLimparClick" />
            <telerik:RadButton Grid.Column="2" Content="GRAVAR" Click="OnAdicionar_Click" />
            <telerik:RadButton Grid.Column="4" Content="RECEITA" Click="OnReceitaClick" />
            <telerik:RadButton Grid.Column="6" Content="CONTROLE" Click="OnControleClick" />
        </Grid>

        <telerik:RadGridView
            x:Name="dgModelos"
            Grid.Row="9"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            AutoGenerateColumns="False"
            ItemsSource="{Binding QryModelos}"
            MouseDoubleClick="dgModelos_MouseDoubleClick"
            FontSize="10"
            SelectionChanged="dgModelos_SelectionChanged"
            ShowGroupPanel="False"
            IsReadOnly="True" MultipleColumnSortModifiers="Shift">
            <telerik:RadGridView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Atualizar" Click="OnAtualizarGridClick"/>
                </ContextMenu>
            </telerik:RadGridView.ContextMenu>
            <telerik:RadGridView.Columns>
                <telerik:GridViewDataColumn UniqueName="id_modelo" DataMemberBinding="{Binding id_modelo}" DataFormatString="{}{0:F0}" Width="SizeToCells"/>
                <telerik:GridViewDataColumn UniqueName="tema" DataMemberBinding="{Binding tema}"/>
                <telerik:GridViewDataColumn UniqueName="planilha" DataMemberBinding="{Binding planilha}"/>
                <telerik:GridViewDataColumn UniqueName="descricao_completa" DataMemberBinding="{Binding descricao_completa}"/>
                <telerik:GridViewDataColumn UniqueName="obs_modelo" DataMemberBinding="{Binding obs_modelo}" Width="SizeToHeader"/>
                <telerik:GridViewDataColumn UniqueName="unidade" DataMemberBinding="{Binding unidade}" Width="SizeToCells"/>
                <telerik:GridViewDataColumn UniqueName="cadastrado_por" DataMemberBinding="{Binding cadastrado_por}" Width="SizeToCells"/>
                <telerik:GridViewDataColumn UniqueName="data_cadastro" DataMemberBinding="{Binding data_cadastro}" DataFormatString="{}{0:dd/MM/yyyy HH:mm}" Width="SizeToCells"/>
                <telerik:GridViewDataColumn UniqueName="codcompladicional" DataMemberBinding="{Binding codcompladicional}" DataFormatString="{}{0:F0}" IsVisible="False"/>
            </telerik:RadGridView.Columns>
        </telerik:RadGridView>
    </Grid>
</UserControl>
