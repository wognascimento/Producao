<UserControl x:Class="Producao.Views.CentralModelos.ViewCentralEmitirOs"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Producao.Views.CentralModelos"
             xmlns:app="clr-namespace:Producao"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             mc:Ignorable="d"
             d:DesignHeight="768"
             d:DesignWidth="1024"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded"
             ContextMenuClosing="UserControl_ContextMenuClosing">

    <UserControl.Resources>
        <app:ConverterNumber x:Key="ConverterNumber"/>
    </UserControl.Resources>

    <Grid>
        <telerik:RadGridView
            x:Name="dgTabela"
            AutoGenerateColumns="False"
            CanUserResizeColumns="True"
            ShowGroupPanel="False"
            IsFilteringAllowed="True"
            IsReadOnly="True"
            ItemsSource="{Binding Itens}"
            SelectedItem="{Binding Item, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            PreviewMouseRightButtonDown="dgTabela_PreviewMouseRightButtonDown"
            PreviewKeyDown="dgTabela_PreviewKeyDown">

            <telerik:RadGridView.ContextMenu>
                <ContextMenu Style="{x:Null}">
                    <MenuItem
                        Command="{Binding Source={x:Static Member=local:ContextMenuCommands.CreateOS}}"
                        CommandParameter="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                        Header="Gerar Ordem de Serviço"/>
                    <MenuItem
                        Command="{Binding Source={x:Static Member=local:ContextMenuCommands.ReimprimirOS}}"
                        CommandParameter="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                        Header="Re-imprimir Ordem de Serviço"/>
                    <MenuItem
                        Command="{Binding Source={x:Static Member=local:ContextMenuCommands.TabelaPAExcel}}"
                        CommandParameter="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                        Header="Tabela P.A Excel"/>
                    <MenuItem
                        Command="{Binding Source={x:Static Member=local:ContextMenuCommands.ReceitaControle}}"
                        CommandParameter="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                        Header="Receita Controle"/>
                </ContextMenu>
            </telerik:RadGridView.ContextMenu>

            <telerik:RadGridView.Columns>
                <telerik:GridViewDataColumn Header="sigla" DataMemberBinding="{Binding sigla}"/>
                <telerik:GridViewDataColumn Header="tema" DataMemberBinding="{Binding tema}"/>
                <telerik:GridViewDataColumn Header="planilha" DataMemberBinding="{Binding planilha}"/>
                <telerik:GridViewDataColumn Header="descricao_completa" DataMemberBinding="{Binding descricao_completa}" Width="*"/>
                <telerik:GridViewDataColumn Header="unidade" DataMemberBinding="{Binding unidade}" Width="65"/>
                <telerik:GridViewDataColumn Header="id_modelo" DataMemberBinding="{Binding id_modelo, Converter={StaticResource ConverterNumber}}" Width="65"/>
                <telerik:GridViewDataColumn Header="qtde" DataMemberBinding="{Binding qtde}" Width="60"/>
                <telerik:GridViewDataColumn Header="qtde_os" DataMemberBinding="{Binding qtde_os}" Width="60"/>
                <telerik:GridViewExpressionColumn Header="Qtde Faltante" Expression="qtde - qtde_os" Width="150" TextAlignment="Right"/>
            </telerik:RadGridView.Columns>
        </telerik:RadGridView>
    </Grid>
</UserControl>
