<Window x:Class="Producao.Views.CentralModelos.ModeloControleChecklist"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Producao.Views.CentralModelos" 
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        mc:Ignorable="d"
        Title="CONTROLE BAIXA MODELO CHECK-LIST"
        Height="450" Width="800" 
        Language="pt-BR"
        WindowStartupLocation="CenterScreen" 
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        Loaded="Window_Loaded">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <telerik:RadGridView
            x:Name="dgItens"
            Grid.Row="0" 
            AutoGenerateColumns="False" 
            FontSize="10" 
            ItemsSource="{Binding ItensChkList}" 
            SelectedItem="{Binding ItemChkList, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            PreviewKeyDown="dgItens_PreviewKeyDown"
            ShowGroupPanel="False"
            IsReadOnly="True">
            <telerik:RadGridView.Columns>
                <telerik:GridViewDataColumn Header="SIGLA" DataMemberBinding="{Binding sigla}" Width="SizeToCells"/>
                <telerik:GridViewDataColumn Header="COD.DET." DataMemberBinding="{Binding coddetalhescompl}" DataFormatString="{}{0:N0}" Width="SizeToHeader"/>
                <telerik:GridViewDataColumn Header="PLANILHA" DataMemberBinding="{Binding planilha}" Width="SizeToHeader"/>
                <telerik:GridViewDataColumn Header="DESCRIÇÃO COMPLETA" DataMemberBinding="{Binding descricao_completa}" Width="*"/>
                <telerik:GridViewDataColumn Header="UNID" DataMemberBinding="{Binding unidade}" Width="SizeToCells"/>
                <telerik:GridViewDataColumn Header="QTDE" DataMemberBinding="{Binding qtd_compl_chk}" DataFormatString="{}{0:N0}" Width="SizeToCells"/>
            </telerik:RadGridView.Columns>
        </telerik:RadGridView>

        <StatusBar Grid.Row="1">
            <StatusBarItem Grid.Column="1">
                <TextBlock Text="Precisona a tecla F3 na linha selecionada para dar baixa" FontWeight="Bold" />
            </StatusBarItem>
        </StatusBar>

    </Grid>
    
</Window>
