<Window x:Class="Producao.Views.CentralModelos.ModeloReceita"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Producao"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        mc:Ignorable="d"
        Title="RECEITA DO MODELO"
        Height="800"
        Width="1024"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        Language="pt-BR"
        WindowState="Maximized"
        Loaded="Window_Loaded">

    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="303"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="5"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <telerik:RadWatermarkTextBox x:Name="txtCodigoProduto" Grid.Row="0" Grid.Column="0" WatermarkContent="BUSCAR PRODUTO POR CÓDIGO" PreviewKeyDown="OnBuscaProduto"/>
        <telerik:RadButton x:Name="btnBuscar" Grid.Row="0" Grid.Column="2" Width="50" HorizontalAlignment="Left" Content="..." Click="OnOpenDescricoes"/>

        <telerik:RadComboBox x:Name="txtPlanilha" Grid.Row="1" Grid.Column="0" IsEditable="True" IsFilteringEnabled="True" OpenDropDownOnFocus="True" EmptyText="PLANILHA" ItemsSource="{Binding Planilhas}" DisplayMemberPath="planilha" SelectionChanged="OnSelectedPlanilha"/>
        <telerik:RadComboBox x:Name="txtDescricao" Grid.Row="1" Grid.Column="2" IsEditable="True" IsFilteringEnabled="True" OpenDropDownOnFocus="True" EmptyText="DESCRIÇÃO" ItemsSource="{Binding Produtos}" DisplayMemberPath="descricao" SelectionChanged="OnSelectedDescricao"/>
        <telerik:RadComboBox x:Name="txtDescricaoAdicional" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" IsEditable="True" IsFilteringEnabled="True" OpenDropDownOnFocus="True" EmptyText="DESCRIÇÃO ADICIONAL" ItemsSource="{Binding DescAdicionais}" DisplayMemberPath="descricao_adicional" SelectionChanged="OnSelectedDescricaoAdicional"/>
        <telerik:RadComboBox x:Name="txtComplementoAdicional" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" IsEditable="True" IsFilteringEnabled="True" OpenDropDownOnFocus="True" EmptyText="COMPLEMENTO ADICIONAL" ItemsSource="{Binding CompleAdicionais}" DisplayMemberPath="complementoadicional" SelectionChanged="OnSelectedComplementoAdicional"/>

        <telerik:RadWatermarkTextBox x:Name="txtObservacao" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" WatermarkContent="OBSERVAÇÃO" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Visible"/>

        <Grid Grid.Row="5" Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="5"/>
            </Grid.ColumnDefinitions>

            <telerik:RadNumericUpDown x:Name="txtQtdModelo" Grid.Column="0" Minimum="0" NullValue="QTD. MODELO"/>
            <telerik:RadNumericUpDown x:Name="txtQtdProducao" Grid.Column="2" Minimum="0" NullValue="QTD. PRODUÇÃO"/>
        </Grid>

        <GroupBox x:Name="GBQtdFiadas" Grid.Row="7" Grid.ColumnSpan="3" Visibility="Collapsed" Header="Quantidade Modelo Fiada">
            <UniformGrid Columns="10">
                <telerik:RadNumericUpDown x:Name="mod01" Minimum="0" NumberDecimalDigits="0"/>
                <telerik:RadNumericUpDown x:Name="mod02" Minimum="0" NumberDecimalDigits="0"/>
                <telerik:RadNumericUpDown x:Name="mod03" Minimum="0" NumberDecimalDigits="0"/>
                <telerik:RadNumericUpDown x:Name="mod04" Minimum="0" NumberDecimalDigits="0"/>
                <telerik:RadNumericUpDown x:Name="mod05" Minimum="0" NumberDecimalDigits="0"/>
                <telerik:RadNumericUpDown x:Name="mod06" Minimum="0" NumberDecimalDigits="0"/>
                <telerik:RadNumericUpDown x:Name="mod07" Minimum="0" NumberDecimalDigits="0"/>
                <telerik:RadNumericUpDown x:Name="mod08" Minimum="0" NumberDecimalDigits="0"/>
                <telerik:RadNumericUpDown x:Name="mod09" Minimum="0" NumberDecimalDigits="0"/>
                <telerik:RadNumericUpDown x:Name="mod10" Minimum="0" NumberDecimalDigits="0"/>
            </UniformGrid>
        </GroupBox>

        <Grid Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>

            <telerik:RadButton Grid.Column="0" Content="LIMPAR" Click="OnLimparClick"/>
            <telerik:RadButton Grid.Column="2" Content="INSERIR" Click="OnAdicionarClick"/>
            <telerik:RadButton Grid.Column="4" Content="ALTERAR" Click="OnAlterarClick"/>
            <telerik:RadButton x:Name="btnExcluir" Grid.Column="6" Content="EXCLUIR" Click="OnExcluirClick"/>
            <telerik:RadButton Grid.Column="8" Content="IMPRIMIR" Click="OnPrintClick"/>
            <telerik:RadButton x:Name="btnCopiarModelo" Grid.Column="10" Content="COPIAR RECEITA" Click="OnCopyClick"/>
            <telerik:RadButton x:Name="btnModeloFiada" Grid.Column="12" Content="MODELOS FIADA" Visibility="Collapsed" Click="OnModelosFiadaClick"/>
            <telerik:RadButton x:Name="btnDistribuicaoFiada" Grid.Column="14" Content="DISTRIBUIÇÃO FIADA" Visibility="Collapsed" Click="OnDistribuicaoFiadaClick"/>
        </Grid>

        <telerik:RadGridView
            x:Name="dgModelos"
            Grid.Row="10"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            AutoGenerateColumns="False"
            ItemsSource="{Binding ItensReceita}"
            FontSize="10"
            SelectionUnit="FullRow"
            SelectionMode="Extended"
            MouseDoubleClick="dgModelos_MouseDoubleClick"
            ShowGroupPanel="False"
            IsFilteringAllowed="True" IsReadOnly="True">
            <telerik:RadGridView.Columns>
                <telerik:GridViewDataColumn UniqueName="codcompladicional" Header="COD." DataMemberBinding="{Binding codcompladicional}" DataFormatString="{}{0:F0}" Width="70"/>
                <telerik:GridViewDataColumn UniqueName="planilha" Header="PLANILHA" DataMemberBinding="{Binding planilha}"/>
                <telerik:GridViewDataColumn UniqueName="descricao_completa" Header="DESCRIÇÃO" DataMemberBinding="{Binding descricao_completa}"/>
                <telerik:GridViewDataColumn UniqueName="unidade" Header="UNID." DataMemberBinding="{Binding unidade}" Width="55"/>
                <telerik:GridViewDataColumn UniqueName="qtd_modelo" Header="MODELO" DataMemberBinding="{Binding qtd_modelo}" DataFormatString="{}{0:N2}" Width="90"/>
                <telerik:GridViewDataColumn UniqueName="qtd_producao" Header="PRODUÇÃO" DataMemberBinding="{Binding qtd_producao}" DataFormatString="{}{0:N2}" Width="100"/>
                <telerik:GridViewDataColumn UniqueName="saldo_estoque" Header="ESTOQUE" DataMemberBinding="{Binding saldo_estoque}" DataFormatString="{}{0:N2}" Width="100"/>
                <telerik:GridViewDataColumn UniqueName="vida_util" Header="VIDA ÚTIL" DataMemberBinding="{Binding vida_util}" DataFormatString="{}{0:N2}" Width="100"/>
                <telerik:GridViewDataColumn UniqueName="custo" Header="CUSTO" DataMemberBinding="{Binding custo}" DataFormatString="{}{0:N2}" Width="100"/>
                <telerik:GridViewDataColumn UniqueName="custo_total" Header="CUSTO TOTAL" DataMemberBinding="{Binding custo_total}" DataFormatString="{}{0:N2}" Width="100"/>
                <telerik:GridViewDataColumn UniqueName="observacao" Header="OBSERVAÇÃO" DataMemberBinding="{Binding observacao}" Width="100"/>
                <telerik:GridViewDataColumn UniqueName="cadastrado_por" DataMemberBinding="{Binding cadastrado_por}"/>
                <telerik:GridViewDataColumn UniqueName="data_cadastro" DataMemberBinding="{Binding data_cadastro}" DataFormatString="{}{0:dd/MM/yyyy HH:mm}"/>
                <telerik:GridViewDataColumn UniqueName="alterado_por" DataMemberBinding="{Binding alterado_por}"/>
                <telerik:GridViewDataColumn UniqueName="data_alterado" DataMemberBinding="{Binding data_alterado}" DataFormatString="{}{0:dd/MM/yyyy HH:mm}"/>
            </telerik:RadGridView.Columns>
        </telerik:RadGridView>
    </Grid>

</Window>
