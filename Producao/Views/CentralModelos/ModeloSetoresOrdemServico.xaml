<Window x:Class="Producao.Views.CentralModelos.ModeloSetoresOrdemServico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        mc:Ignorable="d"
        Title="SETORES PARA EMISSÃO DA ORDEM DE SERVIÇO"
        Height="450"
        Width="650"
        WindowStyle="ToolWindow"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded"
        ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <telerik:RadGridView
            x:Name="dgItens"
            Grid.Row="0"
            AutoGenerateColumns="False"
            CanUserResizeColumns="True"
            CanUserReorderColumns="True"
            CanUserInsertRows="True"
            CanUserDeleteRows="True"
            GroupRenderMode="Flat"
            NewRowPosition="Top"
            ShowGroupPanel="False"
            RowHeight="50"
            FontSize="10"
            SelectedItem="{Binding Iteme, Mode=TwoWay}"
            ItemsSource="{Binding Itens}"
            PreviewKeyDown="dgItens_PreviewKeyDown"
            AddingNewDataItem="dgItens_AddingNewDataItem">

            <telerik:RadGridView.Columns>
                <telerik:GridViewComboBoxColumn
                    Header="SETOR"
                    DataMemberBinding="{Binding codigo_setor}"
                    ItemsSource="{Binding DataContext.Setores, RelativeSource={RelativeSource AncestorType=telerik:RadGridView}}"
                    DisplayMemberPath="setor"
                    SelectedValueMemberPath="codigo_setor"/>
                <telerik:GridViewDataColumn
                    Header="OBSERVAÇÃO"
                    DataMemberBinding="{Binding observacao}"
                    TextWrapping="Wrap"
                    Width="*"/>
            </telerik:RadGridView.Columns>
        </telerik:RadGridView>

        <StatusBar Grid.Row="1">
            <telerik:RadButton Content="GERAR O.S" Click="OnCreateOrdemServico" Margin="0,0,2,2"/>
            <Separator Width="1"/>
            <telerik:RadButton Content="IMPRIMIR O.S/REQUISIÇÃO" Click="OnPrintOS" Visibility="Collapsed" Margin="0,0,2,2"/>
        </StatusBar>
    </Grid>
</Window>
