<UserControl x:Class="Producao.Views.CentralModelos.ViewCentralTabelaPA"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Producao"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             mc:Ignorable="d"
             Language="pt-BR"
             d:DesignHeight="450"
             d:DesignWidth="800"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded">

    <UserControl.Resources>
        <local:ConverterNumber x:Key="ConverterNumber"/>
    </UserControl.Resources>

    <Grid>
        <telerik:RadGridView
            x:Name="dgTabela"
            AutoGenerateColumns="False"
            ItemsSource="{Binding Itens}"
            FontSize="9"
            ShowGroupPanel="False"
            GroupRenderMode="Flat"
            NewRowPosition="Top"
            RowEditEnded="OnRowEditEnded"
            RowValidating="OnRowValidating">
            <telerik:RadGridView.Columns>
                <telerik:GridViewComboBoxColumn
                    Header="DESCRIÇÃO"
                    DataMemberBinding="{Binding codcompladicional, Mode=TwoWay}"
                    ItemsSource="{Binding DataContext.Produtos, RelativeSource={RelativeSource AncestorType=telerik:RadGridView}}"
                    DisplayMemberPath="descricao"
                    SelectedValueMemberPath="codcompladicional"
                    Width="*"/>
                <telerik:GridViewDataColumn Header="PONGA" DataMemberBinding="{Binding ponga, Mode=TwoWay, Converter={StaticResource ConverterNumber}}" Width="60"/>
                <telerik:GridViewDataColumn Header="TRIPÉ" DataMemberBinding="{Binding tripe, Mode=TwoWay, Converter={StaticResource ConverterNumber}}" Width="55"/>
                <telerik:GridViewDataColumn Header="ANEL 1" DataMemberBinding="{Binding anel_1, Mode=TwoWay, Converter={StaticResource ConverterNumber}}" Width="55"/>
                <telerik:GridViewDataColumn Header="ANEL 2" DataMemberBinding="{Binding anel_2, Mode=TwoWay, Converter={StaticResource ConverterNumber}}" Width="55"/>
                <telerik:GridViewDataColumn Header="ANEL 3" DataMemberBinding="{Binding anel_3, Mode=TwoWay, Converter={StaticResource ConverterNumber}}" Width="55"/>
                <telerik:GridViewDataColumn Header="ANEL 4" DataMemberBinding="{Binding anel_4, Mode=TwoWay, Converter={StaticResource ConverterNumber}}" Width="55"/>
                <telerik:GridViewDataColumn Header="ANEL 5" DataMemberBinding="{Binding anel_5, Mode=TwoWay, Converter={StaticResource ConverterNumber}}" Width="55"/>
                <telerik:GridViewDataColumn Header="ANEL 6" DataMemberBinding="{Binding anel_6, Mode=TwoWay, Converter={StaticResource ConverterNumber}}" Width="55"/>
                <telerik:GridViewDataColumn Header="ANEL 7" DataMemberBinding="{Binding anel_7, Mode=TwoWay, Converter={StaticResource ConverterNumber}}" Width="55"/>
                <telerik:GridViewDataColumn Header="ANEL 8" DataMemberBinding="{Binding anel_8, Mode=TwoWay, Converter={StaticResource ConverterNumber}}" Width="55"/>
                <telerik:GridViewDataColumn Header="ANEL 9" DataMemberBinding="{Binding anel_9, Mode=TwoWay, Converter={StaticResource ConverterNumber}}" Width="55"/>
                <telerik:GridViewDataColumn Header="ANEL 10" DataMemberBinding="{Binding anel_10, Mode=TwoWay, Converter={StaticResource ConverterNumber}}" Width="60"/>
                <telerik:GridViewDataColumn Header="ANEL 11" DataMemberBinding="{Binding anel_11, Mode=TwoWay, Converter={StaticResource ConverterNumber}}" Width="60"/>
                <telerik:GridViewDataColumn Header="ANEL 12" DataMemberBinding="{Binding anel_12, Mode=TwoWay, Converter={StaticResource ConverterNumber}}" Width="60"/>
                <telerik:GridViewDataColumn Header="ANEL 13" DataMemberBinding="{Binding anel_13, Mode=TwoWay, Converter={StaticResource ConverterNumber}}" Width="60"/>
                <telerik:GridViewDataColumn Header="ANEL 14" DataMemberBinding="{Binding anel_14, Mode=TwoWay, Converter={StaticResource ConverterNumber}}" Width="60"/>
                <telerik:GridViewDataColumn Header="ANEL 15" DataMemberBinding="{Binding anel_15, Mode=TwoWay, Converter={StaticResource ConverterNumber}}" Width="60"/>
                <telerik:GridViewDataColumn Header="ANEL 16" DataMemberBinding="{Binding anel_16, Mode=TwoWay, Converter={StaticResource ConverterNumber}}" Width="60"/>
                <telerik:GridViewDataColumn Header="ANEL 17" DataMemberBinding="{Binding anel_17, Mode=TwoWay, Converter={StaticResource ConverterNumber}}" Width="60"/>
                <telerik:GridViewDataColumn Header="ANEL 18" DataMemberBinding="{Binding anel_18, Mode=TwoWay, Converter={StaticResource ConverterNumber}}" Width="60"/>
                <telerik:GridViewDataColumn Header="ANEL 19" DataMemberBinding="{Binding anel_19, Mode=TwoWay, Converter={StaticResource ConverterNumber}}" Width="60"/>
                <telerik:GridViewDataColumn Header="ANEL 20" DataMemberBinding="{Binding anel_20, Mode=TwoWay, Converter={StaticResource ConverterNumber}}" Width="60"/>
                <telerik:GridViewDataColumn Header="ANEL 21" DataMemberBinding="{Binding anel_21, Mode=TwoWay, Converter={StaticResource ConverterNumber}}" Width="60"/>
                <telerik:GridViewDataColumn Header="ANEL 22" DataMemberBinding="{Binding anel_22, Mode=TwoWay, Converter={StaticResource ConverterNumber}}" Width="60"/>
            </telerik:RadGridView.Columns>
        </telerik:RadGridView>
    </Grid>

</UserControl>
