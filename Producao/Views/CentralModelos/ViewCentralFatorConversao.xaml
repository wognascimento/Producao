<UserControl x:Class="Producao.Views.CentralModelos.ViewCentralFatorConversao"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Producao"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             mc:Ignorable="d"
             Language="pt-BR"
             d:DesignHeight="450"
             d:DesignWidth="800"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded">

    <UserControl.Resources>
        <local:ConverterNumber x:Key="ConverterNumber"/>
    </UserControl.Resources>

    <Grid>
        <telerik:RadGridView
            x:Name="dgTabela"
            AutoGenerateColumns="False"
            ItemsSource="{Binding Itens}"
            FontSize="9"
            ShowGroupPanel="False"
            GroupRenderMode="Flat"
            NewRowPosition="Top"
            RowEditEnded="OnRowEditEnded"
            RowValidating="OnRowValidating">
            <telerik:RadGridView.Columns>
                <telerik:GridViewComboBoxColumn
                    Header="DESCRIÇÃO"
                    DataMemberBinding="{Binding codcompladicional, Mode=TwoWay}"
                    ItemsSource="{Binding DataContext.Produtos, RelativeSource={RelativeSource AncestorType=telerik:RadGridView}}"
                    DisplayMemberPath="descricao"
                    SelectedValueMemberPath="codcompladicional"
                    Width="*"/>
                <telerik:GridViewDataColumn Header="MULTIPLICA" DataMemberBinding="{Binding multiplica, Mode=TwoWay, Converter={StaticResource ConverterNumber}}"/>
                <telerik:GridViewDataColumn Header="SOMA" DataMemberBinding="{Binding soma, Mode=TwoWay, Converter={StaticResource ConverterNumber}}"/>
            </telerik:RadGridView.Columns>
        </telerik:RadGridView>
    </Grid>

</UserControl>
