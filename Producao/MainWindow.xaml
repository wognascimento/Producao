<Window x:Class="Producao.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        Title="SISTEMA INTEGRADO DE GERENCIAMENTO - PRODUÇÃO"
        Height="350" Width="1024" 
        WindowState="Maximized" 
        Language="pt-BR"
        Loaded="Window_Loaded">

    <Grid x:Name="Etiqueta">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <telerik:RadMenu Grid.Row="0" VerticalAlignment="Center" Language="pt-BR">
            <telerik:RadMenuItem Click="MenuItemAdv_Click" Header="Aprovados"/>
            <telerik:RadMenuItem Header="Controles">
                <telerik:RadMenuItem Header="Plantas" Click="OnOpenControlePlantaClick"/>
                <telerik:RadMenuItem x:Name="Revisao" Header="Revisão" Click="OnRevisaoChecklistClick"/>
            </telerik:RadMenuItem>
            <telerik:RadMenuItem Header="Check list">
                <telerik:RadMenuItem Header="Natal">
                    <telerik:RadMenuItem x:Name="Checklist" Header="Checklist" Click="OnChecklist_Click"/>
                    <telerik:RadMenuItem x:Name="CompletarChecklist" Header="Completar" Click="CompletarChecklistClick"/>
                    <telerik:RadMenuItem x:Name="EtiquetaChecklist" Header="Etiqueta">
                        <telerik:RadMenuItem Header="Emitir" Click="OnEtiquetaChecklistClick"/>
                        <telerik:RadMenuItem Header="Imprimir" Click="OnEtiquetaChecklistEmitidaClick"/>
                    </telerik:RadMenuItem>
                    <telerik:RadMenuItem x:Name="historico" Header="Histórico" Click="OnHistoricoChecklistClick"/>
                </telerik:RadMenuItem>
                <telerik:RadMenuItem Header="Memorial" Click="OnOpenMemorial"/>
                <telerik:RadMenuItem Header="FunXmas"/>
                <telerik:RadMenuItem Header="Prefeitura"/>
            </telerik:RadMenuItem>
            <telerik:RadMenuItem Header="Planilha">
                <telerik:RadMenuItem Header="Áreas Temas" Click="OnAreasTemas"/>
                <telerik:RadMenuItem Header="Análise Cliente" Click="OnAnaliseCliente"/>
                <telerik:RadMenuItem Header="Análise Planilha" Click="OnAnalisePlanilha"/>
                <telerik:RadMenuItem Header="Análise ShowRoom"/>
                <telerik:RadMenuItem Header="Controle por Grupo" Click="ControleGrupoClick"/>
                <telerik:RadMenuItem Header="Pendência de Produção" Click="OnPendenciaProducaoClick"/>
                <telerik:RadMenuItem Header="Pendência de Produção SHOWROOM/TREINAMENTO" Click="OnPendenciaProducaoTreinamentoClick"/>
            </telerik:RadMenuItem>
            
            <telerik:RadMenuItem Header="Ordem de Serviço">
                <telerik:RadMenuItem Header="Serviço">
                    <telerik:RadMenuItem Header="Emitir" Click="OnEmitirOSServicoClick"/>
                    <telerik:RadMenuItem Header="Emitidas" Click="OnEmitidasOSServicoClick"/>
                    <telerik:RadMenuItem Header="Baixa" Click="OnBaixaServisoClick"/>
                </telerik:RadMenuItem>
                <telerik:RadMenuItem Header="Produção">
                    <telerik:RadMenuItem Header="Solicitar" Click="OnSolicitarOSProdutoClick"/>
                    <telerik:RadMenuItem Header="Solicitar Unificado" Click="OnSolicitarOSProdutoUnificadoClick"/>
                    <telerik:RadMenuItem Header="Alterar Solicitação" Click="OnAlterarSolicitacaoOSProdutoClick"/>
                    <telerik:RadMenuItem Header="Emitir" Click="OnEmitirOSProdutoClick"/>
                    <telerik:RadMenuItem Header="Baixa" Click="OnBaixaProdutoClick"/>
                    <telerik:RadMenuItem Header="Relatórios">
                        <telerik:RadMenuItem Header="Emitidas" Click="OnEmitidasClick"/>
                        <telerik:RadMenuItem Header="Concluídas" Click="OnConcluidasClick"/>
                        <telerik:RadMenuItem Header="Não Concluídas" Click="OnNaoConcluidasClick"/>
                        <telerik:RadMenuItem Header="Canceladas" Click="OnCanceladasClick"/>
                        <telerik:RadMenuItem Header="Transformação"/>
                        <telerik:RadMenuItem Header="Programação de produção" Click="OnProgramacaoProducaoClick"/>
                    </telerik:RadMenuItem>
                </telerik:RadMenuItem>
                <telerik:RadMenuItem Header="Desbaiamento">
                    <telerik:RadMenuItem Header="Emitir" Click="OnEmitirOsDesbaiamento"/>
                    <telerik:RadMenuItem Header="Consulta" Click="OnConsultaOsDesbaiamento"/>
                </telerik:RadMenuItem>
                <telerik:RadMenuItem Header="Transformação"/>
                <telerik:RadMenuItem Header="Requisição">
                    <telerik:RadMenuItem Header="Receita">
                        <telerik:RadMenuItem Header="Criar" Click="OnCreateReceitaRequisicao" />
                        <telerik:RadMenuItem Header="Consulta" Click="OnConsultaReceitaRequisicao" />
                    </telerik:RadMenuItem>
                    <telerik:RadMenuItem Header="Emitir" Click="OnRequisicaClick"/>
                    <telerik:RadMenuItem Header="Alterar" Click="OnAlterarRequisicoes"/>
                    <telerik:RadMenuItem Header="Consultas">
                        <telerik:RadMenuItem Header="Emitidas" Click="OnRequisicoesEmitidas"/>
                    </telerik:RadMenuItem>
                </telerik:RadMenuItem>
                <telerik:RadMenuItem Header="Impedimento Checklist"/>
            </telerik:RadMenuItem>
            
            <telerik:RadMenuItem Header="Central de Modelos">
                <telerik:RadMenuItem Header="Modelos">
                    <telerik:RadMenuItem Header="Criar" Click="OnCentralCriarModelo"/>
                    <telerik:RadMenuItem Header="Ordem de Serviço" Click="OnCentralEmitirOs"/>
                    <telerik:RadMenuItem Header="Status Checklist" Click="OnCentralStatusCheckList"/>
                </telerik:RadMenuItem>
                <telerik:RadMenuItem Header="Tabela P.A" Click="OnCentralTabelaPa"/>
                <telerik:RadMenuItem Header="Fator" Click="OnCentralFatorConversao"/>
            </telerik:RadMenuItem>

            <telerik:RadMenuItem Header="Construção">
                <telerik:RadMenuItem Header="Cadastro Shopping" Click="OnCadastroConstrucao"/>
                <telerik:RadMenuItem Header="Cadastro de Peças" Click="OnCadastroPecaConstrucao"/>
            </telerik:RadMenuItem>

            <telerik:RadMenuItem Header="Controlados">
            <telerik:RadMenuItem Header="Imprimir" Click="OnImprimirEtiquetaControlado"/>
            <telerik:RadMenuItem Header="Configurar Impressora Térmica" Click="OnConfigurarImpressoraTermica"/>
                <telerik:RadMenuItem Header="Etiqueta">
                    <telerik:RadMenuItem Header="Vincular" Click="OnVinculoRequisicao"/>
                    <telerik:RadMenuItem Header="Retorno Manual" Click="OnRetornoEtiquetaManualClick"/>
                    <telerik:RadMenuItem Header="Consulta Geral" Click="OnConsultaGeralClick"/>
                </telerik:RadMenuItem>
                <telerik:RadMenuItem Header="Cobrança"/>
                <telerik:RadMenuItem Header="Retorno" Click="OnRetornoControlado"/>
                <telerik:RadMenuItem Header="Relatórios">
                    <telerik:RadMenuItem Header="Sigla" Click="OnRelatorioSigla"/>
                    <telerik:RadMenuItem Header="Planilha" Click="OnRelatorioPlanilha"/>
                </telerik:RadMenuItem>
            </telerik:RadMenuItem>

            <telerik:RadMenuItem Header="Produto">
                <telerik:RadMenuItem Header="Relplan" Click="OnOpenRelPlanClick"/>
                <telerik:RadMenuItem Header="Cadastro de Produto" Click="OnCadastroProduto"/>
                <telerik:RadMenuItem Header="Cadastrar Descrição Espanhol" Click="OnCadastroEspanhol"/>
                <telerik:RadMenuItem Header="Todas as Descrições" Click="OnTodasDescricoes"/>
                <telerik:RadMenuItem Header="Produtos Shopping" Click="OnProdutosShopping"/>
                <telerik:RadMenuItem Header="Custo" Click="OnProdutosCusto"/>
                <telerik:RadMenuItem Header="Catálogo"/>
            </telerik:RadMenuItem>
            
            <telerik:RadMenuItem Header="Estoque">
                <telerik:RadMenuItem Header="Saldo Estoque" Click="OnSaldoEstoqueClick"/>
                <telerik:RadMenuItem Header="Planejamento Estoque" Click="OnPlanejamentoEstoqueClick"/>
                <telerik:RadMenuItem Header="Sobra"/>
                <telerik:RadMenuItem Header="Relatório Iventário"/>
                <telerik:RadMenuItem Header="CCE">
                    <telerik:RadMenuItem Header="Lançamentos" Click="OnDigitarCCEClick"/>
                    <telerik:RadMenuItem Header="Relatório" Click="OnRelatorioCCEClick"/>
                    <telerik:RadMenuItem Header="Consulta" Click="OnConsultaCCEClick"/>
                </telerik:RadMenuItem>
                <telerik:RadMenuItem Header="Movimentações">
                    <telerik:RadMenuItem Header="Entrada" Click="OnEntradaEstoqueClick"/>
                    <telerik:RadMenuItem Header="Saida" Click="OnSaidaEstoqueClick"/>
                    <telerik:RadMenuItem Header="Libera Produto Bloqueado" Click="OnLiberarProdutoBloqueadoClick"/>
                    <telerik:RadMenuItem Header="Consultas">
                        <telerik:RadMenuItem Header="Entrada" Click="OnConsultaEntradaEstoqueClick"/>
                        <telerik:RadMenuItem Header="Saida" Click="OnConsultaSaidaEstoqueClick"/>
                    </telerik:RadMenuItem>
                </telerik:RadMenuItem>
                <telerik:RadMenuItem Header="Baixa de Requisição" Click="OnBaixaRequisicaoClick"/>
            </telerik:RadMenuItem>

            <telerik:RadMenuItem Header="Kit">
                
                <telerik:RadMenuItem Header="Solução">
                    <telerik:RadMenuItem Header="Checklist" Click="OnKitSolucaoCheckList"/>
                    <telerik:RadMenuItem Header="Consulta" Click="OnQueryKitsolucaoGeral"/>
                </telerik:RadMenuItem>
                
                <telerik:RadMenuItem Header="Manutenção">
                    <telerik:RadMenuItem Header="Checklist" Click="OnKitManutencaoCheckList"/>
                    <telerik:RadMenuItem Header="Consulta" Click="OnQueryKitManutencaoGeral"/>
                </telerik:RadMenuItem>

                <telerik:RadMenuItem Header="Desmontagem">
                    <telerik:RadMenuItem Header="Checklist" Click="OnKitDesmontagemCheckList"/>
                    <telerik:RadMenuItem Header="Consulta" Click="OnQueryKitDesmontagemGeral"/>
                </telerik:RadMenuItem>

                <telerik:RadMenuItem Header="Controle Geral" Click="OnControleGeral"/>

            </telerik:RadMenuItem>

            <telerik:RadMenuItem Header="Relatórios Técnicos">
                <telerik:RadMenuItem Header="Carga Elétrica" Click="OnCargaEletrica"/>
                <telerik:RadMenuItem Header="Inflamabilidade" Click="OnInflamabilidade"/>
                <telerik:RadMenuItem Header="Estabilidade" Click="OnEstabilidade"/>
            </telerik:RadMenuItem>


            <telerik:RadMenuItem Header="Outros" >
                <telerik:RadMenuItem Header="Atualizar Sistema" Click="OnAtualizarSistemaClick"/>
                <telerik:RadMenuItem Header="Sobre" Click="OnSobreSistemaClick"/>
            </telerik:RadMenuItem>

        </telerik:RadMenu>

        <telerik:RadDocking
            x:Name="radDocking"
            Grid.Row="1"
            HasDocumentHost="True">
            <telerik:RadDocking.DocumentHost>
                <telerik:RadSplitContainer>
                    <telerik:RadPaneGroup x:Name="documentGroup"/>
                </telerik:RadSplitContainer>
            </telerik:RadDocking.DocumentHost>
        </telerik:RadDocking>
        
        <StatusBar Grid.Row="2">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="4*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <StatusBarItem>
                <Image Source="/icones/icons8-usu_0025c3_0025a1rio-de-g_0025c3_0025aanero-neutro-windows-metro-16.png" Width="16" Height="16" MouseDown="OnAlterarUsuario"/>
            </StatusBarItem>
            <StatusBarItem Grid.Column="1">
                <TextBlock x:Name="txtUsername" Margin="0,0,2,2"/>
            </StatusBarItem>
            <StatusBarItem Grid.Column="2">
                <telerik:RadProgressBar x:Name="PbLoading" Height="20" Value="80" Width="100" IsIndeterminate="True" Visibility="Hidden"/>
            </StatusBarItem>
            <StatusBarItem Grid.Column="3">
                <Image Source="/icones/configuracao-de-dados-windows-metro-16.png" Width="16" Height="16" MouseDown="Image_MouseDown"/>
            </StatusBarItem>
            <StatusBarItem Grid.Column="4">
                <TextBlock x:Name="txtDataBase" Margin="0,0,2,2"/>
            </StatusBarItem>
        </StatusBar>
        
    </Grid>

</Window>
